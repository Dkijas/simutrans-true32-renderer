 {
+#ifdef STLAB_CERT_HARNESS
+	stlab_present_count++;
+#endif
 	gfx->flush_framebuffer();
+#ifdef STLAB_CERT_HARNESS
+	/* LAB: raw capture of exactly what is presented below, before any SDL work */
+	if (stlab_fbdump_request[0] && framebuffer) {
+		FILE *f = fopen(stlab_fbdump_request, "wb");
+		if (f) {
+			const scr_size screen = gfx->get_screen_size();
+			unsigned hdr[8] = { 0x42414c53u /* "SLAB" */, (unsigned)COLOUR_DEPTH, (unsigned)screen.w, (unsigned)screen.h, (unsigned)fb_pitch, (unsigned)fb_height, (unsigned)sizeof(PIXVAL), (unsigned)stlab_present_count };
+			fwrite(hdr, sizeof(hdr), 1, f);
+			const size_t n = (size_t)fb_pitch * (size_t)fb_height;
+#if defined(STLAB_NC_QUANTISE) && COLOUR_DEPTH == 32
+			/* NEGATIVE CONTROL: force every word through RGB565 (the game's own expansion) */
+			for (size_t i = 0; i < n; i++) {
+				const unsigned c = (unsigned)framebuffer[i];
+				const unsigned r5 = (c >> 19) & 0x1F, g6 = (c >> 10) & 0x3F, b5 = (c >> 3) & 0x1F;
+				const unsigned q = 0xFF000000u | ((r5 * 0xFF / 0x1F) << 16) | ((g6 * 0xFF / 0x3F) << 8) | (b5 * 0xFF / 0x1F);
+				fwrite(&q, sizeof(q), 1, f);
+			}
+#else
+			fwrite(framebuffer, sizeof(PIXVAL), n, f);
+#endif
+			fclose(f);
+		}
+		stlab_quit_event("fbdump written", (unsigned)fb_pitch, (unsigned)fb_height, stlab_fbdump_request);
+		stlab_fbdump_request[0] = 0;
+	}
+#endif
 
 	if(  !screen_tx  ||  !framebuffer  ) {
 		return;
