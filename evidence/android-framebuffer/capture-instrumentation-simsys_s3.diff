 /* ----------------------------------------------------------- presentation */
 
+#ifdef STLAB_CERT_HARNESS
+/* the last 8 SDL event types, oldest first, formatted on demand */
+static unsigned stlab_ev_ring[8];
+static unsigned stlab_ev_n = 0;
+static const char *stlab_ev_text()
+{
+	static char buf[8 * 12];
+	buf[0] = 0;
+	for (unsigned i = (stlab_ev_n > 8 ? stlab_ev_n - 8 : 0); i < stlab_ev_n; i++) {
+		sprintf(buf + strlen(buf), " 0x%X", stlab_ev_ring[i % 8]);
+	}
+	return buf;
+}
+#endif
