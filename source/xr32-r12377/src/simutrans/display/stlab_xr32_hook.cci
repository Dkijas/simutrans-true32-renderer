/* ==========================================================================
 * XR32 candidate nodes: the renderer-side seam.
 *
 * Included at the end of simgraph32.cc so it sees the renderer's own state
 * (images[], the palette tables, night_shift). It replaces the PRODUCER of
 * imd32::data[player] for images that carry a candidate node; the CONSUMER
 * (display_img_aux32 and the blit cores) is untouched and never learns that
 * XR32 exists.
 *
 * The renderer therefore receives ARGB8888 screen runs, exactly as it already
 * did -- but for these images those runs were never STORED_PIXVAL.
 * ==========================================================================*/

#include <chrono>
#include <list>
#include <map>
#include <memory>
#include <unordered_map>
#include <vector>

/* --- what the semantic layer needs from the renderer ------------------------ */

uint32 stlab_pack_argb(int r, int g, int b)
{
	if(  r < 0  ) { r = 0; }
	if(  r > 255  ) { r = 255; }
	if(  g < 0  ) { g = 0; }
	if(  g > 255  ) { g = 255; }
	if(  b < 0  ) { b = 0; }
	if(  b > 255  ) { b = 255; }
	return 0xFF000000u | ((uint32)r << 16) | ((uint32)g << 8) | (uint32)b;
}


/* XR32-UI-DAYTIME-01: a draw with daynight=false asks for the day colours (the 16-bit renderer then draws
 * through rgbmap_all_day / specialcolormap_all_day). While this is set, the semantics resolve an image
 * against exactly those tables: night level 0 and the multipliers they were built with (1.0, at init).
 * Per thread, so a display lane never sees another thread's request. */
static thread_local bool stlab_daytime = false;


void stlab_night_multipliers(double *rg, double *b)
{
	if(  stlab_daytime  ) {
		*rg = *b = 1.0;
		return;
	}
	const int night = night_shift < 0 ? 0 : night_shift;
	*rg = pow(0.75, night) * ((light_level + 8.0) / 8.0);
	*b  = pow(0.83, night) * ((light_level + 8.0) / 8.0);
}


int stlab_night_level()
{
	if(  stlab_daytime  ) {
		return 0;
	}
	return night_shift < 0 ? 0 : night_shift;
}


uint32 stlab_player_colour_argb(sint8 player_nr, uint8 channel, uint8 tone)
{
	const sint8 p = (player_nr >= 0 && player_nr < MAX_PLAYER_COUNT) ? player_nr : 0;
	const uint8 off = player_offsets[p][channel == 2 ? 1 : 0];
	// specialcolormap_day_night already carries the night multiplier, applied once
	// when the palette was built. No 555 index is involved.
	return (stlab_daytime ? specialcolormap_all_day : specialcolormap_day_night)[(int)off + (tone & 7)];
}


uint32 stlab_light_colour_argb(uint8 light_index)
{
	if(  light_index >= LIGHT_COUNT  ) {
		return 0xFF000000u;
	}
	return (stlab_daytime ? rgbmap_all_day : rgbmap_day_night)[0x8000 + MAX_PLAYER_COUNT + light_index];
}


/* --- per-image candidate storage -------------------------------------------- */

struct stlab_xr32_zoom_t;                 // the derived per-scale cache

struct stlab_xr32_slot_t {
	stlab_xr32_zoom_t *zoom = NULL;       ///< native zoom cache, one scale at a time
	stlab_xr32_image_t *img = NULL;
	uint8 resolved_player = 0xFF;   ///< which player data[] currently holds
	int   resolved_night = -999;
	image_id hires_active = IMG_EMPTY; ///< MRES: the 2x counterpart shown now, if any
	bool generated = false;          ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: built by NIGHTGEN from a legacy IMG
	sint32 fit_num = 0, fit_den = 0; ///< XR32-FIT-IMG-TO-WIDTH-01: the step fit_img_to_width() chose (0 = none)
};

static stlab_xr32_slot_t *stlab_slots = NULL;
static image_id stlab_slots_alloc = 0;

static void stlab_xr32_base_release();   // XR32-UI-BASE-01: the base-size runs of the interface (end of file)


static stlab_xr32_slot_t *stlab_slot(image_id n, bool create)
{
	if(  n >= stlab_slots_alloc  ) {
		if(  !create  ) return NULL;
		const image_id want = n + 128;
		stlab_xr32_slot_t *grown = new stlab_xr32_slot_t[want];
		for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) grown[i] = stlab_slots[i];
		delete [] stlab_slots;
		stlab_slots = grown;
		stlab_slots_alloc = want;
	}
	return &stlab_slots[n];
}


bool stlab_xr32_has(image_id n)
{
	stlab_xr32_slot_t *s = stlab_slot(n, false);
	return s != NULL  &&  s->img != NULL;
}


void stlab_xr32_set_fit(image_id id, sint32 num, sint32 den)
{
	stlab_xr32_slot_t *s = stlab_slot(id, false);
	if(  s == NULL  ||  s->img == NULL  ) {
		return;
	}
	// 1/1 is the image itself: no scaled cache, the ordinary path serves it
	s->fit_num = num == den ? 0 : num;
	s->fit_den = num == den ? 0 : den;
}


bool stlab_xr32_attach(image_id id, stlab_xr32_image_t *img,
                       sint16 img_x, sint16 img_y, sint16 img_w, sint16 img_h, uint8 img_zoomable)
{
	if(  id >= anz_images  ||  img == NULL  ) {
		return false;
	}
	// geometry guard of FORMAT CANDIDATE v1: a mismatch means the node does not
	// belong to this image, and the legacy IMG must be used instead.
	if(  img->width != (uint16)img_w  ||  img->height != (uint16)img_h
	     ||  img->x != img_x  ||  img->y != img_y  ||  img->zoomable != img_zoomable  ) {
		return false;
	}
	stlab_xr32_slot_t *s = stlab_slot(id, true);
	if(  s->img != NULL  ) {
		delete s->img;
	}
	s->img = img;
	s->generated = false;
	s->resolved_player = 0xFF;
	s->resolved_night = -999;

	// The image keeps the zoom eligibility registration gave it: a candidate-backed
	// image now has a native scaled representation, so it takes the ordinary zoom
	// path and rezoom_img32() routes it to stlab_xr32_zoom_*() instead of to the
	// STORED16 resampler. FLAG_REZOOM is left set so the first draw builds it.
	images[id].player_flags = 0xFFFF;
	// a candidate that carries player runs must route through the player cache
	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
		if(  img->runs[r].cls == 1  ||  img->runs[r].cls == 2  ) {
			images[id].recode_flags |= FLAG_HAS_PLAYER_COLOR;
			break;
		}
	}
	return true;
}


static void stlab_xr32_zoom_release(stlab_xr32_slot_t *s);


bool stlab_xr32_has_authored(image_id id)
{
	const stlab_xr32_slot_t *s = stlab_slot( id, false );
	return s != NULL  &&  s->img != NULL  &&  !s->generated;
}


bool stlab_xr32_shows(image_id id, const stlab_xr32_image_t *day, const uint8 *night)
{
	const stlab_xr32_slot_t *s = stlab_slot( id, false );
	const stlab_xr32_image_t *have = (s != NULL  &&  !s->generated) ? s->img : NULL;
	if(  have == NULL  ||  day == NULL  ) {
		return have == NULL  &&  day == NULL;
	}
	if(  have->width != day->width  ||  have->height != day->height  ||  have->x != day->x  ||  have->y != day->y
	     ||  have->zoomable != day->zoomable  ||  have->version != day->version  ||  have->run_count != day->run_count  ) {
		return false;
	}
	const size_t bytes = (size_t)day->width * day->height * 4;
	if(  (have->rgba == NULL) != (day->rgba == NULL)  ||  (day->rgba  &&  memcmp( have->rgba, day->rgba, bytes ) != 0)  ) {
		return false;
	}
	for(  uint32 r = 0;  r < day->run_count;  r++  ) {
		const stlab_xr32_run_t &a = have->runs[r], &b = day->runs[r];
		if(  a.start != b.start  ||  a.length != b.length  ||  a.cls != b.cls  ||  a.param != b.param  ||  a.coverage != b.coverage
		     ||  a.under_is_framebuffer != b.under_is_framebuffer  ||  a.under_r != b.under_r  ||  a.under_g != b.under_g  ||  a.under_b != b.under_b  ) {
			return false;
		}
	}
	if(  (have->night == NULL) != (night == NULL)  ) {
		return false;
	}
	return night == NULL  ||  memcmp( have->night, night, bytes ) == 0;
}

/* --- XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 (EXPERIMENT) ----------------------------- */

const char *stlab_xnex_attach(image_id id, stlab_xnex_t *night)
{
	stlab_xr32_slot_t *s = stlab_slot(id, false);
	if(  night == NULL  ||  night->rgba == NULL  ) {
		return "empty night node";
	}
	if(  s == NULL  ||  s->img == NULL  ||  s->generated  ) {
		return "the image has no XR32 v2 day node";   // a night image needs the image's DAY node
	}
	stlab_xr32_image_t *img = s->img;
	if(  img->version != 2  ) {
		return "the day node is not XR32 v2";
	}
	if(  night->width != img->width  ||  night->height != img->height  ||  night->x != img->x  ||  night->y != img->y  ) {
		return "its geometry differs from the day node";   // same geometry guard as XR32 itself
	}
	if(  img->night != NULL  ) {
		return "the image already has a night node (duplicate)";   // the first one stays
	}
	free( img->night );
	img->night = night->rgba;
	night->rgba = NULL;
	stlab_xr32_zoom_release( s );
	s->resolved_player = 0xFF;
	s->resolved_night = -999;
	images[id].player_flags = 0xFFFF;
	images[id].recode_flags |= FLAG_REZOOM;
	return NULL;
}


/**
 * SIMUTRANS_XR32_NIGHTGEN=1: prissi's "night images generated on load time" for a LEGACY image.
 * The stored words are decoded once, at registration, into
 *   DAY plane   ordinary colour = the 555 value expanded exactly as the palette does; a light =
 *               its day colour; a player pixel = a v2 contributor (coverage 255)
 *   NIGHT plane ordinary colour = its legacy level-4 colour; a light = its night colour
 * and the image is then served by the DAY+NIGHT path ('abc' transition). Semi-transparent
 * pixels keep their class colour and get alpha (a32 * 255 + 16) / 32.
 */
static uint32 stlab_nightgen_images = 0;
static uint64 stlab_nightgen_bytes = 0;
static uint64 stlab_nightgen_us = 0;     ///< wall time spent generating, microseconds (measurement only)

static void stlab_nightgen_register(image_id id)
{
	if(  !stlab_xr32_enabled()  ||  !stlab_nightgen_enabled()  ) {
		return;
	}
	const imd32 &d = images[id];
	if(  d.base_h <= 0  ||  d.base_w <= 0  ||  d.base_data == NULL  ) {
		return;
	}
	const uint32 w = (uint32)d.base_w, h = (uint32)d.base_h, npx = w * h;
	const std::chrono::steady_clock::time_point t_start = std::chrono::steady_clock::now();
	uint8 *day = (uint8 *)calloc( npx, 4 );
	uint8 *nig = (uint8 *)calloc( npx, 4 );
	uint8 *pcid = (uint8 *)malloc( npx );
	if(  day == NULL  ||  nig == NULL  ||  pcid == NULL  ) {
		free( day ); free( nig ); free( pcid );
		return;
	}
	memset( pcid, 0xFF, npx );
	const double m4[2] = { pow(0.75, 4) * ((light_level + 8.0) / 8.0), pow(0.83, 4) * ((light_level + 8.0) / 8.0) };
	uint32 n_pc = 0;
	const STORED_PIXVAL *sp = d.base_data;
	for(  uint32 y = 0;  y < h;  y++  ) {
		uint32 x = 0;
		uint16 runlen = *sp++;
		do {
			x += (runlen & ~TRANSPARENT_RUN);
			runlen = *sp++;
			const bool semi = (runlen & TRANSPARENT_RUN) != 0;
			runlen &= (uint16)~TRANSPARENT_RUN;
			for(  uint16 k = 0;  k < runlen;  k++  ) {
				const uint32 px = x + k;
				const STORED_PIXVAL v = sp[k];
				if(  px >= w  ) continue;
				const uint32 i = y * w + px;
				uint8 *dp = day + i * 4, *np = nig + i * 4;
				int cls = -1, alpha = 255;             // cls: 0..15 player, 16..30 light, 31+ rgb343, -1 rgb555
				uint32 val = v;
				if(  semi  ) {
					const uint32 aux = (uint32)v - 0x8020u;
					cls = (int)(aux / 31u);
					alpha = (int)(((aux % 31u) + 1u) * 255u + 16u) / 32;
				}
				else if(  v >= 0x8000  ) {
					cls = v - 0x8000;
				}
				if(  cls < 0  ) {
					dp[0] = (uint8)((val & 0x7C00) >> 7); dp[1] = (uint8)((val & 0x03E0) >> 2); dp[2] = (uint8)((val & 0x001F) << 3);
				}
				else if(  cls < 16  ) {
					pcid[i] = (uint8)cls;  n_pc++;
					dp[0] = dp[1] = dp[2] = 0x80;          // never read: coverage 255
				}
				else if(  cls < 16 + LIGHT_COUNT  ) {
					const rgb888_t dl = display_day_lights[cls - 16], nl = display_night_lights[cls - 16];
					dp[0] = dl.r; dp[1] = dl.g; dp[2] = dl.b;
					np[0] = nl.r; np[1] = nl.g; np[2] = nl.b;
				}
				else {
					const uint32 c = (uint32)(cls - 31);
					dp[0] = (uint8)((c & 0x0380) >> 2); dp[1] = (uint8)((c & 0x0078) << 1); dp[2] = (uint8)((c & 0x0007) << 5);
				}
				if(  cls < 16  ||  cls >= 16 + LIGHT_COUNT  ) {
					np[0] = (uint8)(int)(dp[0] * m4[0]); np[1] = (uint8)(int)(dp[1] * m4[0]); np[2] = (uint8)(int)(dp[2] * m4[1]);
				}
				dp[3] = np[3] = (uint8)alpha;
			}
			x  += runlen;
			sp += runlen;
		} while(  (runlen = *sp++)  );
	}
	stlab_xr32_image_t *img = new stlab_xr32_image_t();
	img->width = (uint16)w;  img->height = (uint16)h;
	img->x = d.base_x;  img->y = d.base_y;
	img->zoomable = (d.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
	img->version = 2;
	img->rgba = day;
	img->night = nig;
	// player pixels -> v2 contributor runs (coverage 255), ascending start then id
	if(  n_pc  ) {
		img->runs = (stlab_xr32_run_t *)calloc( n_pc, sizeof(stlab_xr32_run_t) );
		uint32 r = 0;
		for(  uint32 i = 0;  i < npx;  ) {
			if(  pcid[i] == 0xFF  ) { i++; continue; }
			uint32 j = i + 1;
			while(  j < npx  &&  pcid[j] == pcid[i]  ) j++;
			stlab_xr32_run_t &run = img->runs[r++];
			run.start = i;  run.length = j - i;  run.coverage = 255;
			run.cls = pcid[i] < 8 ? 1 : 2;  run.param = pcid[i] & 7;
			i = j;
		}
		img->run_count = r;
	}
	free( pcid );
	if(  !stlab_xr32_attach( id, img, img->x, img->y, (sint16)w, (sint16)h, img->zoomable )  ) {
		delete img;
		return;
	}
	stlab_slot( id, false )->generated = true;
	stlab_nightgen_images++;
	stlab_nightgen_us += (uint64)std::chrono::duration_cast<std::chrono::microseconds>(
		std::chrono::steady_clock::now() - t_start ).count();
	stlab_nightgen_bytes += (uint64)npx * 8 + (uint64)img->run_count * sizeof(stlab_xr32_run_t);
}


/* --- XR32-COAST-RENDERING-01 (A4): coast water tiles derived from the sea's XR32 data ----------------------
 *
 * The water of a sloped coast is not a pak image: ground_desc_t::init_ground_textures() generates one tile per
 * slope and water animation stage from the 16-bit words of the sea image (five pasted copies on the water climate
 * texture, then cut to the slope's light map; create_texture_from_tile + create_textured_tile(binary)). Such a tile
 * gets a node shell here and a RECIPE (sea, light map, texture); its raster is composed exactly the way the 16-bit
 * tile was - same order, same bounds, the same pixel set - from the sea's XR32 planes, whenever a cache is built from
 * it (screen cache, base-size runs, zoom cache). XR32-A12-P1: only the last rasters are kept, within a bound (stlab_derive_cached):
 * the 2,144 tiles of a 32-stage water pak would otherwise keep 80 MB of rasters (four times their 16-bit words).
 */
struct stlab_xr32_derive_t {
	image_id light = IMG_EMPTY, sea = IMG_EMPTY, ref = IMG_EMPTY;
	bool climate = false;   ///< XR32-A12-TERRAIN-01: a climate / snow tile (light x texture), sea unused
	uint32 gen = 0;         ///< XR32-A12-P1: the registration this recipe belongs to (stlab_derive_cached)
};
static std::map<image_id, stlab_xr32_derive_t> stlab_derived;
static uint32 stlab_derive_gen = 0;
static void stlab_derive_cache_forget(image_id tile);


/// one legacy pixel as the palette shows it by day (the NIGHTGEN expansion), and its legacy level-4 night colour
static void stlab_derive_legacy_rgba(STORED_PIXVAL v, uint8 *dp, uint8 *np)
{
	dp[0] = (uint8)((v & 0x7C00) >> 7);  dp[1] = (uint8)((v & 0x03E0) >> 2);  dp[2] = (uint8)((v & 0x001F) << 3);
	dp[3] = 255;
	if(  np  ) {
		const double m4[2] = { pow(0.75, 4) * ((light_level + 8.0) / 8.0), pow(0.83, 4) * ((light_level + 8.0) / 8.0) };
		np[0] = (uint8)(int)(dp[0] * m4[0]);  np[1] = (uint8)(int)(dp[1] * m4[0]);  np[2] = (uint8)(int)(dp[2] * m4[1]);
		np[3] = 255;
	}
}


/// does this legacy stream carry semi-transparent runs or special colours (player, lights)?
static bool stlab_derive_plain(image_id n)
{
	const imd32 &d = images[n];
	if(  d.base_data == NULL  ||  (d.recode_flags & (FLAG_HAS_PLAYER_COLOR | FLAG_HAS_TRANSPARENT_COLOR))  ) {
		return false;
	}
	const STORED_PIXVAL *sp = d.base_data;
	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
		uint16 runlen = *sp++;
		do {
			runlen = *sp++;
			for(  uint16 k = 0;  k < runlen;  k++  ) {
				if(  sp[k] >= 0x8000  ) {
					return false;
				}
			}
			sp += runlen;
		} while(  (runlen = *sp++)  );
	}
	return true;
}


static bool stlab_derive_source_usable(image_id n);


bool stlab_xr32_derive_water_tile(image_id tile, image_id light, image_id sea, image_id ref)
{
	if(  !stlab_xr32_enabled()  ||  tile >= anz_images  ||  light >= anz_images  ||  sea >= anz_images  ||  ref >= anz_images  ) {
		return false;
	}
	const stlab_xr32_slot_t *ss = stlab_slot( sea, false );
	if(  ss == NULL  ||  ss->img == NULL  ||  ss->img->rgba == NULL  ||  ss->img->run_count != 0  ||  stlab_derived.count( sea )  ) {
		return false;   // the sea has no XR32 colour of its own: the tile stays the 16-bit one
	}
	const imd32 &t = images[tile], &l = images[light], &r = images[ref];
	// the tile is a copy of the light map (copy_rotate(0)), and the texture a rectangle at x 0 (create_texture_from_tile)
	if(  t.base_w <= 0  ||  t.base_h <= 0  ||  t.base_w != l.base_w  ||  t.base_h != l.base_h  ||  t.base_x != l.base_x  ||  t.base_y != l.base_y
	     ||  r.base_x != 0  ||  r.base_w <= 1  ||  !stlab_derive_plain( tile )  ||  !stlab_derive_source_usable( light )  ||  !stlab_derive_plain( sea )  ) {
		return false;
	}
	stlab_xr32_image_t *shell = new stlab_xr32_image_t();
	shell->width = (uint16)t.base_w;  shell->height = (uint16)t.base_h;
	shell->x = t.base_x;  shell->y = t.base_y;
	shell->zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
	shell->version = ss->img->version;
	if(  !stlab_xr32_attach( tile, shell, t.base_x, t.base_y, t.base_w, t.base_h, shell->zoomable )  ) {
		delete shell;
		return false;
	}
	stlab_xr32_derive_t &rc = stlab_derived[tile];
	rc.light = light;  rc.sea = sea;  rc.ref = ref;
	rc.gen = ++stlab_derive_gen;
	stlab_derive_cache_forget( tile );
	return true;
}


/* --- XR32-A12-TERRAIN-01: climate and snow tiles derived from the XR32 data of the climate texture and light map --
 *
 * ground_desc_t::init_ground_textures() makes every climate and snow tile with create_textured_tile(): a copy of the
 * slope's light map in which each pixel becomes min(31, light5 * tex5 / 16) per channel, the texture pixel taken at
 * the same column and row (rows counted from the texture's y). From 16-bit words, into 16-bit words: a texture with
 * 2,000 colours keeps a few dozen. Such a tile gets a node shell and a recipe (light map, texture), like a coast
 * water tile (A4), and its raster is composed whenever a cache is built from it with the same pixel set and the same
 * placement, at 8 bits: min(255, (light8 * tex8 + 64) >> 7) - neutral light 128 is the legacy 16. A source pixel
 * without XR32 colour takes its 16-bit word as the palette shows it.
 */

/// one RGB555 word as the palette shows it by day (stlab_derive_legacy_rgba without the night)
static inline void stlab_derive_rgb555(STORED_PIXVAL v, int *c)
{
	c[0] = (v & 0x7C00) >> 7;  c[1] = (v & 0x03E0) >> 2;  c[2] = (v & 0x001F) << 3;
}


/// one opaque pixel of a derived climate tile: light x texture per channel at 8 bits (neutral 128). A product that
/// lands exactly on 231,255,255 - Simutrans' transparent key, which the XR32 zoom reads as a hole - becomes 232,255,255
static inline void stlab_derive_product(const int *lc, const int *tc, uint8 *dp)
{
	for(  int c = 0;  c < 3;  c++  ) {
		const int v = (lc[c] * tc[c] + 64) >> 7;
		dp[c] = (uint8)(v > 255 ? 255 : v);
	}
	if(  dp[0] == 0xE7  &&  dp[1] == 0xFF  &&  dp[2] == 0xFF  ) {
		dp[0] = 0xE8;
	}
	dp[3] = 255;
}


/// the XR32 node of source image @p n for a climate composition, or NULL (its 16-bit words are used then). A v1 node's runs
/// only say that a pixel equals a key of image_t::rgbtab (makeobj infers them from the RGB); a v2 node's are declared.
static const stlab_xr32_image_t *stlab_derive_source_node(image_id n)
{
	const stlab_xr32_slot_t *s = stlab_slot( n, false );
	return (s != NULL  &&  s->img != NULL  &&  s->img->rgba != NULL  &&  (s->img->run_count == 0  ||  s->img->version < 2)  &&  !stlab_derived.count( n )) ? s->img : NULL;
}


/// may image @p n be a colour source (light map or climate texture) of a derived climate tile? A source is only ever read
/// as a colour: create_textured_tile() writes plain RGB555, so a tile has no special colours whatever its sources hold. A
/// colour that happens to be exactly a key of image_t::rgbtab makes an opaque special colour of its 16-bit word
/// (0x8000 + key), while its XR32 plane keeps the colour. That must not cost the tile its 32-bit picture. What still does:
/// semi-transparent pixels (their runs have another layout and their meaning as a source is undefined), semantics declared
/// in a v2 node, and the words of a generated node (SIMUTRANS_XR32_NIGHTGEN), which are all that node is made of.
static bool stlab_derive_source_usable(image_id n)
{
	const imd32 &d = images[n];
	if(  d.base_data == NULL  ||  (d.recode_flags & FLAG_HAS_TRANSPARENT_COLOR)  ) {
		return false;
	}
	const stlab_xr32_slot_t *s = stlab_slot( n, false );
	if(  s != NULL  &&  s->img != NULL  &&  s->img->version >= 2  &&  s->img->run_count != 0  ) {
		return false;
	}
	const STORED_PIXVAL first_refused = (s != NULL  &&  s->generated) ? 0x8000 : 0x8000 + SPECIAL;
	const STORED_PIXVAL *sp = d.base_data;
	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
		uint16 runlen = *sp++;
		do {
			runlen = *sp++;
			if(  runlen & TRANSPARENT_RUN  ) {
				return false;
			}
			for(  uint16 k = 0;  k < runlen;  k++  ) {
				if(  sp[k] >= first_refused  ) {
					return false;
				}
			}
			sp += runlen;
		} while(  (runlen = *sp++)  );
	}
	return true;
}


/// one word of a source without XR32 colour: an opaque special colour is the key's own RGB, what the sheet painted
static inline void stlab_derive_source_rgb(STORED_PIXVAL v, int *c)
{
	if(  v >= 0x8000  ) {
		const uint32 rgb = image_t::rgbtab[v - 0x8000];
		c[0] = (rgb >> 16) & 0xFF;  c[1] = (rgb >> 8) & 0xFF;  c[2] = rgb & 0xFF;
	}
	else {
		stlab_derive_rgb555( v, c );
	}
}


/// is image @p n a full rectangle at x 0: every row one clear run of 0 and one run of the full width?
/// (what create_textured_tile assumes when it reads the texture as rows of width + 3 words)
static bool stlab_derive_full_rect(image_id n)
{
	const imd32 &d = images[n];
	if(  d.base_data == NULL  ||  d.base_x != 0  ||  d.base_w <= 0  ||  d.base_h <= 0  ) {
		return false;
	}
	const STORED_PIXVAL *sp = d.base_data;
	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
		if(  sp[0] != 0  ||  sp[1] != (STORED_PIXVAL)d.base_w  ||  sp[2 + d.base_w] != 0  ) {
			return false;
		}
		sp += d.base_w + 3;
	}
	return true;
}


bool stlab_xr32_derive_climate_tile(image_id tile, image_id light, image_id tex)
{
	if(  !stlab_xr32_enabled()  ||  tile >= anz_images  ||  light >= anz_images  ||  tex >= anz_images  ) {
		return false;
	}
	const stlab_xr32_image_t *tn = stlab_derive_source_node( tex );
	const stlab_xr32_image_t *ln = stlab_derive_source_node( light );
	if(  tn == NULL  &&  ln == NULL  ) {
		return false;   // neither source has XR32 colour of its own: the tile stays the 16-bit one
	}
	const imd32 &t = images[tile], &l = images[light];
	// the tile is a copy of the light map (copy_rotate(0)); the texture a full rectangle covering the tile's rows
	if(  t.base_w <= 0  ||  t.base_h <= 0  ||  t.base_w != l.base_w  ||  t.base_h != l.base_h  ||  t.base_x != l.base_x  ||  t.base_y != l.base_y
	     ||  !stlab_derive_full_rect( tex )  ||  t.base_w > images[tex].base_w
	     ||  t.base_y < images[tex].base_y  ||  t.base_y + t.base_h > images[tex].base_y + images[tex].base_h
	     ||  !stlab_derive_plain( tile )  ||  !stlab_derive_source_usable( light )  ||  !stlab_derive_source_usable( tex )  ) {
		return false;
	}
	stlab_xr32_image_t *shell = new stlab_xr32_image_t();
	shell->width = (uint16)t.base_w;  shell->height = (uint16)t.base_h;
	shell->x = t.base_x;  shell->y = t.base_y;
	shell->zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
	shell->version = (tn ? tn : ln)->version;
	if(  !stlab_xr32_attach( tile, shell, t.base_x, t.base_y, t.base_w, t.base_h, shell->zoomable )  ) {
		delete shell;
		return false;
	}
	stlab_xr32_derive_t &rc = stlab_derived[tile];
	rc.light = light;  rc.ref = tex;  rc.climate = true;
	rc.gen = ++stlab_derive_gen;
	stlab_derive_cache_forget( tile );
	return true;
}


/// compose the raster (and the night plane if the texture has one) of a derived climate / snow tile
static bool stlab_derive_compose_climate(image_id tile, const stlab_xr32_derive_t &rc, stlab_xr32_image_t &out)
{
	const stlab_xr32_image_t *tn = stlab_derive_source_node( rc.ref );     // texture (A12-A)
	const stlab_xr32_image_t *ln = stlab_derive_source_node( rc.light );   // light map (A12-B)
	if(  tn == NULL  &&  ln == NULL  ) {
		return false;
	}
	const bool night = tn != NULL  &&  tn->night != NULL;
	const imd32 &t = images[tile], &l = images[rc.light], &r = images[rc.ref];
	const uint32 w = (uint32)t.base_w, h = (uint32)t.base_h;
	uint8 *day = (uint8 *)calloc( (size_t)w * h, 4 );
	uint8 *nig = night ? (uint8 *)calloc( (size_t)w * h, 4 ) : NULL;
	if(  day == NULL  ||  (night  &&  nig == NULL)  ) {
		free( day );  free( nig );
		return false;
	}
	const STORED_PIXVAL *lp = l.base_data;
	const STORED_PIXVAL *rp = r.base_data;
	const sint32 rw = r.base_w;
	for(  uint32 j = 0;  j < h;  j++  ) {
		sint32 x = *lp++;
		uint16 runlen;
		const sint32 row = t.base_y + (sint32)j - r.base_y;   // create_textured_tile's texture row
		do {
			runlen = *lp++;
			for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
				if(  x < 0  ||  (uint32)x >= w  ||  x >= rw  ) continue;
				const size_t ti = (size_t)row * rw + x;
				int lc[3], tc[3];
				// the light map pixel: its XR32 colour if it has one there (A12-B), otherwise its 16-bit word
				const uint8 *lx = ln ? ln->rgba + ((size_t)j * w + x) * 4 : NULL;
				if(  lx  &&  lx[3]  ) {
					lc[0] = lx[0];  lc[1] = lx[1];  lc[2] = lx[2];
				}
				else {
					stlab_derive_source_rgb( lp[k], lc );
				}
				// the texture pixel: likewise (A12-A)
				const uint8 *tx = tn ? tn->rgba + ti * 4 : NULL;
				if(  tx  &&  tx[3]  ) {
					tc[0] = tx[0];  tc[1] = tx[1];  tc[2] = tx[2];
				}
				else {
					stlab_derive_source_rgb( rp[(size_t)row * (rw + 3) + 2 + x], tc );
				}
				uint8 *dp = day + ((size_t)j * w + x) * 4;
				stlab_derive_product( lc, tc, dp );
				if(  night  ) {
					const uint8 *nx = tn->night + ti * 4;
					int nc[3] = { tc[0], tc[1], tc[2] };
					if(  nx[3]  ) {
						nc[0] = nx[0];  nc[1] = nx[1];  nc[2] = nx[2];
					}
					stlab_derive_product( lc, nc, nig + ((size_t)j * w + x) * 4 );
				}
			}
			lp += runlen;
			x += *lp;
		} while(  *lp++ != 0  );
	}
	out.width = (uint16)w;  out.height = (uint16)h;
	out.x = t.base_x;  out.y = t.base_y;
	out.zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
	out.version = (tn ? tn : ln)->version;
	out.rgba = day;
	out.night = nig;
	return true;
}


/* XR32-A4-PHASE-CACHE-OPTIMIZATION-01: step 1 of a composition, the texture, depends on the sea image (one per water
 * animation stage) and the water climate texture only - not on the slope: the 65 slopes of one stage build the same
 * one. The last STLAB_DERIVE_TEX_KEEP textures are kept, most recent first. A burst of compositions (a light change,
 * a new stage in view, a zoom step) composes the tiles of one stage, so one entry serves the whole burst; the others
 * cover two display lanes and a stage change inside a burst. The key is everything step 1 reads, so a changed input
 * never meets an old texture; zoom, palette, night_shift and the player are applied later (resolve, zoom build) and
 * are not part of it. Read-only once built and shared by pointer: the screen cache and the zoom cache are
 * built under different locks, so two lanes may compose at the same time.
 */
struct stlab_derive_tex_t {
	// the key: what the texture is built from
	image_id sea = IMG_EMPTY, ref = IMG_EMPTY;
	const STORED_PIXVAL *sea_data = NULL, *ref_data = NULL;
	const uint8 *sea_rgba = NULL, *sea_night = NULL, *ref_rgba = NULL, *ref_night = NULL;
	int light = 0;
	sint32 rw = 0, ry = 0, rh = 0;
	// the texture: rows ry .. rh - 1 of the water climate texture, columns 0 .. rw - 1, RGBA; texn at night
	std::vector<uint8> tex, texn;
};
static const size_t STLAB_DERIVE_TEX_KEEP = 4;
static std::vector< std::shared_ptr<const stlab_derive_tex_t> > stlab_derive_texs;
#ifdef MULTI_THREAD
static pthread_mutex_t stlab_derive_tex_mutex = PTHREAD_MUTEX_INITIALIZER;
#endif


static bool stlab_derive_tex_is(const stlab_derive_tex_t &a, const stlab_derive_tex_t &b)
{
	return a.sea == b.sea  &&  a.ref == b.ref  &&  a.sea_data == b.sea_data  &&  a.ref_data == b.ref_data
	    &&  a.sea_rgba == b.sea_rgba  &&  a.sea_night == b.sea_night  &&  a.ref_rgba == b.ref_rgba  &&  a.ref_night == b.ref_night
	    &&  a.light == b.light  &&  a.rw == b.rw  &&  a.ry == b.ry  &&  a.rh == b.rh;
}


/// step 1 of a composition: the texture of @p rc's stage, from the cache or built (and kept)
static std::shared_ptr<const stlab_derive_tex_t> stlab_derive_texture(const stlab_xr32_derive_t &rc, const stlab_xr32_image_t *sn,
                                                                      const stlab_xr32_image_t *rn)
{
	const imd32 &sea = images[rc.sea], &r = images[rc.ref];
	const bool night = sn->night != NULL;
	stlab_derive_tex_t key;
	key.sea = rc.sea;  key.ref = rc.ref;  key.sea_data = sea.base_data;  key.ref_data = r.base_data;
	key.sea_rgba = sn->rgba;  key.sea_night = sn->night;  key.ref_rgba = rn ? rn->rgba : NULL;  key.ref_night = rn ? rn->night : NULL;
	key.light = light_level;  key.rw = r.base_w;  key.ry = r.base_y;  key.rh = r.base_h;
#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_tex_mutex );
#endif
	for(  size_t i = 0;  i < stlab_derive_texs.size();  i++  ) {
		if(  stlab_derive_tex_is( *stlab_derive_texs[i], key )  ) {
			std::shared_ptr<const stlab_derive_tex_t> hit = stlab_derive_texs[i];
			for(  size_t j = i;  j > 0;  j--  ) {
				stlab_derive_texs[j] = stlab_derive_texs[j - 1];
			}
			stlab_derive_texs[0] = hit;
#ifdef MULTI_THREAD
			pthread_mutex_unlock( &stlab_derive_tex_mutex );
#endif
			return hit;
		}
	}
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_tex_mutex );
#endif

	// 1. the texture, as create_texture_from_tile() builds it: the water climate texture (rows r.y .. r.h - 1 in
	//    its own convention, columns 0 .. w - 1), then every sea pixel pasted at its place and four neighbours
	std::shared_ptr<stlab_derive_tex_t> made = std::make_shared<stlab_derive_tex_t>( key );
	const sint32 rw = key.rw, ry = key.ry, rh = key.rh;
	const size_t tex_px = (size_t)rw * (size_t)(rh > 0 ? rh : 0);
	std::vector<uint8> &tex = made->tex, &texn = made->texn;
	tex.assign( tex_px * 4, 0 );
	texn.assign( night ? tex_px * 4 : 0, 0 );
	{
		const STORED_PIXVAL *sp = r.base_data;
		for(  sint32 y = 0;  y < rh;  y++  ) {
			sint32 x = 0;
			uint16 runlen = *sp++;
			do {
				x += runlen;
				runlen = *sp++;
				for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
					if(  x < 0  ||  x >= rw  ) continue;
					const size_t i = (size_t)y * rw + x;
					// by day the texture's XR32 colour if it has one, otherwise its legacy colour; at night its XR32
					// night plane if it has one, otherwise the legacy level-4 colour (what NIGHTGEN gives a legacy pixel)
					uint8 ld[4], ln[4];
					stlab_derive_legacy_rgba( sp[k], ld, ln );
					const bool xr = rn  &&  (uint32)y < rn->height  &&  (uint32)x < rn->width  &&  rn->x == 0  &&  rn->y == ry
					                &&  rn->rgba[((size_t)y * rn->width + x) * 4 + 3];
					memcpy( &tex[i * 4], xr ? rn->rgba + ((size_t)y * rn->width + x) * 4 : ld, 4 );
					if(  night  ) {
						memcpy( &texn[i * 4], (xr  &&  rn->night) ? rn->night + ((size_t)y * rn->width + x) * 4 : ln, 4 );
					}
				}
				sp += runlen;
			} while(  (runlen = *sp++)  );
		}
	}
	{
		const STORED_PIXVAL *sp = sea.base_data;
		for(  sint32 y = 0;  y < sea.base_h;  y++  ) {
			sint32 x = sea.base_x;
			uint16 runlen = *sp++;
			do {
				x += runlen;
				runlen = *sp++;
				for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
					// the colour of this sea pixel: its XR32 day / night value, the legacy one if the node has none there
					uint8 dc[4], nc[4];
					const sint32 sx = x - sn->x, sy = y + sea.base_y - sn->y;
					const bool has = sx >= 0  &&  sy >= 0  &&  sx < sn->width  &&  sy < sn->height  &&  sn->rgba[((size_t)sy * sn->width + sx) * 4 + 3];
					if(  has  ) {
						memcpy( dc, sn->rgba + ((size_t)sy * sn->width + sx) * 4, 4 );
						if(  night  ) memcpy( nc, sn->night + ((size_t)sy * sn->width + sx) * 4, 4 );
					}
					else {
						stlab_derive_legacy_rgba( sp[k], dc, night ? nc : NULL );
					}
					// copypixel() of create_texture_from_tile(), the same five places in the same order and bounds
					const sint32 yy0 = y + sea.base_y;
					const sint32 px[5] = { x, x + rw / 2, x - rw / 2, x + rw / 2, x - rw / 2 };
					const sint32 py[5] = { yy0, yy0 + rw / 4, yy0 + rw / 4, yy0 - rw / 4, yy0 - rw / 4 };
					for(  int c = 0;  c < 5;  c++  ) {
						if(  ry <= py[c]  &&  py[c] < rh  &&  0 <= px[c]  &&  px[c] < rw  ) {
							const size_t i = (size_t)(py[c] - ry) * rw + px[c];
							memcpy( &tex[i * 4], dc, 4 );
							if(  night  ) memcpy( &texn[i * 4], nc, 4 );
						}
					}
				}
				sp += runlen;
			} while(  (runlen = *sp++)  );
		}
	}

#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_tex_mutex );
#endif
	stlab_derive_texs.insert( stlab_derive_texs.begin(), made );
	if(  stlab_derive_texs.size() > STLAB_DERIVE_TEX_KEEP  ) {
		stlab_derive_texs.pop_back();
	}
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_tex_mutex );
#endif
	return made;
}


/// compose the raster (and the night plane if the sea has one) of a derived tile; false if it cannot be done
static bool stlab_derive_compose(image_id tile, const stlab_xr32_derive_t &rc, stlab_xr32_image_t &out)
{
	if(  rc.climate  ) {
		return stlab_derive_compose_climate( tile, rc, out );   // XR32-A12-TERRAIN-01
	}
	const stlab_xr32_slot_t *ss = stlab_slot( rc.sea, false );
	if(  ss == NULL  ||  ss->img == NULL  ||  ss->img->rgba == NULL  ) {
		return false;
	}
	const stlab_xr32_image_t *sn = ss->img;
	const stlab_xr32_slot_t *rs = stlab_slot( rc.ref, false );
	const stlab_xr32_image_t *rn = (rs != NULL  &&  rs->img != NULL  &&  rs->img->rgba != NULL  &&  !stlab_derived.count( rc.ref )) ? rs->img : NULL;
	const bool night = sn->night != NULL;
	const imd32 &t = images[tile], &l = images[rc.light];

	// 1. the texture of this stage (shared by every slope of it)
	const std::shared_ptr<const stlab_derive_tex_t> tx = stlab_derive_texture( rc, sn, rn );
	const std::vector<uint8> &tex = tx->tex, &texn = tx->texn;
	const sint32 rw = tx->rw, ry = tx->ry, rh = tx->rh;

	// 2. the tile, as create_textured_tile(binary) cuts it: where the light map is not black, the texture pixel at the
	//    same column and row; where it is black, the tile keeps that black
	const uint32 w = (uint32)t.base_w, h = (uint32)t.base_h;
	uint8 *day = (uint8 *)calloc( (size_t)w * h, 4 );
	uint8 *nig = night ? (uint8 *)calloc( (size_t)w * h, 4 ) : NULL;
	if(  day == NULL  ||  (night  &&  nig == NULL)  ) {
		free( day );  free( nig );
		return false;
	}
	const STORED_PIXVAL *tp = t.base_data, *lp = l.base_data;
	for(  uint32 j = 0;  j < h;  j++  ) {
		sint32 x = *tp++;  lp++;
		uint16 runlen;
		do {
			runlen = *tp++;  lp++;
			for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
				const STORED_PIXVAL lv = lp[k];
				if(  x < 0  ||  (uint32)x >= w  ) continue;
				uint8 *dp = day + ((size_t)j * w + x) * 4;
				uint8 *np = night ? nig + ((size_t)j * w + x) * 4 : NULL;
				const sint32 row = t.base_y + (sint32)j - ry;
				if(  lv != 0  &&  row >= 0  &&  row < rh  &&  x < rw  ) {
					const size_t i = (size_t)row * rw + x;
					memcpy( dp, &tex[i * 4], 4 );
					if(  night  ) memcpy( np, &texn[i * 4], 4 );
				}
				else {
					stlab_derive_legacy_rgba( tp[k], dp, np );   // black where the light map is black (binary mode)
				}
			}
			tp += runlen;  lp += runlen;
			x += *tp;
		} while(  (lp++, *tp++) != 0  );
	}
	out.width = (uint16)w;  out.height = (uint16)h;
	out.x = t.base_x;  out.y = t.base_y;
	out.zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
	out.version = sn->version;
	out.rgba = day;
	out.night = nig;
	return true;
}


/* XR32-A12-P1: the composed rasters of derived tiles, kept for reuse.
 *
 * A derived tile's raster - an A12 climate or snow tile, an A4 coast water tile - is a function of its recipe and of the data of
 * its sources only. The zoom, the player and the night level are applied after it (resolve, zoom build), so one raster serves the
 * screen cache at 1/1, every zoom cache and the base-size runs. A coast tile whose sea has a night plane also reads light_level
 * (stlab_derive_legacy_rgba; a constant 0 in simgraph32.cc today), kept in the key so that it stays right. Without this,
 * every light change and every zoom step composed every derived tile in view again.
 *
 * The last rasters composed are kept, least recently used first out, within STLAB_DERIVE_CACHE_BYTES. An entry is valid only for
 * the registration it was composed for (rc.gen: an image id freed by init_ground_textures() and registered again gets a new one,
 * so it never meets an old raster) and for the source data it read (the pointers the phase cache checks as well). A raster is
 * read-only once made and shared by pointer: the screen cache and the zoom cache are built under different locks, so two lanes may
 * look up, compose or evict at the same time, and an evicted raster lives until its last user lets it go.
 */
struct stlab_derive_cached_t {
	// the key: the tile, its registration, and everything the composition reads
	image_id tile = IMG_EMPTY;
	uint32 gen = 0;
	int light = 0;
	const STORED_PIXVAL *tile_data = NULL, *light_data = NULL, *ref_data = NULL, *sea_data = NULL;
	const uint8 *light_rgba = NULL, *ref_rgba = NULL, *ref_night = NULL, *sea_rgba = NULL, *sea_night = NULL;
	// the raster (day plane and, if the source has one, night plane)
	std::shared_ptr<const stlab_xr32_image_t> img;
	size_t bytes = 0;
};
static const size_t STLAB_DERIVE_CACHE_BYTES = 16u << 20;
static std::list<stlab_derive_cached_t> stlab_derive_cache;   // most recently used first
static std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator> stlab_derive_cache_index;
static size_t stlab_derive_cache_held = 0;
#ifdef MULTI_THREAD
static pthread_mutex_t stlab_derive_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
#endif


static void stlab_derive_cache_drop(std::list<stlab_derive_cached_t>::iterator e)
{
	stlab_derive_cache_held -= e->bytes;
	stlab_derive_cache_index.erase( e->tile );
	stlab_derive_cache.erase( e );
}


/// a derived tile was registered (again): its old raster, if any, describes another recipe
static void stlab_derive_cache_forget(image_id tile)
{
#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_cache_mutex );
#endif
	std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator>::iterator it = stlab_derive_cache_index.find( tile );
	if(  it != stlab_derive_cache_index.end()  ) {
		stlab_derive_cache_drop( it->second );
	}
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_cache_mutex );
#endif
}


static void stlab_derive_cache_clear()
{
#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_cache_mutex );
#endif
	stlab_derive_cache.clear();
	stlab_derive_cache_index.clear();
	stlab_derive_cache_held = 0;
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_cache_mutex );
#endif
}


static bool stlab_derive_cached_is(const stlab_derive_cached_t &a, const stlab_derive_cached_t &b)
{
	return a.tile == b.tile  &&  a.gen == b.gen  &&  a.light == b.light  &&  a.tile_data == b.tile_data  &&  a.light_data == b.light_data
	    &&  a.ref_data == b.ref_data  &&  a.sea_data == b.sea_data  &&  a.light_rgba == b.light_rgba  &&  a.ref_rgba == b.ref_rgba
	    &&  a.ref_night == b.ref_night  &&  a.sea_rgba == b.sea_rgba  &&  a.sea_night == b.sea_night;
}


/// the raster of derived tile @p tile, from the cache or composed (and kept); NULL if it cannot be composed
static std::shared_ptr<const stlab_xr32_image_t> stlab_derive_cached(image_id tile, const stlab_xr32_derive_t &rc)
{
	const stlab_xr32_slot_t *ls = stlab_slot( rc.light, false ), *rs = stlab_slot( rc.ref, false );
	const stlab_xr32_slot_t *ss = rc.climate ? NULL : stlab_slot( rc.sea, false );
	stlab_derive_cached_t key;
	key.tile = tile;  key.gen = rc.gen;
	key.tile_data = images[tile].base_data;  key.light_data = images[rc.light].base_data;  key.ref_data = images[rc.ref].base_data;
	key.sea_data = rc.climate ? NULL : images[rc.sea].base_data;
	key.light_rgba = (ls  &&  ls->img) ? ls->img->rgba : NULL;
	key.ref_rgba = (rs  &&  rs->img) ? rs->img->rgba : NULL;
	key.ref_night = (rs  &&  rs->img) ? rs->img->night : NULL;
	key.sea_rgba = (ss  &&  ss->img) ? ss->img->rgba : NULL;
	key.sea_night = (ss  &&  ss->img) ? ss->img->night : NULL;
	key.light = key.sea_night ? light_level : 0;   // only a sea night plane makes a coast tile depend on the light level
#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_cache_mutex );
#endif
	std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator>::iterator it = stlab_derive_cache_index.find( tile );
	if(  it != stlab_derive_cache_index.end()  &&  stlab_derive_cached_is( *it->second, key )  ) {
		stlab_derive_cache.splice( stlab_derive_cache.begin(), stlab_derive_cache, it->second );
		std::shared_ptr<const stlab_xr32_image_t> hit = it->second->img;
#ifdef MULTI_THREAD
		pthread_mutex_unlock( &stlab_derive_cache_mutex );
#endif
		return hit;
	}
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_cache_mutex );
#endif

	std::shared_ptr<stlab_xr32_image_t> made = std::make_shared<stlab_xr32_image_t>();
	if(  !stlab_derive_compose( tile, rc, *made )  ) {
		return NULL;
	}
	key.img = made;
	key.bytes = (size_t)made->width * made->height * 4 * ((made->rgba ? 1 : 0) + (made->night ? 1 : 0)) + sizeof(stlab_derive_cached_t);

#ifdef MULTI_THREAD
	pthread_mutex_lock( &stlab_derive_cache_mutex );
#endif
	it = stlab_derive_cache_index.find( tile );
	if(  it != stlab_derive_cache_index.end()  ) {
		stlab_derive_cache_drop( it->second );   // an older raster of this tile, or the one another lane composed meanwhile
	}
	stlab_derive_cache.push_front( key );
	stlab_derive_cache_index[tile] = stlab_derive_cache.begin();
	stlab_derive_cache_held += key.bytes;
	while(  stlab_derive_cache_held > STLAB_DERIVE_CACHE_BYTES  &&  stlab_derive_cache.size() > 1  ) {
		stlab_derive_cache_drop( std::prev( stlab_derive_cache.end() ) );
	}
#ifdef MULTI_THREAD
	pthread_mutex_unlock( &stlab_derive_cache_mutex );
#endif
	return made;
}


/// the node a cache is built from: the slot's own, or for a derived tile its composed raster (held by @p keep while it is used)
static const stlab_xr32_image_t *stlab_xr32_source(image_id n, const stlab_xr32_slot_t *s, std::shared_ptr<const stlab_xr32_image_t> &keep)
{
	if(  s == NULL  ||  s->img == NULL  ) {
		return NULL;
	}
	std::map<image_id, stlab_xr32_derive_t>::const_iterator it = stlab_derived.find( n );
	if(  it == stlab_derived.end()  ) {
		return s->img;
	}
	keep = stlab_derive_cached( n, it->second );
	return keep.get();
}


void stlab_xr32_scratch_release();
struct stlab_xr32_slot_t;

void simgraph32_alpha_plane_release();

void stlab_xr32_release_all()
{
	stlab_xr32_base_release();
	simgraph32_alpha_plane_release();
	stlab_xr32_scratch_release();
	for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) {
		stlab_xr32_zoom_release( &stlab_slots[i] );
		delete stlab_slots[i].img;
		stlab_slots[i].img = NULL;
	}
	delete [] stlab_slots;
	stlab_slots = NULL;
	stlab_slots_alloc = 0;
	stlab_derived.clear();
	stlab_derive_texs.clear();
	stlab_derive_cache_clear();
}


/* --- the replacement producer of data[player] -------------------------------- */

/* CANDIDATE C1 -- scratch buffers reused across images.
 *
 * The producer used to malloc and free two buffers per image: a dense w*h*4
 * RGBA raster, and a run-stream buffer sized for the worst case. Both are
 * strictly internal to one call, so neither has to be a fresh allocation, and
 * the worst-case one must not become the screen cache: at pakset scale that
 * kept 53.2 MB where the exact length needs 15.7 MB.
 *
 * recode_img() holds recode_img_mutex32 across this call under MULTI_THREAD.
 */
static uint32 *stlab_scratch_raster = NULL;
static size_t  stlab_scratch_raster_px = 0;
static PIXVAL *stlab_scratch_out = NULL;
static size_t  stlab_scratch_out_len = 0;


static bool stlab_scratch_reserve(size_t want_px, size_t want_out)
{
	if(  want_px > stlab_scratch_raster_px  ) {
		free( stlab_scratch_raster );
		stlab_scratch_raster = MALLOCN( uint32, want_px );
		if(  stlab_scratch_raster == NULL  ) {
			stlab_scratch_raster_px = 0;
			return false;
		}
		stlab_scratch_raster_px = want_px;
	}
	if(  want_out > stlab_scratch_out_len  ) {
		free( stlab_scratch_out );
		stlab_scratch_out = MALLOCN( PIXVAL, want_out );
		if(  stlab_scratch_out == NULL  ) {
			stlab_scratch_out_len = 0;
			return false;
		}
		stlab_scratch_out_len = want_out;
	}
	return true;
}


void stlab_xr32_scratch_release()
{
	free( stlab_scratch_raster );  stlab_scratch_raster = NULL;  stlab_scratch_raster_px = 0;
	free( stlab_scratch_out );     stlab_scratch_out = NULL;     stlab_scratch_out_len = 0;
}


/// worst case of stlab_xr32_encode_rows(): per row a leading clear, then per pixel a
/// separator + count + the pixel (alternating opaque and translucent), and the terminator
static inline size_t stlab_xr32_encode_cap(uint32 w, uint32 h)
{
	return (size_t)h * (3 + 3 * (size_t)w) + 8;
}


/**
 * Encode a resolved raster as the screen run stream: [clear][count][pixels...]...[0] per
 * row. A raster pixel is 0 (hole), 0xFFrrggbb (opaque) or 0xAArrggbb with 8 <= AA <= 254
 * (straight alpha). Opaque and translucent pixels go into separate runs; a translucent run
 * carries TRANSPARENT_RUN and keeps the full ARGB word, which the screen-space blitters
 * tell apart from the legacy class+alpha codes (all below 0x10000) by the top byte. Two
 * adjacent runs are separated by TRANSPARENT_RUN as a zero-length clear run, the separator
 * the legacy encoder uses, because a clear run of 0 ends the row.
 */
static PIXVAL *stlab_xr32_encode_rows(const uint32 *raster, uint32 w, uint32 h, PIXVAL *d)
{
	for(  uint32 y = 0;  y < h;  y++  ) {
		const uint32 *row = raster + (size_t)y * w;
		uint32 x = 0;
		bool first = true;
		while(  x < w  ) {
			uint32 clear = 0;
			while(  x < w  &&  row[x] == 0  ) { clear++; x++; }
			if(  x >= w  ) {
				if(  first  ) { *d++ = 0; *d++ = 0; }   // an entirely empty row
				break;
			}
			*d++ = first  ||  clear  ?  (PIXVAL)clear  :  (PIXVAL)TRANSPARENT_RUN;
			const bool opaque = (row[x] >> 24) == 0xFFu;
			const uint32 start = x;
			while(  x < w  &&  row[x] != 0  &&  ((row[x] >> 24) == 0xFFu) == opaque  ) { x++; }
			const uint32 count = x - start;
			*d++ = opaque  ?  (PIXVAL)count  :  (PIXVAL)(count | TRANSPARENT_RUN);
			for(  uint32 k = 0;  k < count;  k++  ) {
				*d++ = (PIXVAL)row[start + k];
			}
			first = false;
		}
		if(  first  &&  w == 0  ) { *d++ = 0; *d++ = 0; }
		*d++ = 0;                                        // end of row
	}
	return d;
}


/**
 * Resolve the candidate node for one player and encode the result as the screen run
 * stream the blitters already consume: [clear][count][pixels...]...[0] per row.
 *
 * No STORED_PIXVAL is read or written anywhere in here.
 */
#include "stlab_xr32_zoom.cci"       // native zoom, section 39 of the design report


/**
 * MRES (MRES-V2-SPEC.md, section 5). At exactly 2/1, a candidate-backed image whose
 * authored 2x counterpart ALSO carries a candidate shows that counterpart, resolved
 * at 1:1, instead of its own native enlargement. Returns false - and clears any
 * previous choice - whenever that does not apply, so the native zoom takes over.
 * A fitted image (fit_num != 0) is at its fit step, not at the map's zoom, exactly
 * as stlab_xr32_zoom_prepare() sizes it: otherwise a map zoom change dropped a
 * toolbar icon's 2x art for its 1x art at 2/1 until the next refit.
 * Called under rezoom_img_mutex32, like stlab_xr32_zoom_prepare().
 */
static bool stlab_xr32_hires_prepare(image_id n)
{
	stlab_xr32_slot_t *s = stlab_slot( n, false );
	if(  s == NULL  ||  s->img == NULL  ) {
		return false;
	}
	s->hires_active = IMG_EMPTY;
	const sint32 num = s->fit_num ? s->fit_num : g_simgraph32.zoom_num[zoom_factor32];
	const sint32 den = s->fit_num ? s->fit_den : g_simgraph32.zoom_den[zoom_factor32];
	if(  (images[n].recode_flags & FLAG_ZOOMABLE) == 0  ||  num != 2  ||  den != 1  ) {
		return false;
	}
	const image_id hi = simgraph_get_hires( n );
	if(  hi == IMG_EMPTY  ||  hi >= anz_images  ) {
		return false;
	}
	const stlab_xr32_slot_t *hs = stlab_slot( hi, false );
	if(  hs == NULL  ||  hs->img == NULL  ) {
		return false;             // a legacy-only counterpart: the 1x candidate is zoomed natively
	}
	const stlab_xr32_image_t *hi_img = hs->img;
	if(  (hi_img->night != NULL) != (s->img->night != NULL)  ) {
		return false;             // XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: never swap the night away when zooming
	}
	if(  (sint32)hi_img->height < images[n].base_h * 2 - 2
	     ||  (sint32)hi_img->height > images[n].base_h * 2 + 2
	     ||  (sint32)hi_img->width < images[n].base_w * 2 - 2
	     ||  (sint32)hi_img->width > images[n].base_w * 2 + 2  ) {
		return false;
	}
	stlab_xr32_zoom_release( s );
	images[n].player_flags = 0xFFFF;
	for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
		if(  images[n].data[i] != NULL  ) {
			free( images[n].data[i] );
			images[n].data[i] = NULL;
		}
	}
	images[n].x = hi_img->x;
	images[n].y = hi_img->y;
	images[n].w = (sint16)hi_img->width;
	images[n].h = (sint16)hi_img->height;
	s->hires_active = hi;
	images[n].recode_flags &= ~FLAG_REZOOM;
	return true;
}


/// resolved_night of a screen cache that holds the DAY resolution (XR32-UI-DAYTIME-01)
static const int STLAB_RESOLVED_DAYTIME = -1000;

bool stlab_xr32_recode(image_id n, sint8 player_nr);


/**
 * XR32-UI-DAYTIME-01: the screen cache of image @p n for @p player_nr, resolved for the day - what a draw with
 * daynight=false needs at night. The cache is the one the world draws from, so it is marked stale for the world
 * afterwards (player_flags); the world never asks for daynight=false (the interface does), and the interface is
 * drawn after the world's display lanes, so the two never use it at the same time. Call under recode_img_mutex32.
 */
bool stlab_xr32_recode_daytime(image_id n, sint8 player_nr)
{
	stlab_xr32_slot_t *s = stlab_slot( n, false );
	if(  s == NULL  ||  s->img == NULL  ) {
		return false;
	}
	if(  images[n].data[player_nr] != NULL  &&  s->resolved_player == (uint8)player_nr  &&  s->resolved_night == STLAB_RESOLVED_DAYTIME  ) {
		return true;
	}
	stlab_daytime = true;
	const bool ok = stlab_xr32_recode( n, player_nr );
	stlab_daytime = false;
	if(  ok  ) {
		s->resolved_night = STLAB_RESOLVED_DAYTIME;
		images[n].player_flags |= (uint16)(1 << player_nr);
	}
	return ok;
}


/// XR32-UI-DAYTIME-01: the palette changed (recode32): a day resolution may no longer describe it either
void stlab_xr32_forget_daytime()
{
	stlab_xr32_base_release();
	for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) {
		if(  stlab_slots[i].resolved_night == STLAB_RESOLVED_DAYTIME  ) {
			stlab_slots[i].resolved_night = -999;
		}
	}
}


bool stlab_xr32_recode(image_id n, sint8 player_nr)
{
	stlab_xr32_slot_t *s = stlab_slot(n, false);
	if(  s == NULL  ||  s->img == NULL  ) {
		return false;
	}
	// away from neutral the screen cache comes from the derived scaled cache. Never
	// the STORED16 path.
	// XR32-FIT-IMG-TO-WIDTH-01: an image fitted by fit_img_to_width() keeps the step chosen there, whatever the
	// world zoom, exactly as a legacy image keeps the zoom_data that fit built
	const bool fitted = s->fit_num != 0;
	const bool scaled = s->hires_active == IMG_EMPTY
	                    &&  (fitted  ||  (zoom_factor32 != ZOOM_NEUTRAL  &&  (images[n].recode_flags & FLAG_ZOOMABLE) != 0));
	if(  scaled  &&  stlab_xr32_zoom_recode( n, player_nr )  ) {
		return true;
	}
	if(  scaled  &&  s->zoom == NULL  ) {
		// the image degenerates at this scale: stlab_xr32_zoom_prepare() left h = 0, as
		// the legacy resampler does, and there is nothing to draw. The unscaled
		// candidate below would draw it at its 1:1 size and offsets.
		imd32 &im = images[n];
		if(  im.data[player_nr] == NULL  ) {
			im.data[player_nr] = MALLOCN( PIXVAL, 1 );
			im.data[player_nr][0] = 0;
		}
		im.h = 0;
		s->resolved_player = (uint8)player_nr;
		s->resolved_night = night_shift;
		return true;
	}
	// back at neutral the scaled cache is dead weight
	if(  zoom_factor32 == ZOOM_NEUTRAL  &&  s->zoom != NULL  &&  !fitted  ) {
		stlab_xr32_zoom_release( s );
	}
	// XR32-COAST-RENDERING-01: a derived tile's raster (XR32-A12-P1: from the cache of composed rasters)
	std::shared_ptr<const stlab_xr32_image_t> derived;
	const stlab_xr32_image_t *img = stlab_xr32_source( n, s, derived );
	if(  img == NULL  ) {
		return false;
	}
	if(  s->hires_active != IMG_EMPTY  &&  (zoom_factor32 != ZOOM_NEUTRAL  ||  fitted)  ) {
		// MRES: the authored 2x candidate, resolved at 1:1 (stlab_xr32_hires_prepare); fit_img_to_width() at
		// exactly 2/1 chooses it too, as the legacy rezoom does
		const stlab_xr32_slot_t *hs = stlab_slot( s->hires_active, false );
		if(  hs != NULL  &&  hs->img != NULL  ) {
			img = hs->img;
		}
	}
	const uint32 w = img->width, h = img->height;
	const uint32 npx = w * h;

	if(  !stlab_scratch_reserve( npx, stlab_xr32_encode_cap( w, h ) )  ) {
		return false;
	}
	uint32 *raster = stlab_scratch_raster;
	stlab_xr32_resolve( img, player_nr, raster );

	PIXVAL *out = stlab_scratch_out;
	PIXVAL *d = stlab_xr32_encode_rows( raster, w, h, out );
	imd32 &im = images[n];
	const size_t used = (size_t)(d - out);
	if(  im.data[player_nr] != NULL  ) {
		free( im.data[player_nr] );
	}
	PIXVAL *cache = MALLOCN( PIXVAL, used );
	memcpy( cache, out, used * sizeof(PIXVAL) );
	im.data[player_nr] = cache;
	im.len = (uint32)used;
	im.w = (sint16)w;
	im.h = (sint16)h;
	s->resolved_player = (uint8)player_nr;
	s->resolved_night = night_shift;
	return true;
}


/* --- XR32-UI-BASE-01: an image at its BASE size, for the interface ------------------------------------
 *
 * simgraph32_draw_base_img() and its blend form draw an image at its unzoomed base size while the world is
 * zoomed (the interface's images: gui_image, gui_image_list, the convoy and vehicle lists ...). For a legacy
 * image they read base_data, which for a candidate-backed image is its 16-bit picture. These are the 1:1 XR32
 * runs instead, kept apart from the world's screen cache (which holds the zoomed image), per image for one
 * player and one context at a time (the night level, or STLAB_RESOLVED_DAYTIME for daynight=false).
 */
struct stlab_xr32_base_t {
	PIXVAL *runs = NULL;
	uint8 player = 0xFF;
	int night = -999;
};
static std::map<image_id, stlab_xr32_base_t> stlab_base_runs;


/// the 1:1 runs of image @p n for @p player_nr, and their geometry; NULL if it has no XR32 data. Call under
/// recode_img_mutex32 (it uses the shared scratch buffers). The pointer stays valid until the next palette
/// change (stlab_xr32_forget_daytime) or release.
const PIXVAL *stlab_xr32_base_runs(image_id n, sint8 player_nr, bool daynight, scr_coord_val *x, scr_coord_val *y,
                                   scr_coord_val *w, scr_coord_val *h)
{
	const stlab_xr32_slot_t *s = stlab_slot( n, false );
	if(  s == NULL  ||  s->img == NULL  ) {
		return NULL;
	}
	const stlab_xr32_image_t *img = s->img;
	*x = img->x;
	*y = img->y;
	*w = img->width;
	*h = img->height;
	// daynight=true is the night level's resolution (the day_night tables, also at level 0), daynight=false the
	// day context of XR32-UI-DAYTIME-01 (the all_day tables) - the two tables the 16-bit families read
	const int key = daynight ? night_shift : STLAB_RESOLVED_DAYTIME;
	stlab_xr32_base_t &b = stlab_base_runs[n];
	if(  b.runs != NULL  &&  b.player == (uint8)player_nr  &&  b.night == key  ) {
		return b.runs;
	}
	const uint32 npx = (uint32)img->width * img->height;
	if(  npx == 0  ||  !stlab_scratch_reserve( npx, stlab_xr32_encode_cap( img->width, img->height ) )  ) {
		return NULL;
	}
	// XR32-COAST-RENDERING-01: a derived tile's raster (XR32-A12-P1: from the cache of composed rasters)
	std::shared_ptr<const stlab_xr32_image_t> derived;
	const stlab_xr32_image_t *src = stlab_xr32_source( n, s, derived );
	if(  src == NULL  ) {
		return NULL;
	}
	stlab_daytime = key == STLAB_RESOLVED_DAYTIME;
	stlab_xr32_resolve( src, player_nr, stlab_scratch_raster );
	stlab_daytime = false;
	PIXVAL *d = stlab_xr32_encode_rows( stlab_scratch_raster, img->width, img->height, stlab_scratch_out );
	const size_t used = (size_t)(d - stlab_scratch_out);
	free( b.runs );
	b.runs = MALLOCN( PIXVAL, used );
	memcpy( b.runs, stlab_scratch_out, used * sizeof(PIXVAL) );
	b.player = (uint8)player_nr;
	b.night = key;
	return b.runs;
}


/// XR32-UI-BASE-01: drop every base-size run set (the palette changed, or the images go)
static void stlab_xr32_base_release()
{
	for(  auto &b : stlab_base_runs  ) {
		free( b.second.runs );
	}
	stlab_base_runs.clear();
}
