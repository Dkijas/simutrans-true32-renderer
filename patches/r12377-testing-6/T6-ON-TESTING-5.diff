+/* --- XR32-A12-TERRAIN-01: climate and snow tiles derived from the XR32 data of the climate texture and light map --
+ *
+ * ground_desc_t::init_ground_textures() makes every climate and snow tile with create_textured_tile(): a copy of the
+ * slope's light map in which each pixel becomes min(31, light5 * tex5 / 16) per channel, the texture pixel taken at
+ * the same column and row (rows counted from the texture's y). From 16-bit words, into 16-bit words: a texture with
+ * 2,000 colours keeps a few dozen. Such a tile gets a node shell and a recipe (light map, texture), like a coast
+ * water tile (A4), and its raster is composed whenever a cache is built from it with the same pixel set and the same
+ * placement, at 8 bits: min(255, (light8 * tex8 + 64) >> 7) - neutral light 128 is the legacy 16. A source pixel
+ * without XR32 colour takes its 16-bit word as the palette shows it.
+ */
+
+/// one RGB555 word as the palette shows it by day (stlab_derive_legacy_rgba without the night)
+static inline void stlab_derive_rgb555(STORED_PIXVAL v, int *c)
+{
+	c[0] = (v & 0x7C00) >> 7;  c[1] = (v & 0x03E0) >> 2;  c[2] = (v & 0x001F) << 3;
+}
+
+
+/// one opaque pixel of a derived climate tile: light x texture per channel at 8 bits (neutral 128). A product that
+/// lands exactly on 231,255,255 - Simutrans' transparent key, which the XR32 zoom reads as a hole - becomes 232,255,255
+static inline void stlab_derive_product(const int *lc, const int *tc, uint8 *dp)
+{
+	for(  int c = 0;  c < 3;  c++  ) {
+		const int v = (lc[c] * tc[c] + 64) >> 7;
+		dp[c] = (uint8)(v > 255 ? 255 : v);
+	}
+	if(  dp[0] == 0xE7  &&  dp[1] == 0xFF  &&  dp[2] == 0xFF  ) {
+		dp[0] = 0xE8;
+	}
+	dp[3] = 255;
+}
+
+
+/// is image @p n a full rectangle at x 0: every row one clear run of 0 and one run of the full width?
+/// (what create_textured_tile assumes when it reads the texture as rows of width + 3 words)
+static bool stlab_derive_full_rect(image_id n)
+{
+	const imd32 &d = images[n];
+	if(  d.base_data == NULL  ||  d.base_x != 0  ||  d.base_w <= 0  ||  d.base_h <= 0  ) {
+		return false;
+	}
+	const STORED_PIXVAL *sp = d.base_data;
+	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
+		if(  sp[0] != 0  ||  sp[1] != (STORED_PIXVAL)d.base_w  ||  sp[2 + d.base_w] != 0  ) {
+			return false;
+		}
+		sp += d.base_w + 3;
+	}
+	return true;
+}
+
+
+bool stlab_xr32_derive_climate_tile(image_id tile, image_id light, image_id tex)
+{
+	if(  !stlab_xr32_enabled()  ||  tile >= anz_images  ||  light >= anz_images  ||  tex >= anz_images  ) {
+		return false;
+	}
+	const stlab_xr32_slot_t *ts = stlab_slot( tex, false );
+	const stlab_xr32_slot_t *ls = stlab_slot( light, false );
+	const bool tex_xr = ts != NULL  &&  ts->img != NULL  &&  ts->img->rgba != NULL  &&  ts->img->run_count == 0  &&  !stlab_derived.count( tex );
+	const bool light_xr = ls != NULL  &&  ls->img != NULL  &&  ls->img->rgba != NULL  &&  ls->img->run_count == 0  &&  !stlab_derived.count( light );
+	if(  !tex_xr  &&  !light_xr  ) {
+		return false;   // neither source has XR32 colour of its own: the tile stays the 16-bit one
+	}
+	const imd32 &t = images[tile], &l = images[light];
+	// the tile is a copy of the light map (copy_rotate(0)); the texture a full rectangle covering the tile's rows
+	if(  t.base_w <= 0  ||  t.base_h <= 0  ||  t.base_w != l.base_w  ||  t.base_h != l.base_h  ||  t.base_x != l.base_x  ||  t.base_y != l.base_y
+	     ||  !stlab_derive_full_rect( tex )  ||  t.base_w > images[tex].base_w
+	     ||  t.base_y < images[tex].base_y  ||  t.base_y + t.base_h > images[tex].base_y + images[tex].base_h
+	     ||  !stlab_derive_plain( tile )  ||  !stlab_derive_plain( light )  ||  !stlab_derive_plain( tex )  ) {
+		return false;
+	}
+	stlab_xr32_image_t *shell = new stlab_xr32_image_t();
+	shell->width = (uint16)t.base_w;  shell->height = (uint16)t.base_h;
+	shell->x = t.base_x;  shell->y = t.base_y;
+	shell->zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
+	shell->version = (tex_xr ? ts : ls)->img->version;
+	if(  !stlab_xr32_attach( tile, shell, t.base_x, t.base_y, t.base_w, t.base_h, shell->zoomable )  ) {
+		delete shell;
+		return false;
+	}
+	stlab_xr32_derive_t &rc = stlab_derived[tile];
+	rc.light = light;  rc.ref = tex;  rc.climate = true;
+	return true;
+}
+
+
+/// the XR32 node of source image @p n for a climate composition, or NULL (its 16-bit words are used then)
+static const stlab_xr32_image_t *stlab_derive_source_node(image_id n)
+{
+	const stlab_xr32_slot_t *s = stlab_slot( n, false );
+	return (s != NULL  &&  s->img != NULL  &&  s->img->rgba != NULL  &&  s->img->run_count == 0  &&  !stlab_derived.count( n )) ? s->img : NULL;
+}
+
+
+/// compose the raster (and the night plane if the texture has one) of a derived climate / snow tile
+static bool stlab_derive_compose_climate(image_id tile, const stlab_xr32_derive_t &rc, stlab_xr32_image_t &out)
+{
+	const stlab_xr32_image_t *tn = stlab_derive_source_node( rc.ref );     // texture (A12-A)
+	const stlab_xr32_image_t *ln = stlab_derive_source_node( rc.light );   // light map (A12-B)
+	if(  tn == NULL  &&  ln == NULL  ) {
+		return false;
+	}
+	const bool night = tn != NULL  &&  tn->night != NULL;
+	const imd32 &t = images[tile], &l = images[rc.light], &r = images[rc.ref];
+	const uint32 w = (uint32)t.base_w, h = (uint32)t.base_h;
+	uint8 *day = (uint8 *)calloc( (size_t)w * h, 4 );
+	uint8 *nig = night ? (uint8 *)calloc( (size_t)w * h, 4 ) : NULL;
+	if(  day == NULL  ||  (night  &&  nig == NULL)  ) {
+		free( day );  free( nig );
+		return false;
+	}
+	const STORED_PIXVAL *lp = l.base_data;
+	const STORED_PIXVAL *rp = r.base_data;
+	const sint32 rw = r.base_w;
+	for(  uint32 j = 0;  j < h;  j++  ) {
+		sint32 x = *lp++;
+		uint16 runlen;
+		const sint32 row = t.base_y + (sint32)j - r.base_y;   // create_textured_tile's texture row
+		do {
+			runlen = *lp++;
+			for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
+				if(  x < 0  ||  (uint32)x >= w  ||  x >= rw  ) continue;
+				const size_t ti = (size_t)row * rw + x;
+				int lc[3], tc[3];
+				// the light map pixel: its XR32 colour if it has one there (A12-B), otherwise its 16-bit word
+				const uint8 *lx = ln ? ln->rgba + ((size_t)j * w + x) * 4 : NULL;
+				if(  lx  &&  lx[3]  ) {
+					lc[0] = lx[0];  lc[1] = lx[1];  lc[2] = lx[2];
+				}
+				else {
+					stlab_derive_rgb555( lp[k], lc );
+				}
+				// the texture pixel: likewise (A12-A)
+				const uint8 *tx = tn ? tn->rgba + ti * 4 : NULL;
+				if(  tx  &&  tx[3]  ) {
+					tc[0] = tx[0];  tc[1] = tx[1];  tc[2] = tx[2];
+				}
+				else {
+					stlab_derive_rgb555( rp[(size_t)row * (rw + 3) + 2 + x], tc );
+				}
+				uint8 *dp = day + ((size_t)j * w + x) * 4;
+				stlab_derive_product( lc, tc, dp );
+				if(  night  ) {
+					const uint8 *nx = tn->night + ti * 4;
+					int nc[3] = { tc[0], tc[1], tc[2] };
+					if(  nx[3]  ) {
+						nc[0] = nx[0];  nc[1] = nx[1];  nc[2] = nx[2];
+					}
+					stlab_derive_product( lc, nc, nig + ((size_t)j * w + x) * 4 );
+				}
+			}
+			lp += runlen;
+			x += *lp;
+		} while(  *lp++ != 0  );
+	}
+	out.width = (uint16)w;  out.height = (uint16)h;
+	out.x = t.base_x;  out.y = t.base_y;
+	out.zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
+	out.version = (tn ? tn : ln)->version;
+	out.rgba = day;
+	out.night = nig;
+	return true;
+}
