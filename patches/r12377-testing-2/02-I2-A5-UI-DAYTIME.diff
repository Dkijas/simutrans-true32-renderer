+ * against exactly those tables: night level 0 and the multipliers they were built with (1.0, at init).
+ * Per thread, so a display lane never sees another thread's request. */
+static thread_local bool stlab_daytime = false;
+
+
 void stlab_night_multipliers(double *rg, double *b)
 {
+	if(  stlab_daytime  ) {
+		*rg = *b = 1.0;
+		return;
+	}
 	const int night = night_shift < 0 ? 0 : night_shift;
 	*rg = pow(0.75, night) * ((light_level + 8.0) / 8.0);
 	*b  = pow(0.83, night) * ((light_level + 8.0) / 8.0);
@@ -37,6 +48,9 @@ void stlab_night_multipliers(double *rg, double *b)
 
