+struct pnode_t {
+	uint8  type[4];
+	size_t start;                  ///< first header byte
+	size_t body;                   ///< first body byte
+	size_t body_len;
+	size_t end;                    ///< one past the last byte of the last child
+	std::vector<pnode_t> kids;
+};
+
+
+bool is_type(const pnode_t &n, const char *t)
+{
+	return memcmp(n.type, t, 4) == 0;
