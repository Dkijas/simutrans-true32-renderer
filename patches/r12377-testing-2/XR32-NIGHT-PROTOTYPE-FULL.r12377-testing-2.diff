+	if(  cached < 0  ) {
+		const char *e = getenv("SIMUTRANS_XR32_NIGHTGEN");
+		cached = (e != NULL  &&  e[0] == '1') ? 1 : 0;
+	}
+	return cached == 1;
+}
+
+
+bool stlab_xr32_enabled()
+{
+	static int cached = -1;
+	if(  cached < 0  ) {
+		const char *e = getenv("SIMUTRANS_XR32");
+		cached = (e != NULL  &&  e[0] == '1') ? 1 : 0;
+	}
+	return cached == 1;
+}
