+/* ------------------------------------------------------------------ little-endian readers */
+static inline uint16 rd16(const uint8 *p) { return (uint16)(p[0] | (p[1] << 8)); }
+static inline sint16 rds16(const uint8 *p) { return (sint16)rd16(p); }
+static inline uint32 rd32(const uint8 *p)
+{
+	return (uint32)p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24);
+}
+
+/// unsigned LEB128; returns false on truncation or an over-long encoding
+static bool read_varint(const uint8 *b, uint32 len, uint32 &off, uint32 &out)
+{
+	uint32 shift = 0, val = 0;
+	while(  true  ) {
+		if(  off >= len  ) return false;
+		const uint8 c = b[off++];
+		val |= (uint32)(c & 0x7F) << shift;
+		if(  (c & 0x80) == 0  ) { out = val; return true; }
+		shift += 7;
+		if(  shift > 28  ) return false;
+	}
+}
+
+
+stlab_xr32_status_t stlab_xr32_parse(const uint8 *body, uint32 len, stlab_xr32_image_t *&out,
+                                     const char **why)
+{
+	out = NULL;
+	*why = "";
+	if(  len < XR32_HEADER_LEN  ) { *why = "body shorter than the header"; return STLAB_XR32_REJECTED; }
+	if(  memcmp(body, XR32_MAGIC, 4) != 0  ) { *why = "bad magic"; return STLAB_XR32_REJECTED; }
+
+	const uint8 version = body[4];
+	const uint8 flags = body[5];
+	if(  version > XR32_SUPPORTED_VERSION  ) {
+		*why = "node version is newer than this reader supports";
+		return STLAB_XR32_UNSUPPORTED;   // fall back to IMG, not an error
+	}
+	if(  body[7] != 0  ||  body[17] != 0  ) { *why = "reserved byte not zero"; return STLAB_XR32_REJECTED; }
+	if(  (flags & ~(XR32_FLAG_BASE_DEFLATED | XR32_FLAG_CRC32)) != 0  ) { *why = "unknown flag bit"; return STLAB_XR32_REJECTED; }
+
+	// integrity first: nothing is allocated or inflated before the trailer has been checked
+	if(  flags & XR32_FLAG_CRC32  ) {
+		if(  len < (uint32)XR32_HEADER_LEN + 4  ) { *why = "body too short for its checksum"; return STLAB_XR32_REJECTED; }
+		len -= 4;
+		const uint32 stored = rd32(body + len);
+		const uint32 actual = (uint32)crc32( crc32(0L, Z_NULL, 0), (const Bytef *)body, (uInt)len );
+		if(  stored != actual  ) { *why = "checksum mismatch"; return STLAB_XR32_REJECTED; }
+	}
+	else if(  (flags & XR32_FLAG_BASE_DEFLATED) == 0  ) {
+		// a raw plane carries no check of its own, so without the trailer corruption is invisible
+		*why = "raw plane without checksum"; return STLAB_XR32_REJECTED;
+	}
+
+	const uint16 w = rd16(body + 8);
+	const uint16 h = rd16(body + 10);
+	const sint16 x = rds16(body + 12);
+	const sint16 y = rds16(body + 14);
+	const uint8 zoomable = body[16];
+	const uint16 img_index = rd16(body + 18);
+	const uint32 base_bytes = rd32(body + 20);
+	const uint32 run_count = rd32(body + 24);
+	const uint32 run_bytes = rd32(body + 28);
+
+	if(  w == 0  ||  h == 0  ) { *why = "zero dimension"; return STLAB_XR32_REJECTED; }
+	if(  (uint64)XR32_HEADER_LEN + base_bytes + run_bytes != (uint64)len  ) {
+		*why = "declared lengths do not match the body"; return STLAB_XR32_REJECTED;
+	}
+
+	const uint64 want_plane = (uint64)w * h * 4u;
+	if(  want_plane > 0x40000000ull  ) { *why = "implausible plane size"; return STLAB_XR32_REJECTED; }
+	// nothing is allocated for what the node cannot actually contain
+	if(  (flags & XR32_FLAG_BASE_DEFLATED)  &&  want_plane > (uint64)base_bytes * 1032u + 1024u  ) {
+		*why = "declared plane larger than its compressed stream can expand to"; return STLAB_XR32_REJECTED;
+	}
+	if(  (flags & XR32_FLAG_BASE_DEFLATED) == 0  &&  (uint64)base_bytes != want_plane  ) {
+		*why = "raw base plane has the wrong length"; return STLAB_XR32_REJECTED;
+	}
+	if(  version == 2  &&  body[6] != XR32_V2_CLASS_REGISTRY  ) {
+		*why = "v2 node with an unknown class registry";
+		return STLAB_XR32_UNSUPPORTED;
+	}
+	if(  (uint64)run_count * (version == 2 ? 4u : 5u) > (uint64)run_bytes  ) {
+		*why = "more runs than the run block can hold"; return STLAB_XR32_REJECTED;
+	}
+
+	uint8 *plane = (uint8 *)malloc((size_t)want_plane);
+	if(  plane == NULL  ) { *why = "out of memory for the plane"; return STLAB_XR32_REJECTED; }
+
+	if(  flags & XR32_FLAG_BASE_DEFLATED  ) {
+		uLongf dst = (uLongf)want_plane;
+		const int rc = uncompress((Bytef *)plane, &dst, (const Bytef *)(body + XR32_HEADER_LEN),
+		                          (uLong)base_bytes);
+		if(  rc != Z_OK  ||  (uint64)dst != want_plane  ) {
+			free(plane);
+			*why = "base plane inflate failed";
+			return STLAB_XR32_REJECTED;
+		}
+	}
+	else {
+		memcpy(plane, body + XR32_HEADER_LEN, (size_t)want_plane);   // length checked above
+	}
+
+	stlab_xr32_run_t *runs = NULL;
+	if(  run_count  ) {
+		runs = (stlab_xr32_run_t *)calloc(run_count, sizeof(stlab_xr32_run_t));
+		if(  runs == NULL  ) { free(plane); *why = "out of memory for the runs"; return STLAB_XR32_REJECTED; }
+	}
+
+	const uint8 *blob = body + XR32_HEADER_LEN + base_bytes;
+	uint32 off = 0, kept = 0, skipped = 0, prev_end = 0;
+	const uint32 npx = (uint32)w * h;
+	if(  version == 2  ) {
+		// contributor runs: start is relative to the previous START, runs may overlap.
+		// Per pixel: at most XR32_V2_MAX_CONTRIB contributors, coverage sum <= 255, no id twice.
+		uint16 *sum = (uint16 *)calloc(npx, sizeof(uint16));
+		uint8  *cnt = (uint8 *)calloc(npx, 1);
+		uint32 *ids = (uint32 *)calloc(npx, sizeof(uint32));
+		const char *err = NULL;
+		if(  sum == NULL  ||  cnt == NULL  ||  ids == NULL  ) {
+			err = "out of memory for the run check";
+		}
+		uint32 prev_start = 0;
+		for(  uint32 i = 0;  err == NULL  &&  i < run_count;  i++  ) {
+			uint32 d, ln;
+			if(  !read_varint(blob, run_bytes, off, d)  ||  !read_varint(blob, run_bytes, off, ln)  ) { err = "truncated run"; break; }
+			if(  off + 2 > run_bytes  ) { err = "truncated run payload"; break; }
+			const uint8 id = blob[off++];
+			const uint8 coverage = blob[off++];
+			if(  coverage == 0  ) { err = "coverage 0 is not representable"; break; }
+			if(  ln == 0  ) { err = "run length 0"; break; }
+			if(  d > npx  ||  prev_start > npx - d  ) { err = "run start out of range"; break; }
+			const uint32 start = prev_start + d;
+			if(  start >= npx  ||  ln > npx - start  ) { err = "run end out of range"; break; }
+			prev_start = start;
+			for(  uint32 k = 0;  k < ln;  k++  ) {
+				const uint32 px = start + k;
+				if(  ++cnt[px] > XR32_V2_MAX_CONTRIB  ) { err = "too many contributors on one pixel"; break; }
+				sum[px] += coverage;
+				if(  sum[px] > 255  ) { err = "contributors sum above full coverage"; break; }
+				if(  id < 32  ) {
+					if(  ids[px] & (1u << id)  ) { err = "the same id twice on one pixel"; break; }
+					ids[px] |= 1u << id;
+				}
+			}
+			if(  err  ) break;
+			if(  id >= XR32_V2_ID_COUNT  ) {
+				skipped++;          // forward compatibility: a future id, its share falls to the under plane
+				continue;
+			}
+			stlab_xr32_run_t &r = runs[kept++];
+			r.start = start; r.length = ln; r.coverage = coverage; r.under_is_framebuffer = false;
+			r.cls = id < 8 ? XR32_CLASS_PLAYER_1 : id < 16 ? XR32_CLASS_PLAYER_2 : XR32_CLASS_LIGHT;
+			r.param = id < 16 ? (uint8)(id & 7) : (uint8)(id - 16);
+		}
+		if(  err == NULL  &&  off != run_bytes  ) err = "trailing bytes in the run block";
+		free(sum); free(cnt); free(ids);
+		if(  err  ) { free(plane); free(runs); *why = err; return STLAB_XR32_REJECTED; }
+	}
+	for(  uint32 i = 0;  version != 2  &&  i < run_count;  i++  ) {
+		uint32 d, ln;
+		if(  !read_varint(blob, run_bytes, off, d)  ||  !read_varint(blob, run_bytes, off, ln)  ) {
+			free(plane); free(runs); *why = "truncated run"; return STLAB_XR32_REJECTED;
+		}
+		if(  off + 3 > run_bytes  ) { free(plane); free(runs); *why = "truncated run payload"; return STLAB_XR32_REJECTED; }
+		const uint8 cls = blob[off++];
+		const uint8 param = blob[off++];
+		const uint8 coverage = blob[off++];
+		const bool under_fb = (cls & XR32_UNDER_IS_FRAMEBUFFER) != 0;
+		const uint8 base_cls = cls & 0x7F;
+
+		if(  coverage == 0  ) { free(plane); free(runs); *why = "coverage 0 is not representable"; return STLAB_XR32_REJECTED; }
+		if(  ln == 0  ) { free(plane); free(runs); *why = "run length 0"; return STLAB_XR32_REJECTED; }
+
+		uint8 ur = 0, ug = 0, ub = 0;
+		if(  coverage != 255  &&  !under_fb  ) {
+			if(  off + 3 > run_bytes  ) { free(plane); free(runs); *why = "truncated under-colour"; return STLAB_XR32_REJECTED; }
+			ur = blob[off++]; ug = blob[off++]; ub = blob[off++];
+		}
+
+		// overflow-safe bounds check
+		if(  d > npx  ||  prev_end > npx - d  ) { free(plane); free(runs); *why = "run start out of range"; return STLAB_XR32_REJECTED; }
+		const uint32 start = prev_end + d;
+		if(  ln > npx - start  ) { free(plane); free(runs); *why = "run end out of range"; return STLAB_XR32_REJECTED; }
+		prev_end = start + ln;
+
+		if(  base_cls != XR32_CLASS_PLAYER_1  &&  base_cls != XR32_CLASS_PLAYER_2
+		     &&  base_cls != XR32_CLASS_LIGHT  ) {
+			skipped++;          // forward compatibility: drop the run, keep the node
+			continue;
+		}
+		stlab_xr32_run_t &r = runs[kept++];
+		r.start = start; r.length = ln; r.cls = base_cls; r.param = param;
+		r.coverage = coverage; r.under_is_framebuffer = under_fb;
+		r.under_r = ur; r.under_g = ug; r.under_b = ub;
+	}
+	if(  version != 2  &&  off != run_bytes  ) { free(plane); free(runs); *why = "trailing bytes in the run block"; return STLAB_XR32_REJECTED; }
+
+	stlab_xr32_image_t *img = new stlab_xr32_image_t();
+	img->width = w; img->height = h; img->x = x; img->y = y;
+	img->zoomable = zoomable; img->img_index = img_index; img->version = version;
+	img->rgba = plane; img->runs = runs; img->run_count = kept;
+	img->runs_skipped_unknown_class = skipped;
+	out = img;
+	return STLAB_XR32_OK;
+}
+
+
+/* ------------------------------------------------- XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: XNEX */
+
+static const uint8 XNEX_HEADER_LEN = 24;
+
+stlab_xr32_status_t stlab_xnex_parse(const uint8 *body, uint32 len, stlab_xnex_t *&out, const char **why)
+{
+	out = NULL;
+	*why = "";
+	if(  len < (uint32)XNEX_HEADER_LEN + 4  ) { *why = "night node shorter than its header"; return STLAB_XR32_REJECTED; }
+	if(  memcmp(body, "XNEX", 4) != 0  ) { *why = "night node: bad magic"; return STLAB_XR32_REJECTED; }
+	if(  body[4] != 1  ) { *why = "night node: unknown version"; return STLAB_XR32_UNSUPPORTED; }
+	if(  body[5] != 0x03  ) { *why = "night node: flags must be deflated + CRC-32"; return STLAB_XR32_REJECTED; }
+	if(  body[6] != 0  ) { *why = "night node: unknown transition model"; return STLAB_XR32_UNSUPPORTED; }
+	if(  body[7] != 0  ||  body[18] != 0  ||  body[19] != 0  ) { *why = "night node: reserved byte not zero"; return STLAB_XR32_REJECTED; }
+	// integrity first: nothing is allocated or inflated before the trailer has been checked
+	len -= 4;
+	if(  rd32(body + len) != (uint32)crc32( crc32(0L, Z_NULL, 0), (const Bytef *)body, (uInt)len )  ) {
+		*why = "night node: checksum mismatch"; return STLAB_XR32_REJECTED;
+	}
+	const uint16 w = rd16(body + 8), h = rd16(body + 10);
+	const uint32 plane_bytes = rd32(body + 20);
+	if(  w == 0  ||  h == 0  ) { *why = "night node: zero dimension"; return STLAB_XR32_REJECTED; }
+	if(  (uint64)XNEX_HEADER_LEN + plane_bytes != (uint64)len  ) { *why = "night node: declared length does not match"; return STLAB_XR32_REJECTED; }
+	const uint64 want_plane = (uint64)w * h * 4u;
+	if(  want_plane > 0x40000000ull  ||  want_plane > (uint64)plane_bytes * 1032u + 1024u  ) {
+		*why = "night node: implausible plane size"; return STLAB_XR32_REJECTED;
+	}
+	uint8 *plane = (uint8 *)malloc((size_t)want_plane);
+	if(  plane == NULL  ) { *why = "night node: out of memory"; return STLAB_XR32_REJECTED; }
+	uLongf dst = (uLongf)want_plane;
+	if(  uncompress((Bytef *)plane, &dst, (const Bytef *)(body + XNEX_HEADER_LEN), (uLong)plane_bytes) != Z_OK
+	     ||  (uint64)dst != want_plane  ) {
+		free(plane);
+		*why = "night node: plane inflate failed";
+		return STLAB_XR32_REJECTED;
+	}
+	stlab_xnex_t *n = new stlab_xnex_t();
+	n->width = w; n->height = h; n->x = rds16(body + 12); n->y = rds16(body + 14);
+	n->img_index = rd16(body + 16);
+	n->rgba = plane;
+	out = n;
+	return STLAB_XR32_OK;
+}
+
+
+/* The 'abc' transition of a DAY (D) + NIGHT (N) under colour, per channel, at engine level n:
+ *   a = min(D, floor((D - N) / (1 - m4) + 0.5)) for D > N, else 0   the part that darkens like legacy
+ *   b = D - a                                                       day-only
+ *   c = N - (int)(a * m4)                                           night-only (signed)
+ *   out = (int)(a * m_n) + ((b * (4 - n2) + c * n2) >> 2)           clamped to 0..255
+ * f(0) = D and f(4) = N exactly; an ordinary pixel whose N is the legacy night of D gives the
+ * legacy value at every level, a legacy light (N >= D) gives the legacy light interpolation.
+ * m4 is the legacy multiplier of level 4, same expression as stlab_night_multipliers(). */
+static uint8  stlab_abc_lut4[2][256];      ///< (int)(v * m4): [0] R,G  [1] B
+static uint16 stlab_abc_a[2][256];          ///< a for D - N = 0..255, before the min with D
+static bool   stlab_abc_ready = false;
+
+static void stlab_abc_init()
+{
+	if(  stlab_abc_ready  ) return;
+	const double m4[2] = { pow(0.75, 4) * ((0 + 8.0) / 8.0), pow(0.83, 4) * ((0 + 8.0) / 8.0) };
+	for(  int k = 0;  k < 2;  k++  ) {
+		for(  int v = 0;  v < 256;  v++  ) {
+			stlab_abc_lut4[k][v] = (uint8)(int)(v * m4[k]);
+			const int a = v == 0 ? 0 : (int)floor(v / (1.0 - m4[k]) + 0.5);
+			stlab_abc_a[k][v] = (uint16)(a > 65535 ? 65535 : a);
+		}
+	}
+	stlab_abc_ready = true;
+}
+
+/// one channel; lut = the current level's (int)(v * m_n) table, k = 0 for R/G, 1 for B
+static inline uint8 stlab_abc(uint8 D, uint8 N, int n2, const uint8 *lut, int k)
+{
+	const int a = D > N ? (stlab_abc_a[k][D - N] < D ? stlab_abc_a[k][D - N] : D) : 0;
+	const int b = D - a;
+	const int c = (int)N - (int)stlab_abc_lut4[k][a];
+	const int v = (int)lut[a] + ((b * (4 - n2) + c * n2) >> 2);
+	return (uint8)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+
+uint32 stlab_dn_pixel(const uint8 *p, const uint8 *q, int n2, const uint8 *lut_rg, const uint8 *lut_b)
+{
+	stlab_abc_init();
+	const bool hd = p[3] <= 7  ||  (p[0] == 0xE7 && p[1] == 0xFF && p[2] == 0xFF);
+	const bool hn = q[3] <= 7  ||  (q[0] == 0xE7 && q[1] == 0xFF && q[2] == 0xFF);
+	if(  hd  &&  hn  ) {
+		return 0;
+	}
+	// a hole in one plane only: the colour comes from the other plane, the alpha fades in quarters
+	const uint8 *dc = hd ? q : p, *nc = hn ? p : q;
+	const int ad = hd ? 0 : p[3], an = hn ? 0 : q[3];
+	const int a = (ad * (4 - n2) + an * n2) >> 2;
+	if(  a <= 7  ) {
+		return 0;
+	}
+	return ((uint32)a << 24) | ((uint32)stlab_abc(dc[0], nc[0], n2, lut_rg, 0) << 16)
+	                         | ((uint32)stlab_abc(dc[1], nc[1], n2, lut_rg, 0) << 8)
+	                         | (uint32)stlab_abc(dc[2], nc[2], n2, lut_b, 1);
+}
+
+
+/* ------------------------------------------------------------------ semantic resolution */
+
+/* CANDIDATE C2 -- the night transform of an 8-bit channel has 256 answers.
+ *
+ * Built with the identical expression the pixel loop used, so every byte it
+ * produces is the byte the pixel loop produced. Rebuilt only when the
+ * multipliers actually move, which is on a night step.
+ */
+static double stlab_lut_rgm = -1.0, stlab_lut_bm = -1.0;
+static uint8  stlab_lut_rg[256], stlab_lut_b[256];
+
+
+static void stlab_night_lut(double rgm, double bm)
+{
+	if(  rgm == stlab_lut_rgm  &&  bm == stlab_lut_bm  ) {
+		return;
+	}
+	for(  int v = 0;  v < 256;  v++  ) {
+		int r = (int)(v * rgm);
+		if(  r < 0  ) r = 0;
+		if(  r > 255  ) r = 255;
+		stlab_lut_rg[v] = (uint8)r;
+		int c = (int)(v * bm);
+		if(  c < 0  ) c = 0;
+		if(  c > 255  ) c = 255;
+		stlab_lut_b[v] = (uint8)c;
+	}
+	stlab_lut_rgm = rgm;
+	stlab_lut_bm = bm;
+}
+
+
+void stlab_xr32_resolve(const stlab_xr32_image_t *img, sint8 player_nr, uint32 *out_argb)
+{
+	double rgm = 1.0, bm = 1.0;
+	stlab_night_multipliers(&rgm, &bm);
+
+	// 1. the appearance plane. Night is applied here, in RGB888, ONCE per pixel; there is
+	//    no 555 index and no rgbmap lookup anywhere on this path.
+	const uint32 npx = (uint32)img->width * img->height;
+	stlab_night_lut( rgm, bm );
+	const uint8 *lrg = stlab_lut_rg;
+	const uint8 *lb  = stlab_lut_b;
+	const uint8 *p = img->rgba;
+	if(  img->night != NULL  ) {
+		// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: the under colour comes from DAY + NIGHT through
+		// the 'abc' transition instead of the night LUT. A pixel that is a hole in one plane only
+		// takes its colour from the other plane and fades its alpha in quarters, like a light.
+		const int n2 = stlab_night_level() < 4 ? stlab_night_level() : 4;
+		const uint8 *q = img->night;
+		for(  uint32 i = 0;  i < npx;  i++, p += 4, q += 4  ) {
+			out_argb[i] = stlab_dn_pixel( p, q, n2, lrg, lb );
+		}
+		p = NULL;
+	}
+	for(  uint32 i = 0;  p != NULL  &&  i < npx;  i++, p += 4  ) {
+		const uint8 a = p[3];
+		if(  a <= 7  ||  (p[0] == 0xE7 && p[1] == 0xFF && p[2] == 0xFF)  ) {
+			out_argb[i] = 0;                      // hole
+			continue;
+		}
+		// the straight alpha travels with the colour (0xFF when opaque); night touches the
+		// colour only. The renderer composites 8..254 over the framebuffer.
+		out_argb[i] = ((uint32)a << 24) | ((uint32)lrg[p[0]] << 16)
+		                                | ((uint32)lrg[p[1]] << 8)
+		                                | (uint32)lb[p[2]];
+	}
+
+
+	// 2v2. XR32-SEMANTIC-MASK-PIPELINE-01 -- NOT FOR COMMIT. Explicit contributors, composed
+	//    in LINEAR light over the darkened under plane, integer tables only:
+	//        out = enc( SUM c_i * L(S_i) + (255 - SUM c_i) * L(night(U)) )
+	//    S_i is the live palette colour (player and night already inside it). The work is
+	//    proportional to the contributors, never to the image area: one entry per contributor,
+	//    sorted by pixel, summed per pixel (integer sums, so the order cannot change a byte).
+	if(  img->version == 2  ) {
+		struct contrib_t { uint32 idx, r, g, b, c; };
+		size_t total = 0;
+		for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+			total += img->runs[r].length;
+		}
+		if(  total == 0  ) {
+			return;
+		}
+		std::vector<contrib_t> v;
+		v.reserve(total);
+		for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+			const stlab_xr32_run_t &run = img->runs[r];
+			const uint32 fg = run.cls == XR32_CLASS_LIGHT ? stlab_light_colour_argb(run.param)
+			                                              : stlab_player_colour_argb(player_nr, run.cls, run.param);
+			const uint32 c = run.coverage;
+			contrib_t e;
+			e.r = c * stlab_lin16[(fg >> 16) & 0xFF];
+			e.g = c * stlab_lin16[(fg >> 8) & 0xFF];
+			e.b = c * stlab_lin16[fg & 0xFF];
+			e.c = c;
+			for(  uint32 k = 0;  k < run.length;  k++  ) {
+				e.idx = run.start + k;           // bounds proven by the parser
+				v.push_back(e);
+			}
+		}
+		std::sort(v.begin(), v.end(), [](const contrib_t &a, const contrib_t &b) { return a.idx < b.idx; });
+		for(  size_t i = 0;  i < v.size();  ) {
+			const uint32 idx = v[i].idx;
+			uint32 ar = 0, ag = 0, ab = 0, cs = 0;
+			for(  ;  i < v.size()  &&  v[i].idx == idx;  i++  ) {
+				ar += v[i].r; ag += v[i].g; ab += v[i].b; cs += v[i].c;
+			}
+			const uint32 u = out_argb[idx];       // night(U), already in the raster
+			if(  u == 0  ) {
+				continue;                         // a hole stays a hole
+			}
+			const uint32 rest = 255u - cs;        // cs <= 255, proven by the parser
+			const uint8 r = stlab_lin_encode(ar + rest * stlab_lin16[(u >> 16) & 0xFF]);
+			const uint8 g = stlab_lin_encode(ag + rest * stlab_lin16[(u >> 8) & 0xFF]);
+			const uint8 b = stlab_lin_encode(ab + rest * stlab_lin16[u & 0xFF]);
+			out_argb[idx] = (stlab_pack_argb(r, g, b) & 0x00FFFFFFu) | (u & 0xFF000000u);
+		}
+		return;
+	}
+
+	// 2. the semantic runs, resolved against the live palette. Night is already inside the
+	//    palette entry, so it is applied once here too.
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		const stlab_xr32_run_t &run = img->runs[r];
+		uint32 fg;
+		if(  run.cls == XR32_CLASS_LIGHT  ) {
+			fg = stlab_light_colour_argb(run.param);
+		}
+		else {
+			fg = stlab_player_colour_argb(player_nr, run.cls, run.param);
+		}
+		uint32 value = fg;
+		if(  run.coverage != 255  &&  !run.under_is_framebuffer  ) {
+			// the under-colour is an INTERNAL colour of the sprite: darken it once, in
+			// RGB888, and blend the resolved foreground over it with the 8-bit coverage
+			const int ur = (int)(run.under_r * rgm);
+			const int ug = (int)(run.under_g * rgm);
+			const int ub = (int)(run.under_b * bm);
+			const int a = run.coverage;
+			const int fr = (int)((fg >> 16) & 0xFF);
+			const int fgn = (int)((fg >> 8) & 0xFF);
+			const int fb = (int)(fg & 0xFF);
+			value = stlab_pack_argb((fr * a + ur * (255 - a) + 127) / 255,
+			                        (fgn * a + ug * (255 - a) + 127) / 255,
+			                        (fb * a + ub * (255 - a) + 127) / 255);
+		}
+		for(  uint32 k = 0;  k < run.length;  k++  ) {
+			const uint32 idx = run.start + k;
+			if(  idx < npx  &&  out_argb[idx] != 0  ) {
+				// the record sets the colour, the plane keeps deciding the alpha
+				out_argb[idx] = (value & 0x00FFFFFFu) | (out_argb[idx] & 0xFF000000u);
+			}
+		}
+	}
+}
diff --git a/src/simutrans/display/stlab_xr32.h b/src/simutrans/display/stlab_xr32.h
new file mode 100644
index 0000000000000000000000000000000000000000..a6fc48cedd6911bb1cb1b9a510c97a9efd0290c0
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32.h
@@ -0,0 +1,136 @@
+/*
+ * Consumer of the XR32 image node, format candidate v1.
+ *
+ * XR32 is a candidate 4CC and a candidate v1 layout: the runtime reads it and an
+ * engine that does not know it skips it, but the layout is not a settled ABI and
+ * no compatibility is promised across future revisions of it.
+ *
+ * Layering, deliberately kept separate (the renderer must never learn the format):
+ *
+ *   FORMAT      stlab_xr32_parse()    bytes -> stlab_xr32_image_t
+ *   SEMANTICS   stlab_xr32_resolve()  image + player + night -> ARGB8888 raster
+ *   RENDERER    simgraph32            raster -> its own screen cache -> blit
+ *
+ * Nothing in this file produces or consumes STORED_PIXVAL.
+ */
+#ifndef DISPLAY_STLAB_XR32_H
+#define DISPLAY_STLAB_XR32_H
+
+#include "../simtypes.h"
+#include "simimg.h"
+
+/// one decoded semantic run, in the runtime representation (not the on-disk encoding)
+struct stlab_xr32_run_t {
+	uint32 start;      ///< first pixel index, y*width + x
+	uint32 length;     ///< >= 1
+	uint8  cls;        ///< 1 PLAYER_COLOUR_1, 2 PLAYER_COLOUR_2, 3 LIGHT
+	uint8  param;      ///< player tone 0..7, or light index
+	uint8  coverage;   ///< 1..255
+	bool   under_is_framebuffer;
+	uint8  under_r, under_g, under_b;
+};
+
+/// the runtime representation of one candidate node
+struct stlab_xr32_image_t {
+	uint16 width = 0, height = 0;
+	sint16 x = 0, y = 0;
+	uint8  zoomable = 0;
+	uint16 img_index = 0;
+	uint8  version = 0;
+	uint8  *rgba = NULL;              ///< width*height*4, straight RGBA8888, owned here
+	stlab_xr32_run_t *runs = NULL;    ///< owned here
+	uint32 run_count = 0;
+	uint32 runs_skipped_unknown_class = 0;
+	/// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 (EXPERIMENT): the full-night UNDER plane, same
+	/// geometry as rgba, straight RGBA8888, owned here. NULL = no night image.
+	uint8  *night = NULL;
+
+	~stlab_xr32_image_t();
+};
+
+/* --- XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: EXPERIMENTAL night node "XNEX" (NOT A FORMAT) ---
+ * A sibling of the IMG and its XR32 v2 node; carries the full-night under plane of one image.
+ * Layout (little-endian), all of it experimental and free to change:
+ *   0..3 "XNEX"  4 version=1  5 flags (bit0 deflated, bit1 CRC-32 trailer; both required)
+ *   6 transition model (0 = 'abc')  7 reserved=0  8..9 w  10..11 h  12..13 x  14..15 y
+ *   16..17 img_index  18..19 reserved=0  20..23 plane_bytes   then the plane, then CRC-32. */
+struct stlab_xnex_t {
+	uint16 width = 0, height = 0;
+	sint16 x = 0, y = 0;
+	uint16 img_index = 0;
+	uint8  *rgba = NULL;              ///< width*height*4, owned here until attached
+	~stlab_xnex_t();
+};
+
+/// generate DAY+NIGHT planes for every legacy image at registration (env SIMUTRANS_XR32_NIGHTGEN=1)
+bool stlab_nightgen_enabled();
+
+/**
+ * One DAY+NIGHT pixel at engine level n2 = min(n, 4): the 'abc' transition per channel with
+ * lut_rg / lut_b = the current level's (int)(v * m) tables. p, q = straight RGBA8888 of the
+ * day and night under planes. Returns ARGB (straight alpha) or 0 for "no pixel".
+ */
+uint32 stlab_dn_pixel(const uint8 *p, const uint8 *q, int n2, const uint8 *lut_rg, const uint8 *lut_b);
+
+/// what happened to one candidate node
+enum stlab_xr32_status_t {
+	STLAB_XR32_OK = 0,
+	STLAB_XR32_REJECTED,       ///< structurally invalid -> fall back to IMG
+	STLAB_XR32_UNSUPPORTED     ///< known tag, future version -> fall back to IMG, no error
+};
+
+/// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: parse one XNEX body (layout above); atomic like stlab_xr32_parse
+stlab_xr32_status_t stlab_xnex_parse(const uint8 *body, uint32 len, stlab_xnex_t *&out, const char **why);
+
+/// is the XR32 consumer enabled at all? (env SIMUTRANS_XR32=1)
+bool stlab_xr32_enabled();
+
+/**
+ * Parse one candidate node body. Atomic: on any failure nothing is handed back and the
+ * caller must use the legacy IMG.
+ */
+stlab_xr32_status_t stlab_xr32_parse(const uint8 *body, uint32 len, stlab_xr32_image_t *&out,
+                                     const char **why);
+
+/**
+ * SEMANTIC resolution. Produces width*height ARGB8888 pixels: alpha 0 means "no pixel".
+ * Night is applied exactly once, in RGB888 arithmetic, never through a 555-indexed table.
+ */
+void stlab_xr32_resolve(const stlab_xr32_image_t *img, sint8 player_nr, uint32 *out_argb);
+
+/* --- provided by simgraph32.cc so the semantics can read the live palette state --- */
+uint32 stlab_player_colour_argb(sint8 player_nr, uint8 channel, uint8 tone);
+uint32 stlab_light_colour_argb(uint8 light_index);
+void   stlab_night_multipliers(double *rg, double *b);
+int    stlab_night_level();          ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: the engine level n (>= 0)
+uint32 stlab_pack_argb(int r, int g, int b);
+
+/// hand a parsed node to the renderer, paired with the image id of its sibling IMG
+bool stlab_xr32_attach(image_id id, stlab_xr32_image_t *img,
+                       sint16 img_x, sint16 img_y, sint16 img_w, sint16 img_h, uint8 img_zoomable);
+
+/// does this image carry a candidate node?
+bool stlab_xr32_has(image_id n);
+
+/// XR32-IMAGE-IDENTITY-01: does image @p id carry an authored node (not NIGHTGEN data)?
+bool stlab_xr32_has_authored(image_id id);
+
+/// XR32-IMAGE-IDENTITY-01: would image @p id look exactly like @p day with night plane @p night?
+/// A NULL @p day means "no XR32 data" (NIGHTGEN data counts as none). Compares the whole node.
+bool stlab_xr32_shows(image_id id, const stlab_xr32_image_t *day, const uint8 *night);
+
+/// XR32-FIT-IMG-TO-WIDTH-01: fit_img_to_width() chose the zoom step num/den for image @p id; its screen cache
+/// must come from that step, not from the world zoom. 1/1 (or an image without a node) clears it.
+void stlab_xr32_set_fit(image_id id, sint32 num, sint32 den);
+
+/// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: give image @p id (already carrying a node) its night plane.
+/// Returns NULL on success, otherwise why the night node is not used.
+const char *stlab_xnex_attach(image_id id, stlab_xnex_t *night);
+
+/// replacement producer of the renderer's screen cache; true if it served the image
+bool stlab_xr32_recode(image_id n, sint8 player_nr);
+
+/// drop everything the consumer holds (called at shutdown and when images are freed)
+void stlab_xr32_release_all();
+
+#endif
diff --git a/src/simutrans/display/stlab_xr32_hook.cci b/src/simutrans/display/stlab_xr32_hook.cci
new file mode 100644
index 0000000000000000000000000000000000000000..1e33b1c69c6829f55c85842959ff142a75ed649c
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_hook.cci
@@ -0,0 +1,722 @@
+/* ==========================================================================
+ * XR32 candidate nodes: the renderer-side seam.
+ *
+ * Included at the end of simgraph32.cc so it sees the renderer's own state
+ * (images[], the palette tables, night_shift). It replaces the PRODUCER of
+ * imd32::data[player] for images that carry a candidate node; the CONSUMER
+ * (display_img_aux32 and the blit cores) is untouched and never learns that
+ * XR32 exists.
+ *
+ * The renderer therefore receives ARGB8888 screen runs, exactly as it already
+ * did -- but for these images those runs were never STORED_PIXVAL.
+ * ==========================================================================*/
+
+#include <chrono>
+#include <map>
+
+/* --- what the semantic layer needs from the renderer ------------------------ */
+
+uint32 stlab_pack_argb(int r, int g, int b)
+{
+	if(  r < 0  ) { r = 0; }
+	if(  r > 255  ) { r = 255; }
+	if(  g < 0  ) { g = 0; }
+	if(  g > 255  ) { g = 255; }
+	if(  b < 0  ) { b = 0; }
+	if(  b > 255  ) { b = 255; }
+	return 0xFF000000u | ((uint32)r << 16) | ((uint32)g << 8) | (uint32)b;
+}
+
+
+/* XR32-UI-DAYTIME-01: a draw with daynight=false asks for the day colours (the 16-bit renderer then draws
+ * through rgbmap_all_day / specialcolormap_all_day). While this is set, the semantics resolve an image
+ * against exactly those tables: night level 0 and the multipliers they were built with (1.0, at init).
+ * Per thread, so a display lane never sees another thread's request. */
+static thread_local bool stlab_daytime = false;
+
+
+void stlab_night_multipliers(double *rg, double *b)
+{
+	if(  stlab_daytime  ) {
+		*rg = *b = 1.0;
+		return;
+	}
+	const int night = night_shift < 0 ? 0 : night_shift;
+	*rg = pow(0.75, night) * ((light_level + 8.0) / 8.0);
+	*b  = pow(0.83, night) * ((light_level + 8.0) / 8.0);
+}
+
+
+int stlab_night_level()
+{
+	if(  stlab_daytime  ) {
+		return 0;
+	}
+	return night_shift < 0 ? 0 : night_shift;
+}
+
+
+uint32 stlab_player_colour_argb(sint8 player_nr, uint8 channel, uint8 tone)
+{
+	const sint8 p = (player_nr >= 0 && player_nr < MAX_PLAYER_COUNT) ? player_nr : 0;
+	const uint8 off = player_offsets[p][channel == 2 ? 1 : 0];
+	// specialcolormap_day_night already carries the night multiplier, applied once
+	// when the palette was built. No 555 index is involved.
+	return (stlab_daytime ? specialcolormap_all_day : specialcolormap_day_night)[(int)off + (tone & 7)];
+}
+
+
+uint32 stlab_light_colour_argb(uint8 light_index)
+{
+	if(  light_index >= LIGHT_COUNT  ) {
+		return 0xFF000000u;
+	}
+	return (stlab_daytime ? rgbmap_all_day : rgbmap_day_night)[0x8000 + MAX_PLAYER_COUNT + light_index];
+}
+
+
+/* --- per-image candidate storage -------------------------------------------- */
+
+struct stlab_xr32_zoom_t;                 // the derived per-scale cache
+
+struct stlab_xr32_slot_t {
+	stlab_xr32_zoom_t *zoom = NULL;       ///< native zoom cache, one scale at a time
+	stlab_xr32_image_t *img = NULL;
+	uint8 resolved_player = 0xFF;   ///< which player data[] currently holds
+	int   resolved_night = -999;
+	image_id hires_active = IMG_EMPTY; ///< MRES: the 2x counterpart shown now, if any
+	bool generated = false;          ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: built by NIGHTGEN from a legacy IMG
+	sint32 fit_num = 0, fit_den = 0; ///< XR32-FIT-IMG-TO-WIDTH-01: the step fit_img_to_width() chose (0 = none)
+};
+
+static stlab_xr32_slot_t *stlab_slots = NULL;
+static image_id stlab_slots_alloc = 0;
+
+static void stlab_xr32_base_release();   // XR32-UI-BASE-01: the base-size runs of the interface (end of file)
+
+
+static stlab_xr32_slot_t *stlab_slot(image_id n, bool create)
+{
+	if(  n >= stlab_slots_alloc  ) {
+		if(  !create  ) return NULL;
+		const image_id want = n + 128;
+		stlab_xr32_slot_t *grown = new stlab_xr32_slot_t[want];
+		for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) grown[i] = stlab_slots[i];
+		delete [] stlab_slots;
+		stlab_slots = grown;
+		stlab_slots_alloc = want;
+	}
+	return &stlab_slots[n];
+}
+
+
+bool stlab_xr32_has(image_id n)
+{
+	stlab_xr32_slot_t *s = stlab_slot(n, false);
+	return s != NULL  &&  s->img != NULL;
+}
+
+
+void stlab_xr32_set_fit(image_id id, sint32 num, sint32 den)
+{
+	stlab_xr32_slot_t *s = stlab_slot(id, false);
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return;
+	}
+	// 1/1 is the image itself: no scaled cache, the ordinary path serves it
+	s->fit_num = num == den ? 0 : num;
+	s->fit_den = num == den ? 0 : den;
+}
+
+
+bool stlab_xr32_attach(image_id id, stlab_xr32_image_t *img,
+                       sint16 img_x, sint16 img_y, sint16 img_w, sint16 img_h, uint8 img_zoomable)
+{
+	if(  id >= anz_images  ||  img == NULL  ) {
+		return false;
+	}
+	// geometry guard of FORMAT CANDIDATE v1: a mismatch means the node does not
+	// belong to this image, and the legacy IMG must be used instead.
+	if(  img->width != (uint16)img_w  ||  img->height != (uint16)img_h
+	     ||  img->x != img_x  ||  img->y != img_y  ||  img->zoomable != img_zoomable  ) {
+		return false;
+	}
+	stlab_xr32_slot_t *s = stlab_slot(id, true);
+	if(  s->img != NULL  ) {
+		delete s->img;
+	}
+	s->img = img;
+	s->generated = false;
+	s->resolved_player = 0xFF;
+	s->resolved_night = -999;
+
+	// The image keeps the zoom eligibility registration gave it: a candidate-backed
+	// image now has a native scaled representation, so it takes the ordinary zoom
+	// path and rezoom_img32() routes it to stlab_xr32_zoom_*() instead of to the
+	// STORED16 resampler. FLAG_REZOOM is left set so the first draw builds it.
+	images[id].player_flags = 0xFFFF;
+	// a candidate that carries player runs must route through the player cache
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		if(  img->runs[r].cls == 1  ||  img->runs[r].cls == 2  ) {
+			images[id].recode_flags |= FLAG_HAS_PLAYER_COLOR;
+			break;
+		}
+	}
+	return true;
+}
+
+
+static void stlab_xr32_zoom_release(stlab_xr32_slot_t *s);
+
+
+bool stlab_xr32_has_authored(image_id id)
+{
+	const stlab_xr32_slot_t *s = stlab_slot( id, false );
+	return s != NULL  &&  s->img != NULL  &&  !s->generated;
+}
+
+
+bool stlab_xr32_shows(image_id id, const stlab_xr32_image_t *day, const uint8 *night)
+{
+	const stlab_xr32_slot_t *s = stlab_slot( id, false );
+	const stlab_xr32_image_t *have = (s != NULL  &&  !s->generated) ? s->img : NULL;
+	if(  have == NULL  ||  day == NULL  ) {
+		return have == NULL  &&  day == NULL;
+	}
+	if(  have->width != day->width  ||  have->height != day->height  ||  have->x != day->x  ||  have->y != day->y
+	     ||  have->zoomable != day->zoomable  ||  have->version != day->version  ||  have->run_count != day->run_count  ) {
+		return false;
+	}
+	const size_t bytes = (size_t)day->width * day->height * 4;
+	if(  (have->rgba == NULL) != (day->rgba == NULL)  ||  (day->rgba  &&  memcmp( have->rgba, day->rgba, bytes ) != 0)  ) {
+		return false;
+	}
+	for(  uint32 r = 0;  r < day->run_count;  r++  ) {
+		const stlab_xr32_run_t &a = have->runs[r], &b = day->runs[r];
+		if(  a.start != b.start  ||  a.length != b.length  ||  a.cls != b.cls  ||  a.param != b.param  ||  a.coverage != b.coverage
+		     ||  a.under_is_framebuffer != b.under_is_framebuffer  ||  a.under_r != b.under_r  ||  a.under_g != b.under_g  ||  a.under_b != b.under_b  ) {
+			return false;
+		}
+	}
+	if(  (have->night == NULL) != (night == NULL)  ) {
+		return false;
+	}
+	return night == NULL  ||  memcmp( have->night, night, bytes ) == 0;
+}
+
+/* --- XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 (EXPERIMENT) ----------------------------- */
+
+const char *stlab_xnex_attach(image_id id, stlab_xnex_t *night)
+{
+	stlab_xr32_slot_t *s = stlab_slot(id, false);
+	if(  night == NULL  ||  night->rgba == NULL  ) {
+		return "empty night node";
+	}
+	if(  s == NULL  ||  s->img == NULL  ||  s->generated  ) {
+		return "the image has no XR32 v2 day node";   // a night image needs the image's DAY node
+	}
+	stlab_xr32_image_t *img = s->img;
+	if(  img->version != 2  ) {
+		return "the day node is not XR32 v2";
+	}
+	if(  night->width != img->width  ||  night->height != img->height  ||  night->x != img->x  ||  night->y != img->y  ) {
+		return "its geometry differs from the day node";   // same geometry guard as XR32 itself
+	}
+	if(  img->night != NULL  ) {
+		return "the image already has a night node (duplicate)";   // the first one stays
+	}
+	free( img->night );
+	img->night = night->rgba;
+	night->rgba = NULL;
+	stlab_xr32_zoom_release( s );
+	s->resolved_player = 0xFF;
+	s->resolved_night = -999;
+	images[id].player_flags = 0xFFFF;
+	images[id].recode_flags |= FLAG_REZOOM;
+	return NULL;
+}
+
+
+/**
+ * SIMUTRANS_XR32_NIGHTGEN=1: prissi's "night images generated on load time" for a LEGACY image.
+ * The stored words are decoded once, at registration, into
+ *   DAY plane   ordinary colour = the 555 value expanded exactly as the palette does; a light =
+ *               its day colour; a player pixel = a v2 contributor (coverage 255)
+ *   NIGHT plane ordinary colour = its legacy level-4 colour; a light = its night colour
+ * and the image is then served by the DAY+NIGHT path ('abc' transition). Semi-transparent
+ * pixels keep their class colour and get alpha (a32 * 255 + 16) / 32.
+ */
+static uint32 stlab_nightgen_images = 0;
+static uint64 stlab_nightgen_bytes = 0;
+static uint64 stlab_nightgen_us = 0;     ///< wall time spent generating, microseconds (measurement only)
+
+static void stlab_nightgen_register(image_id id)
+{
+	if(  !stlab_xr32_enabled()  ||  !stlab_nightgen_enabled()  ) {
+		return;
+	}
+	const imd32 &d = images[id];
+	if(  d.base_h <= 0  ||  d.base_w <= 0  ||  d.base_data == NULL  ) {
+		return;
+	}
+	const uint32 w = (uint32)d.base_w, h = (uint32)d.base_h, npx = w * h;
+	const std::chrono::steady_clock::time_point t_start = std::chrono::steady_clock::now();
+	uint8 *day = (uint8 *)calloc( npx, 4 );
+	uint8 *nig = (uint8 *)calloc( npx, 4 );
+	uint8 *pcid = (uint8 *)malloc( npx );
+	if(  day == NULL  ||  nig == NULL  ||  pcid == NULL  ) {
+		free( day ); free( nig ); free( pcid );
+		return;
+	}
+	memset( pcid, 0xFF, npx );
+	const double m4[2] = { pow(0.75, 4) * ((light_level + 8.0) / 8.0), pow(0.83, 4) * ((light_level + 8.0) / 8.0) };
+	uint32 n_pc = 0;
+	const STORED_PIXVAL *sp = d.base_data;
+	for(  uint32 y = 0;  y < h;  y++  ) {
+		uint32 x = 0;
+		uint16 runlen = *sp++;
+		do {
+			x += (runlen & ~TRANSPARENT_RUN);
+			runlen = *sp++;
+			const bool semi = (runlen & TRANSPARENT_RUN) != 0;
+			runlen &= (uint16)~TRANSPARENT_RUN;
+			for(  uint16 k = 0;  k < runlen;  k++  ) {
+				const uint32 px = x + k;
+				const STORED_PIXVAL v = sp[k];
+				if(  px >= w  ) continue;
+				const uint32 i = y * w + px;
+				uint8 *dp = day + i * 4, *np = nig + i * 4;
+				int cls = -1, alpha = 255;             // cls: 0..15 player, 16..30 light, 31+ rgb343, -1 rgb555
+				uint32 val = v;
+				if(  semi  ) {
+					const uint32 aux = (uint32)v - 0x8020u;
+					cls = (int)(aux / 31u);
+					alpha = (int)(((aux % 31u) + 1u) * 255u + 16u) / 32;
+				}
+				else if(  v >= 0x8000  ) {
+					cls = v - 0x8000;
+				}
+				if(  cls < 0  ) {
+					dp[0] = (uint8)((val & 0x7C00) >> 7); dp[1] = (uint8)((val & 0x03E0) >> 2); dp[2] = (uint8)((val & 0x001F) << 3);
+				}
+				else if(  cls < 16  ) {
+					pcid[i] = (uint8)cls;  n_pc++;
+					dp[0] = dp[1] = dp[2] = 0x80;          // never read: coverage 255
+				}
+				else if(  cls < 16 + LIGHT_COUNT  ) {
+					const rgb888_t dl = display_day_lights[cls - 16], nl = display_night_lights[cls - 16];
+					dp[0] = dl.r; dp[1] = dl.g; dp[2] = dl.b;
+					np[0] = nl.r; np[1] = nl.g; np[2] = nl.b;
+				}
+				else {
+					const uint32 c = (uint32)(cls - 31);
+					dp[0] = (uint8)((c & 0x0380) >> 2); dp[1] = (uint8)((c & 0x0078) << 1); dp[2] = (uint8)((c & 0x0007) << 5);
+				}
+				if(  cls < 16  ||  cls >= 16 + LIGHT_COUNT  ) {
+					np[0] = (uint8)(int)(dp[0] * m4[0]); np[1] = (uint8)(int)(dp[1] * m4[0]); np[2] = (uint8)(int)(dp[2] * m4[1]);
+				}
+				dp[3] = np[3] = (uint8)alpha;
+			}
+			x  += runlen;
+			sp += runlen;
+		} while(  (runlen = *sp++)  );
+	}
+	stlab_xr32_image_t *img = new stlab_xr32_image_t();
+	img->width = (uint16)w;  img->height = (uint16)h;
+	img->x = d.base_x;  img->y = d.base_y;
+	img->zoomable = (d.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
+	img->version = 2;
+	img->rgba = day;
+	img->night = nig;
+	// player pixels -> v2 contributor runs (coverage 255), ascending start then id
+	if(  n_pc  ) {
+		img->runs = (stlab_xr32_run_t *)calloc( n_pc, sizeof(stlab_xr32_run_t) );
+		uint32 r = 0;
+		for(  uint32 i = 0;  i < npx;  ) {
+			if(  pcid[i] == 0xFF  ) { i++; continue; }
+			uint32 j = i + 1;
+			while(  j < npx  &&  pcid[j] == pcid[i]  ) j++;
+			stlab_xr32_run_t &run = img->runs[r++];
+			run.start = i;  run.length = j - i;  run.coverage = 255;
+			run.cls = pcid[i] < 8 ? 1 : 2;  run.param = pcid[i] & 7;
+			i = j;
+		}
+		img->run_count = r;
+	}
+	free( pcid );
+	if(  !stlab_xr32_attach( id, img, img->x, img->y, (sint16)w, (sint16)h, img->zoomable )  ) {
+		delete img;
+		return;
+	}
+	stlab_slot( id, false )->generated = true;
+	stlab_nightgen_images++;
+	stlab_nightgen_us += (uint64)std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now() - t_start ).count();
+	stlab_nightgen_bytes += (uint64)npx * 8 + (uint64)img->run_count * sizeof(stlab_xr32_run_t);
+}
+
+
+void stlab_xr32_scratch_release();
+struct stlab_xr32_slot_t;
+
+void simgraph32_alpha_plane_release();
+
+void stlab_xr32_release_all()
+{
+	stlab_xr32_base_release();
+	simgraph32_alpha_plane_release();
+	stlab_xr32_scratch_release();
+	for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) {
+		stlab_xr32_zoom_release( &stlab_slots[i] );
+		delete stlab_slots[i].img;
+		stlab_slots[i].img = NULL;
+	}
+	delete [] stlab_slots;
+	stlab_slots = NULL;
+	stlab_slots_alloc = 0;
+}
