+		// disappears with that option on.
+		//
+		// Done here, before the ground pass, so it cannot erase anything: nothing
+		// has been drawn yet this frame. display_background() itself still returns
+		// without drawing when draw_earth_border and draw_outside_tile are both on,
+		// so neither setting changes appearance.
+		//
+		// outside_visible is set again by the ground pass below whenever any tile
+		// outside the map is on screen, so the cost is paid only while the map edge
+		// is in view and not at all otherwise.
 		display_background(clip_rr.x, clip_rr.y, clip_rr.w, clip_rr.h, force_dirty);
 		welt->unset_background_dirty();
 		// reset
