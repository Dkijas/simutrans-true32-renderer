diff --git a/src/simutrans/display/stlab_xr32_load.cci b/src/simutrans/display/stlab_xr32_load.cci
new file mode 100644
index 0000000000000000000000000000000000000000..555e034c992823092c72ccc649651dafd05719f9
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_load.cci
@@ -0,0 +1,249 @@
+/* ==========================================================================
+ * XR32 candidate nodes: the loader seam.
+ *
+ * Included by pakset_manager.cc. Turns the "Skipping unknown XR32-node" branch
+ * into a parse, and pairs the parsed nodes with their sibling IMG once the
+ * parent's children have all been read.
+ *
+ * The association is the one FORMAT CANDIDATE v1 specifies: the explicit
+ * img_index, checked against the geometry guard. Nothing here depends on the
+ * candidate nodes being in any particular position beyond being children of
+ * the same parent, which is what the placement invariant already guarantees.
+ * ==========================================================================*/
+
+#include <map>
+#include <vector>
+#include "../descriptor/image.h"
+#include "../display/stlab_xr32.h"
+
+static std::vector<stlab_xr32_image_t *> stlab_pending_candidates;
+static std::vector<stlab_xnex_t *> stlab_pending_nights;   ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01
+
+
+/// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: read one experimental night node; true if consumed
+static bool stlab_xnex_read_candidate(FILE *fp, uint32 size)
+{
+	uint8 *buf = (uint8 *)malloc(size ? size : 1);
+	if(  buf == NULL  ) {
+		return false;
+	}
+	if(  size != 0  &&  fread(buf, size, 1, fp) != 1  ) {
+		free(buf);
+		return false;
+	}
+	stlab_xnex_t *n = NULL;
+	const char *why = "";
+	const stlab_xr32_status_t st = stlab_xnex_parse(buf, size, n, &why);
+	free(buf);
+	if(  st == STLAB_XR32_OK  ) {
+		stlab_pending_nights.push_back(n);
+	}
+	else {
+		dbg->warning("stlab_xr32", "night node ignored, the image keeps its day appearance: %s", why);
+	}
+	return true;
+}
+
+
+/// read and parse one candidate node body; true if the body was consumed from the stream
+static bool stlab_xr32_read_candidate(FILE *fp, uint32 size)
+{
+	uint8 *buf = (uint8 *)malloc(size ? size : 1);
+	if(  buf == NULL  ) {
+		return false;
+	}
+	if(  size != 0  &&  fread(buf, size, 1, fp) != 1  ) {
+		free(buf);
+		return false;                      // let the caller fall back to the plain skip
+	}
+	stlab_xr32_image_t *img = NULL;
+	const char *why = "";
+	const stlab_xr32_status_t st = stlab_xr32_parse(buf, size, img, &why);
+	free(buf);
+
+	switch(  st  ) {
+		case STLAB_XR32_OK:
+			stlab_pending_candidates.push_back(img);
+			break;
+		case STLAB_XR32_UNSUPPORTED:
+			dbg->warning("stlab_xr32", "candidate node ignored, using the legacy IMG: %s", why);
+			break;
+		default:
+			dbg->warning("stlab_xr32", "candidate node rejected, using the legacy IMG: %s", why);
+			break;
+	}
+	return true;                           // the body was consumed either way
+}
+
+
+/* XR32-IMAGE-IDENTITY-01: image identity.
+ *
+ * The image reader merges images whose 16-bit data is identical: the second one gets the first
+ * one's image_t, and so its image id. XR32 data is paired by image id afterwards, so two image
+ * slots with the same 16-bit picture but different XR32 data (or one with and one without) would
+ * show whichever XR32 data was paired last - an order the directory listing decides.
+ *
+ * So the pairing decides per image slot: a slot that shows the same as the image already shows
+ * (no XR32 data, or byte-identical XR32 data) keeps sharing it; the first slot of an image gives it
+ * its data; any other slot gets a twin - a copy of the 16-bit image with its own id and its own
+ * XR32 data - and twins with identical data are shared in turn. The pak format and the 16-bit
+ * merge are unchanged, and a pakset without XR32 data never makes a twin.
+ */
+static std::vector<uint16> stlab_image_users;                    ///< image slots paired so far, per image id
+static std::multimap<image_id, image_t *> stlab_image_twins;    ///< reader image id -> twins split off it
+static uint32 stlab_identity_shared = 0, stlab_identity_split = 0, stlab_identity_reused = 0;
+
+
+/// the geometry guard of stlab_xr32_attach(), asked before attaching
+static bool stlab_xr32_fits(const stlab_xr32_image_t *img, const image_t *im)
+{
+	return  img->width == (uint16)(sint16)im->w  &&  img->height == (uint16)(sint16)im->h
+	    &&  img->x == (sint16)im->x  &&  img->y == (sint16)im->y  &&  img->zoomable == im->zoomable;
+}
+
+
+/// give image @p id the day node @p day (may be NULL) and the night node @p night (may be NULL); both are consumed
+static void stlab_xr32_attach_pair(image_id id, const image_t *im, stlab_xr32_image_t *day, stlab_xnex_t *night)
+{
+	if(  day  &&  !stlab_xr32_attach( id, day, im->x, im->y, im->w, im->h, im->zoomable )  ) {
+		dbg->warning("stlab_xr32", "candidate node could not be paired with an image, using the legacy IMG");
+		delete day;
+	}
+	if(  night  ) {
+		const char *why = stlab_xnex_attach( id, night );
+		if(  why != NULL  ) {
+			dbg->warning("stlab_xr32", "night node not used (%s), the image keeps its day appearance", why);
+		}
+		delete night;
+	}
+}
+
+
+/// pair every candidate parsed while reading this node's children with its sibling IMG
+static void stlab_xr32_pair_candidates(obj_desc_t **children, int nchildren, const obj_type *kinds)
+{
+	if(  children == NULL  ||  kinds == NULL  ||  nchildren <= 0  ) {
+		for(  size_t i = 0;  i < stlab_pending_candidates.size();  i++  ) {
+			dbg->warning("stlab_xr32", "candidate node could not be paired with an image, using the legacy IMG");
+			delete stlab_pending_candidates[i];
+		}
+		for(  size_t i = 0;  i < stlab_pending_nights.size();  i++  ) {
+			dbg->warning("stlab_xr32", "night node not used (its img_index does not name an image), the image keeps its day appearance");
+			delete stlab_pending_nights[i];
+		}
+		stlab_pending_candidates.clear();
+		stlab_pending_nights.clear();
+		return;
+	}
+
+	// which XR32 data was authored for each image child. Only a child that was READ as an IMG node
+	// is an image: img_index may name any child (a TEXT name, an XREF, a list), and casting that
+	// to image_t is undefined
+	static std::vector<stlab_xr32_image_t *> day;
+	static std::vector<stlab_xnex_t *> night;
+	day.assign( nchildren, NULL );
+	night.assign( nchildren, NULL );
+	for(  size_t c = 0;  c < stlab_pending_candidates.size();  c++  ) {
+		stlab_xr32_image_t *img = stlab_pending_candidates[c];
+		const int k = img->img_index;
+		const image_t *im = (k < nchildren  &&  kinds[k] == obj_image) ? static_cast<const image_t *>(children[k]) : NULL;
+		if(  im == NULL  ||  im->get_id() == IMG_EMPTY  ||  !stlab_xr32_fits( img, im )  ) {
+			dbg->warning("stlab_xr32", "candidate node could not be paired with an image, using the legacy IMG");
+			delete img;
+			continue;
+		}
+		delete day[k];   // a later node for the same image replaces an earlier one, as before
+		day[k] = img;
+	}
+	stlab_pending_candidates.clear();
+
+	// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: a night plane belongs to the v2 day node of its image
+	for(  size_t c = 0;  c < stlab_pending_nights.size();  c++  ) {
+		stlab_xnex_t *n = stlab_pending_nights[c];
+		const int k = n->img_index;
+		const image_t *im = (k < nchildren  &&  kinds[k] == obj_image) ? static_cast<const image_t *>(children[k]) : NULL;
+		const char *why = NULL;
+		if(  im == NULL  ||  im->get_id() == IMG_EMPTY  ) { why = "its img_index does not name an image"; }
+		else if(  n->rgba == NULL  ) { why = "empty night node"; }
+		else if(  day[k] == NULL  ) { why = "the image has no XR32 v2 day node"; }
+		else if(  day[k]->version != 2  ) { why = "the day node is not XR32 v2"; }
+		else if(  n->width != day[k]->width  ||  n->height != day[k]->height  ||  n->x != day[k]->x  ||  n->y != day[k]->y  ) {
+			why = "its geometry differs from the day node";
+		}
+		else if(  night[k] != NULL  ) { why = "the image already has a night node (duplicate)"; }   // the first one stays
+		if(  why != NULL  ) {
+			dbg->warning("stlab_xr32", "night node not used (%s), the image keeps its day appearance", why);
+			delete n;
+			continue;
+		}
+		night[k] = n;
+	}
+	stlab_pending_nights.clear();
+
+	// XR32-IMAGE-IDENTITY-01: every image slot shows its own data
+	for(  int k = 0;  k < nchildren;  k++  ) {
+		if(  kinds[k] != obj_image  ||  children[k] == NULL  ) {
+			continue;
+		}
+		image_t *im = static_cast<image_t *>(children[k]);
+		const image_id id = im->get_id();
+		if(  id == IMG_EMPTY  ) {
+			continue;
+		}
+		const uint8 *night_plane = night[k] ? night[k]->rgba : NULL;
+		if(  id >= stlab_image_users.size()  ) {
+			stlab_image_users.resize( id + 1, 0 );
+		}
+		const bool first = stlab_image_users[id] == 0;
+		if(  stlab_image_users[id] < 0xFFFF  ) {
+			stlab_image_users[id]++;
+		}
+
+		if(  stlab_xr32_shows( id, day[k], night_plane )  ) {
+			// the image already shows exactly this: no XR32 data, or the same XR32 data
+			if(  day[k]  ) {
+				stlab_identity_shared++;
+			}
+			delete day[k];
+			delete night[k];
+			continue;
+		}
+		if(  first  &&  !stlab_xr32_has_authored( id )  ) {
+			// the only slot of this image so far: it gets this slot's data
+			stlab_xr32_attach_pair( id, im, day[k], night[k] );
+			continue;
+		}
+		// another slot already shows this image with other XR32 data, or without: use a twin
+		image_t *twin = NULL;
+		for(  auto t = stlab_image_twins.equal_range( id );  t.first != t.second;  ++t.first  ) {
+			if(  stlab_xr32_shows( t.first->second->get_id(), day[k], night_plane )  ) {
+				twin = t.first->second;
+				break;
+			}
+		}
+		if(  twin  ) {
+			stlab_identity_reused++;
+			delete day[k];
+			delete night[k];
+		}
+		else {
+			twin = image_t::copy_image( *im );
+			twin->register_image();
+			stlab_xr32_attach_pair( twin->get_id(), twin, day[k], night[k] );
+			stlab_image_twins.insert( std::make_pair( id, twin ) );
+			stlab_identity_split++;
+		}
+		children[k] = twin;
+	}
+}
+
+
+/// XR32-IMAGE-IDENTITY-01: after loading: say what the identity pairing did, and drop its tables
+static void stlab_xr32_identity_finish()
+{
+	dbg->message("stlab_xr32", "image identity: %u image slots share an image with identical XR32 data; "
+	             "%u images split off for slots whose XR32 data differs (%u slots reuse one)",
+	             stlab_identity_shared, stlab_identity_split, stlab_identity_reused);
+	std::vector<uint16>().swap( stlab_image_users );
+	stlab_image_twins.clear();
+}
diff --git a/src/simutrans/display/stlab_xr32_zoom.cci b/src/simutrans/display/stlab_xr32_zoom.cci
new file mode 100644
index 0000000000000000000000000000000000000000..c9be43991c0b05c90ee3bb0c467a09e6b053fc7e
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_zoom.cci
@@ -0,0 +1,711 @@
+/* ==========================================================================
+ * Native zoom for candidate-backed images.
+ *
+ * Implements section 39 of the zoom representation design, and nothing else.
+ *
+ * The point of the contract, in one line: a destination pixel must not average
+ * player tones. It keeps one accumulated day-space colour plus a WEIGHT per
+ * distinct semantic key, because the night transform is a per-channel multiply
+ * and the player palette enters the blend linearly. That makes the scaled cache
+ * exact for every player and every night at once, so it survives both and only
+ * a scale change rebuilds it.
+ *
+ *     D(P,N) = night_N(plane) * (255 - SUM cov_k) / 255
+ *            + SUM_k cov_k * C(k, P, N) / 255
+ *
+ * With one key this is byte-for-byte the formula stlab_xr32_resolve() already
+ * uses, which is why the on-disk format does not move: the v1 tuple is the
+ * one-key case of the general form.
+ * ==========================================================================*/
+
+#include <vector>
+#include "stlab_xr32_linear.h"   // XR32-SEMANTIC-MASK-PIPELINE-01: v2 zoom composes in linear light
+
+/// mirrors XR32_CLASS_LIGHT in stlab_xr32.cc, which is private to that unit
+#define STLAB_ZOOM_CLASS_LIGHT (3)
+
+/// How many distinct semantic keys one destination pixel may carry inline.
+///
+/// The design census measured a maximum of 5 over the whole corpus at 0.5x, and
+/// a p95 of 2. Four was not enough: the integer map clamps the last row and
+/// column onto the final destination pixel, so an edge box can hold more source
+/// pixels than num/den suggests, and six pixels in the corpus carried five keys.
+/// Eight leaves headroom over the measured maximum; the overflow path below is
+/// still there, still counted, and must read zero.
+#define STLAB_ZOOM_INLINE_KEYS (8)
+
+/// keys: 1..8 PLAYER_COLOUR_1 tone 0..7, 9..16 PLAYER_COLOUR_2 tone 0..7,
+/// 17..31 LIGHT index 0..14. 0 means "no semantics".
+#define STLAB_ZOOM_KEY_MAX (32)
+
+
+/**
+ * One destination pixel's semantic content.
+ *
+ * COMPACT is n == 1 and is the v1 tuple: a class, a tone and a coverage, with
+ * the under-colour being the plane pixel. RICH is n >= 2. Nothing is truncated:
+ * the inline array holds four and the overflow list takes the rest, which the
+ * corpus says never exceeds five in total.
+ */
+struct stlab_zoom_sem_t {
+	uint32 dest;                              ///< destination pixel index
+	uint8  n;                                 ///< number of distinct keys
+	uint8  key[STLAB_ZOOM_INLINE_KEYS];       ///< ascending, always
+	uint8  cov[STLAB_ZOOM_INLINE_KEYS];       ///< round(255 * weight), same order
+};
+
+
+/// the derived per-scale cache. Runtime only; never serialised.
+struct stlab_xr32_zoom_t {
+	uint16 width = 0, height = 0;
+	sint16 x = 0, y = 0;
+	sint32 num = 1, den = 1;                  ///< the scale this was built for
+	uint8 *rgba = NULL;                       ///< day-space plane, width*height*4
+	stlab_zoom_sem_t *sem = NULL;             ///< ascending by dest
+	uint32 sem_count = 0;
+	uint32 rich_count = 0;                    ///< of those, with two or more keys
+	bool   linear = false;                    ///< XR32 v2: compose in linear light
+	uint8 *night = NULL;                      ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: zoomed night plane
+
+	~stlab_xr32_zoom_t()
+	{
+		free( rgba );
+		free( sem );
+		free( night );
+	}
+};
+
+
+
+
+/* The night transform of an 8-bit channel has 256 answers. Built with the very
+ * same expression the C2 patch certified, in this translation unit because that
+ * table is private to stlab_xr32.cc. Rebuilt only when the multipliers move. */
+static double stlab_zlut_rgm = -1.0, stlab_zlut_bm = -1.0;
+static uint8  stlab_zlut_rg[256], stlab_zlut_b[256];
+
+
+static void stlab_zoom_night_lut(double rgm, double bm)
+{
+	if(  rgm == stlab_zlut_rgm  &&  bm == stlab_zlut_bm  ) {
+		return;
+	}
+	for(  int v = 0;  v < 256;  v++  ) {
+		int r = (int)(v * rgm);
+		if(  r < 0  ) r = 0;
+		if(  r > 255  ) r = 255;
+		stlab_zlut_rg[v] = (uint8)r;
+		int c = (int)(v * bm);
+		if(  c < 0  ) c = 0;
+		if(  c > 255  ) c = 255;
+		stlab_zlut_b[v] = (uint8)c;
+	}
+	stlab_zlut_rgm = rgm;
+	stlab_zlut_bm = bm;
+}
+
+
+static uint8 stlab_zoom_key_of(uint8 cls, uint8 param)
+{
+	if(  cls == STLAB_ZOOM_CLASS_LIGHT  ) {
+		return (uint8)(17 + (param % LIGHT_COUNT));
+	}
+	return (uint8)((cls == 2 ? 9 : 1) + (param & 7));
+}
+
+
+/**
+ * The colour a key resolves to for one player and the current night.
+ *
+ * Both lookups already carry the night: the player entries because the palette
+ * was built with the night multipliers, the light entries because they are the
+ * day/night interpolated table. Neither depends on the pixel, which is the
+ * property the whole representation rests on.
+ */
+static uint32 stlab_zoom_key_colour(uint8 key, sint8 player_nr)
+{
+	if(  key >= 17  ) {
+		return stlab_light_colour_argb( (uint8)(key - 17) );
+	}
+	const uint8 cls = (key >= 9) ? 2 : 1;
+	const uint8 tone = (uint8)((key - (cls == 2 ? 9 : 1)) & 7);
+	return stlab_player_colour_argb( player_nr, cls, tone );
+}
+
+
+/* --- the builder -------------------------------------------------------------- */
+
+/**
+ * Build the scaled cache for one node at one scale.
+ *
+ * XR32-ZOOM-GEOMETRY-01 (A1): the geometry and the sampling grid are those of the legacy resampler
+ * (zoom_core_rezoom in zoom_core.h), so an XR32 image covers the same screen pixels as its 16-bit
+ * picture at every zoom step:
+ *   - an image whose plain scaled size rounds to 0 is not drawn (NULL), as before;
+ *   - the box is the padded one, ceil(w/den)*num by ceil(h/den)*num, its origin trunc(x*num/den);
+ *   - destination column i samples the source columns (i*den + k - x_rem)/num, k = 0..den-1, with
+ *     x_rem = (x*num) % den, in C division as there, and the same for rows; a sample outside the
+ *     image is a hole.
+ * What is done with the den*den samples is XR32's own: their 8-bit colour, alpha and semantics are
+ * accumulated as before, each sample once (a source pixel counts as often as samples land on it).
+ * A destination pixel is drawn when one of its samples is not a hole - the legacy rule - with the
+ * mean alpha of those samples.
+ *
+ * Accumulation is integer throughout, and there is no division until the plane is finalised: the
+ * contract forbids rounding per contributor. Destinations are visited in ascending order, and so are
+ * their keys, so the result does not depend on any allocation or iteration order.
+ */
+
+/// one axis of the sampling grid: for every destination index, the source indices its den samples
+/// land on and how many land on each, ascending; samples outside the image are not listed (holes)
+struct stlab_zoom_axis_t {
+	std::vector<uint32> first;   ///< per destination index, its first entry; first[dn] is the end
+	std::vector<uint32> src;
+	std::vector<uint32> count;
+};
+
+
+static void stlab_zoom_axis(stlab_zoom_axis_t &a, uint32 n, uint32 dn, sint32 num, sint32 den, sint32 rem)
+{
+	a.first.assign( dn + 1, 0 );
+	a.src.clear();
+	a.count.clear();
+	for(  uint32 i = 0;  i < dn;  i++  ) {
+		a.first[i] = (uint32)a.src.size();
+		for(  sint32 k = 0;  k < den;  k++  ) {
+			const sint32 s = ((sint32)i * den + k - rem) / num;   // C division, as zoom_core_rezoom()
+			if(  s < 0  ||  (uint32)s >= n  ) {
+				continue;
+			}
+			if(  a.src.size() > a.first[i]  &&  a.src.back() == (uint32)s  ) {
+				a.count.back()++;
+			}
+			else {
+				a.src.push_back( (uint32)s );
+				a.count.push_back( 1 );
+			}
+		}
+	}
+	a.first[dn] = (uint32)a.src.size();
+}
+
+
+static stlab_xr32_zoom_t *stlab_xr32_zoom_build(const stlab_xr32_image_t *img,
+                                                sint32 num, sint32 den)
+{
+	const uint32 w = img->width, h = img->height;
+	if(  ((sint64)w * num) / den == 0  ||  ((sint64)h * num) / den == 0  ) {
+		return NULL;
+	}
+	const sint32 x_rem = ((sint32)img->x * num) % den;
+	const sint32 y_rem = ((sint32)img->y * num) % den;
+	const uint32 dw = ((w + (uint32)den - 1) / (uint32)den) * (uint32)num;
+	const uint32 dh = ((h + (uint32)den - 1) / (uint32)den) * (uint32)num;
+	const uint32 nd = dw * dh;
+
+	stlab_xr32_zoom_t *z = new stlab_xr32_zoom_t();
+	z->width = (uint16)dw;
+	z->height = (uint16)dh;
+	z->x = (sint16)(((sint32)img->x * num) / den);
+	z->y = (sint16)(((sint32)img->y * num) / den);
+	z->num = num;
+	z->den = den;
+	// XR32-SEMANTIC-MASK-PIPELINE-01 -- NOT FOR COMMIT: v2 sources carry up to four
+	// contributors per pixel and the plane IS the under-colour
+	const bool v2 = img->version == 2;
+	z->linear = v2;
+
+	// numerators over the denominator 255 * samples, so nothing is divided early
+	uint32 *acc_r = MALLOCN( uint32, nd );
+	uint32 *acc_g = MALLOCN( uint32, nd );
+	uint32 *acc_b = MALLOCN( uint32, nd );
+	uint32 *acc_w = MALLOCN( uint32, nd );   ///< non-semantic weight numerator, x255
+	uint32 *opq   = MALLOCN( uint32, nd );   ///< samples on an opaque source pixel
+	uint32 *alp   = MALLOCN( uint32, nd );   ///< sum of their straight alpha
+	MEMZERON( acc_r, nd );  MEMZERON( acc_g, nd );  MEMZERON( acc_b, nd );
+	MEMZERON( acc_w, nd );  MEMZERON( opq, nd );    MEMZERON( alp, nd );
+	// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: the night plane is reduced with the same samples
+	uint32 *nac = NULL;                      ///< r,g,b,w per destination
+	uint32 *nop = NULL, *nal = NULL;
+	if(  img->night  ) {
+		nac = MALLOCN( uint32, (size_t)nd * 4 );  MEMZERON( nac, (size_t)nd * 4 );
+		nop = MALLOCN( uint32, nd );  MEMZERON( nop, nd );
+		nal = MALLOCN( uint32, nd );  MEMZERON( nal, nd );
+	}
+
+	// the semantic key and coverage of every source pixel; records overwrite in
+	// order, exactly as stlab_xr32_resolve() applies them
+	uint8 *skey = MALLOCN( uint8, w * h );
+	uint8 *scov = MALLOCN( uint8, w * h );
+	uint8 *sufb = MALLOCN( uint8, w * h );
+	uint8 *sur  = MALLOCN( uint8, w * h );
+	uint8 *sug  = MALLOCN( uint8, w * h );
+	uint8 *sub  = MALLOCN( uint8, w * h );
+	MEMZERON( skey, w * h );  MEMZERON( scov, w * h );  MEMZERON( sufb, w * h );
+	MEMZERON( sur, w * h );   MEMZERON( sug, w * h );   MEMZERON( sub, w * h );
+	uint8 *v2n = NULL, *v2k = NULL, *v2c = NULL;
+	if(  v2  ) {
+		v2n = MALLOCN( uint8, w * h );
+		v2k = MALLOCN( uint8, w * h * 4 );
+		v2c = MALLOCN( uint8, w * h * 4 );
+		MEMZERON( v2n, w * h );
+		for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+			const stlab_xr32_run_t &run = img->runs[r];
+			const uint8 k = stlab_zoom_key_of( run.cls, run.param );
+			for(  uint32 i = 0;  i < run.length;  i++  ) {
+				const uint32 idx = run.start + i;
+				if(  idx >= w * h  ||  v2n[idx] >= 4  ) {
+					break;                          // the parser forbids both
+				}
+				v2k[idx * 4 + v2n[idx]] = k;
+				v2c[idx * 4 + v2n[idx]] = run.coverage;
+				v2n[idx]++;
+			}
+		}
+	}
+	for(  uint32 r = 0;  !v2  &&  r < img->run_count;  r++  ) {
+		const stlab_xr32_run_t &run = img->runs[r];
+		const uint8 k = stlab_zoom_key_of( run.cls, run.param );
+		for(  uint32 i = 0;  i < run.length;  i++  ) {
+			const uint32 idx = run.start + i;
+			if(  idx >= w * h  ) {
+				break;
+			}
+			skey[idx] = k;
+			scov[idx] = run.coverage;
+			sufb[idx] = run.under_is_framebuffer ? 1 : 0;
+			sur[idx]  = run.under_r;
+			sug[idx]  = run.under_g;
+			sub[idx]  = run.under_b;
+		}
+	}
+
+	// the semantic side: at most one entry per destination, written in ascending order
+	const bool has_sem = img->run_count > 0;
+	if(  has_sem  ) {
+		z->sem = MALLOCN( stlab_zoom_sem_t, nd );
+	}
+	uint32 w_sem = 0;
+
+	stlab_zoom_axis_t ax, ay;
+	stlab_zoom_axis( ax, w, dw, num, den, x_rem );
+	stlab_zoom_axis( ay, h, dh, num, den, y_rem );
+
+	for(  uint32 dy = 0;  dy < dh;  dy++  ) {
+		for(  uint32 dx = 0;  dx < dw;  dx++  ) {
+			const uint32 d = dy * dw + dx;
+			uint32 ka[STLAB_ZOOM_KEY_MAX];
+			bool any_key = false;
+			if(  has_sem  ) {
+				for(  uint32 t = 0;  t < STLAB_ZOOM_KEY_MAX;  t++  ) { ka[t] = 0; }
+			}
+			for(  uint32 ey = ay.first[dy];  ey < ay.first[dy + 1];  ey++  ) {
+				const uint32 sy = ay.src[ey], cy = ay.count[ey];
+				for(  uint32 ex = ax.first[dx];  ex < ax.first[dx + 1];  ex++  ) {
+					const uint32 si = sy * w + ax.src[ex];
+					const uint32 wg = cy * ax.count[ex];     // samples landing on this source pixel
+					const uint8 *p = img->rgba + (size_t)si * 4;
+					const uint8 a = p[3];
+					const bool hole = a <= 7  ||  (p[0] == 0xE7 && p[1] == 0xFF && p[2] == 0xFF);
+					if(  nac  ) {
+						const uint8 *q = img->night + (size_t)si * 4;
+						if(  !(q[3] <= 7  ||  (q[0] == 0xE7 && q[1] == 0xFF && q[2] == 0xFF))  ) {
+							nop[d] += wg;
+							nal[d] += (uint32)q[3] * wg;
+							uint32 wgt = q[3];
+							if(  v2  &&  !hole  &&  v2n[si]  ) {
+								uint32 cs = 0;
+								for(  uint8 j = 0;  j < v2n[si];  j++  ) cs += v2c[si * 4 + j];
+								wgt = cs >= 255 ? 0u : 255u - cs;   // the same share as the day under-colour
+							}
+							nac[(size_t)d * 4 + 0] += (uint32)q[0] * wgt * wg;
+							nac[(size_t)d * 4 + 1] += (uint32)q[1] * wgt * wg;
+							nac[(size_t)d * 4 + 2] += (uint32)q[2] * wgt * wg;
+							nac[(size_t)d * 4 + 3] += wgt * wg;
+						}
+					}
+					if(  hole  ) {
+						continue;                       // a hole contributes nothing
+					}
+					opq[d] += wg;
+					alp[d] += (uint32)a * wg;
+					if(  v2  &&  v2n[si]  ) {
+						// every contributor is a key; the plane pixel is the under-colour of the rest
+						uint32 csum = 0;
+						for(  uint8 j = 0;  j < v2n[si];  j++  ) {
+							ka[v2k[si * 4 + j]] += (uint32)v2c[si * 4 + j] * wg;
+							csum += v2c[si * 4 + j];
+						}
+						any_key = true;
+						const uint32 rest = csum >= 255 ? 0u : 255u - csum;
+						acc_r[d] += (uint32)p[0] * rest * wg;
+						acc_g[d] += (uint32)p[1] * rest * wg;
+						acc_b[d] += (uint32)p[2] * rest * wg;
+						acc_w[d] += rest * wg;
+						continue;
+					}
+					const uint8 k = skey[si];
+					if(  k == 0  ) {
+						// a normal pixel: its colour is weighted by its alpha (straight alpha,
+						// averaged as premultiplied), so a translucent pixel counts for less
+						acc_r[d] += (uint32)p[0] * a * wg;
+						acc_g[d] += (uint32)p[1] * a * wg;
+						acc_b[d] += (uint32)p[2] * a * wg;
+						acc_w[d] += (uint32)a * wg;
+					}
+					else {
+						// a framebuffer-under record is the whole pixel: the shipped
+						// resolve returns fg outright for it, so its weight is 1, not
+						// its coverage, and it leaves nothing for the day-colour term
+						const uint32 cov = sufb[si] ? 255u : scov[si];
+						ka[k] += cov * wg;
+						any_key = true;
+						if(  !sufb[si]  ) {
+							// the under-colour carries the rest of this pixel's weight
+							const uint32 rest = 255u - cov;
+							acc_r[d] += (uint32)sur[si] * rest * wg;
+							acc_g[d] += (uint32)sug[si] * rest * wg;
+							acc_b[d] += (uint32)sub[si] * rest * wg;
+							acc_w[d] += rest * wg;
+						}
+					}
+				}
+			}
+			if(  !any_key  ) {
+				continue;
+			}
+			// normalise over the OPAQUE samples, the same set the plane averages over, so that
+			// (255 - SUM cov) is exactly the plane's share. Dividing by every sample instead
+			// would darken every pixel whose box contains a hole.
+			const uint32 c = opq[d] ? opq[d] : 1;
+			stlab_zoom_sem_t e;
+			e.dest = d;
+			e.n = 0;
+			for(  uint32 k = 1;  k < STLAB_ZOOM_KEY_MAX;  k++  ) {   // ascending by key
+				if(  ka[k] == 0  ) {
+					continue;
+				}
+				// coverage = round(255 * SUM w_i * a_i / 255) with w_i = 1/samples
+				const uint32 cov = (ka[k] + c / 2) / c;
+				if(  cov == 0  ) {
+					continue;                       // rounds away to nothing
+				}
+				if(  e.n < STLAB_ZOOM_INLINE_KEYS  ) {
+					e.key[e.n] = (uint8)k;
+					e.cov[e.n] = (uint8)(cov > 255 ? 255 : cov);
+					e.n++;
+				}
+				else {
+					// never truncate silently: fold the smallest into the largest so
+					// the total semantic weight is preserved
+					uint32 sum = (uint32)e.cov[STLAB_ZOOM_INLINE_KEYS - 1] + cov;
+					e.cov[STLAB_ZOOM_INLINE_KEYS - 1] = (uint8)(sum > 255 ? 255 : sum);
+				}
+			}
+			if(  e.n == 0  ) {
+				continue;
+			}
+			// the coverages are rounded independently, so their sum can land one or
+			// two above full. Trim the largest, lowest key first, so the total is
+			// exactly representable and no contributor is dropped.
+			uint32 tot = 0;
+			for(  uint8 j = 0;  j < e.n;  j++  ) { tot += e.cov[j]; }
+			while(  tot > 255  ) {
+				uint8 big = 0;
+				for(  uint8 j = 1;  j < e.n;  j++  ) {
+					if(  e.cov[j] > e.cov[big]  ) { big = j; }
+				}
+				if(  e.cov[big] == 0  ) { break; }
+				e.cov[big]--;
+				tot--;
+			}
+			z->sem[w_sem++] = e;
+			if(  e.n > 1  ) {
+				z->rich_count++;
+			}
+		}
+	}
+	z->sem_count = w_sem;
+	if(  z->sem != NULL  &&  w_sem == 0  ) {
+		free( z->sem );
+		z->sem = NULL;
+	}
+	else if(  z->sem != NULL  &&  w_sem < nd  ) {
+		stlab_zoom_sem_t *shrunk = (stlab_zoom_sem_t *)realloc( z->sem, w_sem * sizeof(stlab_zoom_sem_t) );
+		if(  shrunk  ) {
+			z->sem = shrunk;
+		}
+	}
+
+	// finalise the plane: one division, half-up; a pixel is drawn when a sample landed on an opaque
+	// source pixel (the legacy rule), with the mean straight alpha of those samples
+	z->rgba = MALLOCN( uint8, (size_t)nd * 4 );
+	for(  uint32 d = 0;  d < nd;  d++  ) {
+		uint8 *o = z->rgba + (size_t)d * 4;
+		const uint32 den_w = acc_w[d];
+		if(  den_w == 0  ) {
+			o[0] = o[1] = o[2] = 0;
+		}
+		else {
+			o[0] = (uint8)((acc_r[d] + den_w / 2) / den_w);
+			o[1] = (uint8)((acc_g[d] + den_w / 2) / den_w);
+			o[2] = (uint8)((acc_b[d] + den_w / 2) / den_w);
+		}
+		o[3] = opq[d] ? (uint8)((alp[d] + opq[d] / 2) / opq[d]) : 0;
+	}
+
+	if(  nac  ) {
+		z->night = MALLOCN( uint8, (size_t)nd * 4 );
+		for(  uint32 d = 0;  d < nd;  d++  ) {
+			uint8 *o = z->night + (size_t)d * 4;
+			const uint32 den_w = nac[(size_t)d * 4 + 3];
+			for(  int ch = 0;  ch < 3;  ch++  ) {
+				o[ch] = den_w ? (uint8)((nac[(size_t)d * 4 + ch] + den_w / 2) / den_w) : 0;
+			}
+			o[3] = nop[d] ? (uint8)((nal[d] + nop[d] / 2) / nop[d]) : 0;
+		}
+		free( nac );  free( nop );  free( nal );
+	}
+
+	free( acc_r );  free( acc_g );  free( acc_b );  free( acc_w );
+	free( opq );    free( alp );
+	free( skey );   free( scov );   free( sufb );
+	free( sur );    free( sug );    free( sub );
+	free( v2n );    free( v2k );    free( v2c );
+	return z;
+}
+
+
+static void stlab_xr32_zoom_release(stlab_xr32_slot_t *s)
+{
+	if(  s == NULL  ||  s->zoom == NULL  ) {
+		return;
+	}
+	delete s->zoom;
+	s->zoom = NULL;
+}
+
+
+/**
+ * Make sure the slot carries a cache for the current scale, and only for it.
+ *
+ * One scale at a time, exactly the lifetime zoom_data already has. A player or
+ * a night change never reaches here, which is the whole point of the design.
+ */
+static bool stlab_xr32_zoom_ensure(image_id, stlab_xr32_slot_t *s)
+{
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	// XR32-FIT-IMG-TO-WIDTH-01: a fitted image is scaled by the step fit_img_to_width() chose, not the world's
+	const sint32 num = s->fit_num ? s->fit_num : g_simgraph32.zoom_num[zoom_factor32];
+	const sint32 den = s->fit_num ? s->fit_den : g_simgraph32.zoom_den[zoom_factor32];
+	if(  s->zoom != NULL  &&  s->zoom->num == num  &&  s->zoom->den == den  ) {
+		return true;
+	}
+	if(  s->zoom != NULL  ) {
+		stlab_xr32_zoom_release( s );
+	}
+	s->zoom = stlab_xr32_zoom_build( s->img, num, den );
+	return s->zoom != NULL;
+}
+
+
+
+/**
+ * What rezoom_img32() needs from the native path: make the derived cache current,
+ * publish its geometry, and drop every player cache so the producer rebuilds them.
+ *
+ * Mirrors the legacy branch's bookkeeping exactly - same flags, same frees - so
+ * the surrounding renderer cannot tell which representation served the scale.
+ */
+static bool stlab_xr32_zoom_prepare(image_id n)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	// XR32-NONZOOMABLE-01 (N5): an image that is not zoomable keeps its base geometry at every world zoom, exactly
+	// as the legacy branch of rezoom_img32() does; only a fit step (fit_img_to_width) scales it
+	if(  (zoom_factor32 == ZOOM_NEUTRAL  ||  (images[n].recode_flags & FLAG_ZOOMABLE) == 0)  &&  s->fit_num == 0  ) {
+		// back at neutral the scaled cache is dead weight and the base geometry rules
+		stlab_xr32_zoom_release( s );
+		images[n].x   = images[n].base_x;
+		images[n].y   = images[n].base_y;
+		images[n].w   = images[n].base_w;
+		images[n].h   = images[n].base_h;
+		images[n].player_flags = 0xFFFF;
+		for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+			if(  images[n].data[i] != NULL  ) {
+				free( images[n].data[i] );
+				images[n].data[i] = NULL;
+			}
+		}
+		images[n].recode_flags &= ~FLAG_REZOOM;
+		return true;
+	}
+	if(  !stlab_xr32_zoom_ensure( n, s )  ) {
+		// the image degenerates at this scale (its width or height scales to 0): the
+		// legacy resampler then sets h = 0 and the image is not drawn. Do the same,
+		// with the same scaled x/y/w; the base geometry would draw it unscaled, at
+		// its 1:1 size and offsets, in a zoomed-out world.
+		const sint32 num = s->fit_num ? s->fit_num : g_simgraph32.zoom_num[zoom_factor32];
+		const sint32 den = s->fit_num ? s->fit_den : g_simgraph32.zoom_den[zoom_factor32];
+		images[n].x   = (sint16)((images[n].base_x * num) / den);
+		images[n].y   = (sint16)((images[n].base_y * num) / den);
+		images[n].w   = (sint16)((images[n].base_w * num) / den);
+		images[n].h   = 0;
+		images[n].player_flags = 0xFFFF;
+		for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+			if(  images[n].data[i] != NULL  ) {
+				free( images[n].data[i] );
+				images[n].data[i] = NULL;
+			}
+		}
+		images[n].recode_flags &= ~FLAG_REZOOM;
+		return true;                          // handled: nothing to draw at this scale
+	}
+	images[n].player_flags = 0xFFFF;
+	for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+		if(  images[n].data[i] != NULL  ) {
+			free( images[n].data[i] );
+			images[n].data[i] = NULL;
+		}
+	}
+	images[n].x = s->zoom->x;
+	images[n].y = s->zoom->y;
+	images[n].w = (sint16)s->zoom->width;
+	images[n].h = (sint16)s->zoom->height;
+	images[n].recode_flags &= ~FLAG_REZOOM;
+	return true;
+}
+
+
+/* --- the resolver ------------------------------------------------------------- */
+
+/**
+ * Resolve one scaled image into the screen run stream, for one player.
+ *
+ * Identical in shape to stlab_xr32_recode(): the only difference is where the
+ * pixels and the semantics come from. Rounding happens once, here, half-up.
+ */
+static bool stlab_xr32_zoom_resolve(const stlab_xr32_zoom_t *z, sint8 player_nr,
+                                    uint32 *out_argb)
+{
+	double rgm = 1.0, bm = 1.0;
+	stlab_night_multipliers( &rgm, &bm );
+	stlab_zoom_night_lut( rgm, bm );
+	const uint8 *lrg = stlab_zlut_rg;
+	const uint8 *lb  = stlab_zlut_b;
+
+	const uint32 npx = (uint32)z->width * z->height;
+	if(  z->night  ) {
+		// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: the scaled DAY and NIGHT planes, 'abc' transition
+		const int lv = stlab_night_level();
+		const int n2 = lv < 4 ? lv : 4;
+		for(  uint32 i = 0;  i < npx;  i++  ) {
+			out_argb[i] = stlab_dn_pixel( z->rgba + (size_t)i * 4, z->night + (size_t)i * 4, n2, lrg, lb );
+		}
+	}
+	for(  uint32 i = 0;  z->night == NULL  &&  i < npx;  i++  ) {
+		const uint8 *p = z->rgba + (size_t)i * 4;
+		if(  p[3] <= 7  ) {
+			out_argb[i] = 0;                    // the box was (almost) all holes
+			continue;
+		}
+		// the box's straight alpha travels with the colour; night touches the colour only
+		out_argb[i] = ((uint32)p[3] << 24) | ((uint32)lrg[p[0]] << 16)
+		                                   | ((uint32)lrg[p[1]] << 8)
+		                                   | (uint32)lb[p[2]];
+	}
+
+	// the semantic contributions, in ascending destination order
+	for(  uint32 e = 0;  e < z->sem_count;  e++  ) {
+		const stlab_zoom_sem_t &s = z->sem[e];
+		if(  s.dest >= npx  ||  out_argb[s.dest] == 0  ) {
+			continue;
+		}
+		// the under colour at this night, as the loop above left it (identical to lrg/lb of the
+		// day plane when there is no night plane); its alpha is the pixel's
+		const uint32 u = out_argb[s.dest];
+		const int base_r = (int)((u >> 16) & 0xFF), base_g = (int)((u >> 8) & 0xFF), base_b = (int)(u & 0xFF);
+		int tot = 0, ar = 0, ag = 0, ab = 0;
+		for(  uint8 j = 0;  j < s.n;  j++  ) {
+			const uint32 c = stlab_zoom_key_colour( s.key[j], player_nr );
+			const int cov = s.cov[j];
+			tot += cov;
+			ar += (int)((c >> 16) & 0xFF) * cov;
+			ag += (int)((c >> 8) & 0xFF) * cov;
+			ab += (int)(c & 0xFF) * cov;
+		}
+		if(  tot > 255  ) {
+			tot = 255;                          // the box cannot be more than full
+		}
+		const int rest = 255 - tot;
+		if(  z->linear  ) {
+			// XR32 v2: the same weights, composed in linear light (stlab_xr32_linear.h)
+			uint32 lr = (uint32)rest * stlab_lin16[base_r];
+			uint32 lg = (uint32)rest * stlab_lin16[base_g];
+			uint32 lbb = (uint32)rest * stlab_lin16[base_b];
+			for(  uint8 j = 0;  j < s.n;  j++  ) {
+				const uint32 c = stlab_zoom_key_colour( s.key[j], player_nr );
+				lr += (uint32)s.cov[j] * stlab_lin16[(c >> 16) & 0xFF];
+				lg += (uint32)s.cov[j] * stlab_lin16[(c >> 8) & 0xFF];
+				lbb += (uint32)s.cov[j] * stlab_lin16[c & 0xFF];
+			}
+			out_argb[s.dest] = (stlab_pack_argb( stlab_lin_encode( lr ), stlab_lin_encode( lg ),
+			                                     stlab_lin_encode( lbb ) ) & 0x00FFFFFFu)
+			                   | (u & 0xFF000000u);
+			continue;
+		}
+		out_argb[s.dest] = (stlab_pack_argb( (ar + base_r * rest + 127) / 255,
+		                                     (ag + base_g * rest + 127) / 255,
+		                                     (ab + base_b * rest + 127) / 255 ) & 0x00FFFFFFu)
+		                   | (u & 0xFF000000u);       // semantics set the colour, the plane the alpha
+	}
+	return true;
+}
+
+
+/**
+ * The native zoom entry point: produce data[player] for a candidate-backed image
+ * at the current scale, without ever touching base_data or the legacy path.
+ */
+static bool stlab_xr32_zoom_recode(image_id n, sint8 player_nr)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	if(  !stlab_xr32_zoom_ensure( n, s )  ) {
+		return false;
+	}
+	const stlab_xr32_zoom_t *z = s->zoom;
+	const uint32 w = z->width, h = z->height, npx = w * h;
+
+	if(  !stlab_scratch_reserve( npx, stlab_xr32_encode_cap( w, h ) )  ) {
+		return false;
+	}
+	uint32 *raster = stlab_scratch_raster;
+	stlab_xr32_zoom_resolve( z, player_nr, raster );
+
+	PIXVAL *out = stlab_scratch_out;
+	PIXVAL *d = stlab_xr32_encode_rows( raster, w, h, out );
+
+	imd32 &im = images[n];
+	const size_t used = (size_t)(d - out);
+	if(  im.data[player_nr] != NULL  ) {
+		free( im.data[player_nr] );
+	}
+	PIXVAL *cache = MALLOCN( PIXVAL, used );
+	memcpy( cache, out, used * sizeof(PIXVAL) );
+	im.data[player_nr] = cache;
+	im.len = (uint32)used;
+	im.w = (sint16)w;
+	im.h = (sint16)h;
+	im.x = z->x;
+	im.y = z->y;
+	s->resolved_player = (uint8)player_nr;
+	s->resolved_night = night_shift;
+	return true;
+}
diff --git a/src/simutrans/display/zoom_core.h b/src/simutrans/display/zoom_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..caa7c7c33463d9d69bed082e4af343fe40df9100
--- /dev/null
+++ b/src/simutrans/display/zoom_core.h
@@ -0,0 +1,604 @@
+/*
+ * This file is part of the Simutrans project under the Artistic License.
+ * (see LICENSE.txt)
+ */
+
+#ifndef DISPLAY_ZOOM_CORE_H
+#define DISPLAY_ZOOM_CORE_H
+
+
+/*
+ * Renderer-independent image resampling.
+ *
+ * Zooming a Simutrans image is a STORED16 -> STORED16 operation: unpack the run
+ * stream to four bytes per pixel, resample, re-encode. It never touches a
+ * screen pixel, a palette or a blend, so it lives here once and both renderers
+ * use it. The algorithm is the historical one, moved unchanged.
+ *
+ * The one thing that is NOT unchanged is how the flat intermediate buffer says
+ * "nothing here". The legacy renderer writes the COLOUR value 0x73FE, which is
+ * the ordinary RGB555 colour (28,31,30) - so an opaque image pixel of exactly
+ * that colour is indistinguishable from transparency and silently disappears
+ * when the image is zoomed. That is measured, not suspected.
+ *
+ * The marker is therefore a policy:
+ *
+ *   zoom_sample_inband_t   the historical representation, value == 0x73FE.
+ *                          The 16 bit renderer keeps it, byte for byte, so its
+ *                          output does not move.
+ *   zoom_sample_tagged_t   value plus an explicit clear bit beside it. No
+ *                          colour can be mistaken for state. The 32 bit
+ *                          renderer uses this one.
+ *
+ * This header knows STORED_PIXVAL, which is storage. It does not know PIXVAL,
+ * palettes, alpha or framebuffers.
+ */
+
+#include <cstring>
+#include <cstdlib>
+
+#include "../simtypes.h"
+#include "../simcolor.h"     // STORED_PIXVAL
+#include "../simmem.h"
+
+
+/// the historical in-band marker: a colour value doubles as "no pixel"
+struct zoom_sample_inband_t {
+	typedef STORED_PIXVAL value_t;
+
+	static inline value_t       clear()                  { return (value_t)0x73FE; }
+	static inline bool          is_clear(value_t v)      { return v == (value_t)0x73FE; }
+	static inline value_t       make(STORED_PIXVAL c)    { return c; }
+	static inline STORED_PIXVAL colour(value_t v)        { return v; }
+};
+
+
+/// value and state side by side: no colour is ever read as "no pixel"
+struct zoom_sample_tagged_t {
+	typedef uint32 value_t;
+
+	static const uint32 CLEAR_BIT = 0x10000u;
+
+	static inline value_t       clear()                  { return CLEAR_BIT; }
+	static inline bool          is_clear(value_t v)      { return (v & CLEAR_BIT) != 0; }
+	static inline value_t       make(STORED_PIXVAL c)    { return (value_t)c; }
+	static inline STORED_PIXVAL colour(value_t v)        { return (STORED_PIXVAL)(v & 0xFFFFu); }
+};
+
+
+/// scratch buffers, owned by the caller so per-thread arrangements stay there
+struct zoom_scratch_t {
+	uint8  *unpack;    ///< four bytes per pixel, then the re-encoded output
+	void   *resample;  ///< one Sample::value_t per pixel
+	size_t  size;      ///< bytes allocated for `unpack`
+};
+
+
+/// result of one resample
+struct zoom_image_t {
+	sint16         x, y, w, h;
+	uint32         len;
+	STORED_PIXVAL *data;
+};
+
+
+#define SumSubpixel(p) \
+	if(*(p)<255  &&  valid<255) { \
+	if(*(p)==1) { valid = 255; r = g = b = 0; } else { valid ++; } /* mark special colors */\
+		r += (p)[1]; \
+		g += (p)[2]; \
+		b += (p)[3]; \
+	}
+
+
+/// recode 4 bytes into one STORED_PIXVAL
+static inline STORED_PIXVAL compress_pixel(uint8* p)
+{
+	return (((p[0]==1 ? 0x8000 : 0 ) | p[1]) + (((uint16)p[2])<<5) + (((uint16)p[3])<<10));
+}
+
+/// recode 4 bytes, respecting transparency
+template<class Sample>
+static inline typename Sample::value_t compress_pixel_transparent(uint8 *p)
+{
+	return p[0]==255 ? Sample::clear() : Sample::make(compress_pixel(p));
+}
+
+// zoom-in pixel taking color of above/below and transparency of diagonal neighbor into account
+template<class Sample>
+static inline typename Sample::value_t zoomin_pixel(uint8 *p, uint8* pab, uint8 *prl, uint8* pdia)
+{
+	if (p[0] == 255) {
+		if ( (pab[0] | prl[0] | pdia[0])==255) {
+			return Sample::clear(); // pixel and one neighbor transparent -> return transparent
+		}
+		// pixel transparent but all three neighbors not -> interpolate
+		uint8 valid=0;
+		uint8 r=0, g=0, b=0;
+		SumSubpixel(pab);
+		SumSubpixel(prl);
+		if(valid==0) {
+			return Sample::clear();
+		}
+		else if(valid==255) {
+			return Sample::make((STORED_PIXVAL)((0x8000 | r) + (((uint16)g)<<5) + (((uint16)b)<<10)));
+		}
+		else {
+			return Sample::make((STORED_PIXVAL)((r/valid) + (((uint16)(g/valid))<<5) + (((uint16)(b/valid))<<10)));
+		}
+	}
+	else {
+		if ( (pab[0] & prl[0] & pdia[0])!=255) {
+			// pixel and one neighbor not transparent
+			return Sample::make(compress_pixel(p));
+		}
+		return Sample::clear();
+	}
+}
+
+
+/**
+ * Convert base image data to actual image size
+ * Uses averages of all sampled points to get the "real" value
+ * Blurs a bit
+ */
+
+
+/**
+ * Convert base image data to actual image size.
+ *
+ * Uses averages of all sampled points to get the "real" value. Blurs a bit.
+ * The caller owns @p scratch and the buffer returned in @p out.data.
+ */
+template<class Sample>
+static void zoom_core_rezoom(const STORED_PIXVAL *base_data,
+                             const sint16 base_x, const sint16 base_y,
+                             const sint16 base_w, const sint16 base_h,
+                             const sint32 zoom_num, const sint32 zoom_den,
+                             zoom_scratch_t &scratch,
+                             zoom_image_t &out)
+{
+	typedef typename Sample::value_t sample_t;
+	// NOT taken once at entry: the scratch buffers may be reallocated below
+	sample_t *resample = (sample_t *)scratch.resample;
+
+// now we want to downsize the image
+// just divide the sizes
+out.x = (base_x * zoom_num) / zoom_den;
+out.y = (base_y * zoom_num) / zoom_den;
+out.w = (base_w * zoom_num) / zoom_den;
+out.h = (base_h * zoom_num) / zoom_den;
+
+if(  out.h > 0  &&  out.w > 0  ) {
+	// just recalculate the image in the new size
+	const STORED_PIXVAL *src = base_data;
+	sample_t *dest = NULL;
+	// embed the baseimage in an image with margin ~ remainder
+	const sint16 x_rem = (base_x * zoom_num) % zoom_den;
+	const sint16 y_rem = (base_y * zoom_num) % zoom_den;
+	const sint16 xl_margin = max( x_rem, 0);
+	const sint16 xr_margin = max(-x_rem, 0);
+	const sint16 yl_margin = max( y_rem, 0);
+	const sint16 yr_margin = max(-y_rem, 0);
+	// baseimage top-left  corner is at (xl_margin, yl_margin)
+	// ...       low-right corner is at (xr_margin, yr_margin)
+
+	sint32 orgzoomwidth = ((base_w + zoom_den - 1 ) / zoom_den) * zoom_den;
+	sint32 newzoomwidth = (orgzoomwidth*zoom_num)/zoom_den;
+	sint32 orgzoomheight = ((base_h + zoom_den - 1 ) / zoom_den) * zoom_den;
+	sint32 newzoomheight = (orgzoomheight * zoom_num) / zoom_den;
+
+	// we will unpack, re-sample, pack it
+
+	// thus the unpack buffer must at least fit the window => find out maximum size
+	// Note: This value is certainly way bigger than the average size we'll get,
+	// but it's the worst scenario possible, a succession of solid - transparent - solid - transparent
+	// pattern.
+	// This would encode EACH LINE as:
+	// 0x0000 (0 transparent) 0x0001 PIXWORD 0x0001 (every 2 pixels, 3 words) 0x0000 (EOL)
+	// The extra +1 is to make sure we cover divisions with module != 0
+	// We end with an over sized buffer for the normal usage, but since it's re-used for all re-zooms,
+	// it's not performance critical and we are safe from all possible inputs.
+
+	size_t new_size = ( ( (newzoomwidth * 3) / 2 ) + 1 + 2) * newzoomheight * sizeof(STORED_PIXVAL);
+	size_t unpack_size = (xl_margin + orgzoomwidth + xr_margin) * (yl_margin + orgzoomheight + yr_margin) * 4;
+	if(  unpack_size > new_size  ) {
+		new_size = unpack_size;
+	}
+	new_size = ((new_size * 128) + 127) / 128; // enlarge slightly to try and keep buffers on their own cacheline for multithreaded access. A portable aligned_alloc would be better.
+	if(  scratch.size < new_size  ) {
+		free( scratch.resample );
+		free( scratch.unpack );
+		scratch.size = new_size;
+		scratch.unpack   = MALLOCN( uint8, new_size );
+		scratch.resample = MALLOCN( uint8, new_size * (sizeof(sample_t) / sizeof(STORED_PIXVAL)) );
+	}
+	resample = (sample_t *)scratch.resample;
+	memset( scratch.unpack, 255, new_size ); // fill with invalid data to mark transparent regions
+
+	// index of top-left corner
+	uint32 baseoff = 4 * (yl_margin * (xl_margin + orgzoomwidth + xr_margin) + xl_margin);
+	sint32 basewidth = xl_margin + orgzoomwidth + xr_margin;
+
+	// now: unpack the image
+	for(  sint32 y = 0;  y < base_h;  ++y  ) {
+		uint16 runlen;
+		uint8 *p = scratch.unpack + baseoff + y * (basewidth * 4);
+
+		// decode line
+		runlen = *src++;
+		do {
+			// clear run
+			p += (runlen & ~TRANSPARENT_RUN) * 4;
+			// color pixel
+			runlen = (*src++) & ~TRANSPARENT_RUN;
+			while(  runlen--  ) {
+				// get rgb components
+				STORED_PIXVAL s = *src++;
+				*p++ = (s>>15);
+				*p++ = (s & 31);
+				s >>= 5;
+				*p++ = (s & 31);
+				s >>= 5;
+				*p++ = (s & 31);
+			}
+			runlen = *src++;
+		} while(  runlen != 0  );
+	}
+
+	// now we have the image, we do a repack then
+	dest = resample;
+	switch(  zoom_den  ) {
+		case 1: {
+			assert(zoom_num==2);
+
+			// first half row - just copy values, do not fiddle with neighbor colors
+			uint8 *p1 = scratch.unpack + baseoff;
+			for(  sint16 x = 0;  x < orgzoomwidth;  x++  ) {
+				sample_t c1 = compress_pixel_transparent<Sample>( p1 + (x * 4) );
+				// now set the pixel ...
+				dest[x * 2] = c1;
+				dest[x * 2 + 1] = c1;
+			}
+			// skip one line
+			dest += newzoomwidth;
+
+			for(  sint16 y = 0;  y < orgzoomheight - 1;  y++  ) {
+				uint8 *p1 = scratch.unpack + baseoff + y * (basewidth * 4);
+				// copy leftmost pixels
+				dest[0] = compress_pixel_transparent<Sample>( p1 );
+				dest[newzoomwidth] = compress_pixel_transparent<Sample>( p1 + basewidth * 4 );
+				for(  sint16 x = 0;  x < orgzoomwidth - 1;  x++  ) {
+					uint8 *px1 = p1 + (x * 4);
+					// pixel at 2,2 in 2x2 superpixel
+					dest[x * 2 + 1] = zoomin_pixel<Sample>( px1, px1 + 4, px1 + basewidth * 4, px1 + basewidth * 4 + 4 );
+
+					// 2x2 superpixel is transparent but original pixel was not
+					// preserve one pixel
+					if(  Sample::is_clear(dest[x * 2 + 1])  &&  px1[0] != 255  &&  Sample::is_clear(dest[x * 2])  &&  Sample::is_clear(dest[x * 2 - newzoomwidth])  &&  Sample::is_clear(dest[x * 2 - newzoomwidth - 1])  ) {
+						// preserve one pixel
+						dest[x * 2 + 1] = Sample::make(compress_pixel( px1 ));
+					}
+
+					// pixel at 2,1 in next 2x2 superpixel
+					dest[x * 2 + 2] = zoomin_pixel<Sample>( px1 + 4, px1, px1 + basewidth * 4 + 4, px1 + basewidth * 4 );
+
+					// pixel at 1,2 in next row 2x2 superpixel
