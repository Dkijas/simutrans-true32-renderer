+
+/** The base image composited through a separate alpha image. */
+static void simgraph32_draw_base_img_alpha(const image_id n, const image_id alpha_n, const unsigned alpha_flags, scr_coord_val xp, scr_coord_val yp, const sint8 player_nr, const FLAGGED_PIXVAL color_index, const bool daynight, bool dirty  CLIP_NUM_DEF)
+{
+	if(  g_simgraph32.tile_raster_width == g_simgraph32.base_tile_raster_width  ) {
+		// same size => use the standard routine, as the 16 bit renderer and
+		// simgraph32_draw_base_img already do
+		simgraph32_draw_rezoomed_img_alpha( n, alpha_n, alpha_flags, xp, yp, player_nr, color_index, daynight, dirty  CLIP_NUM_PAR );
+		return;
+	}
+	if(  n >= anz_images  ||  alpha_n >= anz_images  ) {
+		return;
+	}
+	activate_player_color32( (player_nr >= 0 && player_nr < MAX_PLAYER_COUNT) ? player_nr : 0, daynight );
+
+	const STORED_PIXVAL *sp = images[n].base_data;
+
+	xp += images[n].base_x;
+	yp += images[n].base_y;
+	scr_coord_val h = images[n].base_h;
+	const scr_coord_val yp_full = yp;
+	if(  !clip_rows32( sp, yp, h   CLIP_NUM_PAR)  ) {
+		return;
+	}
+
+	if(  dirty  ) {
+		simgraph32_mark_rect_dirty_wc( xp, yp, xp + images[n].base_w - 1, yp + h - 1 );
+	}
+
+	// this family draws the UNZOOMED image, so the mask is wanted unzoomed too:
+	// its own base stream, at its own base geometry, sampled to the image's
+	const uint8 *bplane = build_alpha_plane_from( images[alpha_n].base_data,
+	                                              images[alpha_n].base_w, images[alpha_n].base_h,
+	                                              images[n].base_w, images[n].base_h,
+	                                              get_alpha_mask32( alpha_flags )  CLIP_NUM_PAR );
+	if(  bplane == NULL  ) {
+		return;
+	}
+	PixelOps32Alpha<STORED_PIXVAL, true> ops;
+	ops.plane      = bplane;
+	ops.dest_base  = textur + (size_t)yp * disp_width + xp;
+	ops.plane_w    = images[n].base_w;
+	ops.pitch      = disp_width;
+	ops.row_offset = yp - yp_full;
+	display_img_blend_wc32( h, xp, yp, sp, ops   CLIP_NUM_PAR);
+}
