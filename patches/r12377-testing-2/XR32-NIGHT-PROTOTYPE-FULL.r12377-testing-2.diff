+/*
+ * Replace the framebuffer pointer (simgraph_t::set_texture_ptr, r12371).
+ * Same contract as simgraph16_set_texture_ptr(): the new buffer must have
+ * exactly the size, the pitch (disp_width pixels) and the pixel format
+ * (ARGB8888) of the old one. The interface carries no pitch, so the caller
+ * has to check that before calling. At r12377 the only caller is
+ * dr_flush_new() in simsys_s2.cc, which nothing calls.
+ */
+static void simgraph32_set_texture_ptr(void *new_texture)
+{
+	if(  new_texture == NULL  ) {
+		dbg->fatal( "simgraph32_set_texture_ptr", "NULL framebuffer" );
+	}
+	if(  textur == NULL  ) {
+		// "same size as the old one" needs an old one
+		dbg->fatal( "simgraph32_set_texture_ptr", "called before the display was initialised" );
+	}
+	assert( (reinterpret_cast<uintptr_t>(new_texture) % sizeof(PIXVAL)) == 0 );
+	textur = (PIXVAL *)new_texture;
+}
