+
+/// STLAB_NIGHT_UNMIX=ratio selects the first prototype's ratio unmix (kept for the measured comparison)
+static bool stlab_night_unmix_ratio()
+{
+	const char *e = getenv("STLAB_NIGHT_UNMIX");
+	return e != NULL  &&  strcmp(e, "ratio") == 0;
+}
+
+/* local night key: per player shade id 0..15, the linear night colour of every pixel it covers FULLY
+ * (coverage 255, the only contributor), so a partly covered pixel can read the artist's own night colour
+ * of that shade from its neighbourhood. Integer throughout (sums of stlab_lin16 values). */
+static const int STLAB_LOCAL_KEY_RADIUS = 4;
+static int lk_w = 0, lk_h = 0;
+static std::vector<sint32> lk_full[16];          ///< per id: -1 or the pixel's own night colour packed
+static const uint8 *lk_night = NULL;
+static uint64 lk_global_sum[16][3];
+static uint32 lk_global_n[16];
+
+static void stlab_night_local_key_setup(const uint8 *night_rgba, int w, int h, const std::vector<stlab_sem_contrib_t> &contribs)
+{
+	lk_w = w; lk_h = h; lk_night = night_rgba;
+	std::vector<uint8> count((size_t)w * h, 0);
+	for(  size_t i = 0;  i < contribs.size();  i++  ) count[contribs[i].position]++;
+	for(  int k = 0;  k < 16;  k++  ) {
+		lk_full[k].assign((size_t)w * h, 0);
+		lk_global_sum[k][0] = lk_global_sum[k][1] = lk_global_sum[k][2] = 0;
+		lk_global_n[k] = 0;
+	}
+	for(  size_t i = 0;  i < contribs.size();  i++  ) {
+		const stlab_sem_contrib_t &c = contribs[i];
+		if(  c.id >= 16  ||  c.coverage != 255  ||  count[c.position] != 1  ) continue;
+		const uint8 *q = night_rgba + (size_t)c.position * 4;
+		if(  q[3] <= 7  ) continue;
+		lk_full[c.id][c.position] = 1;
+		for(  int ch = 0;  ch < 3;  ch++  ) lk_global_sum[c.id][ch] += stlab_lin16[q[ch]];
+		lk_global_n[c.id]++;
+	}
+}
+
+/// the night colour (linear, 0..65535 per channel) of shade @p id near (x, y); false if the shade has no full pixel
+static bool stlab_night_local_key(uint8 id, int x, int y, uint32 out[3])
+{
+	if(  id >= 16  ||  lk_global_n[id] == 0  ) return false;
+	uint64 s[3] = { 0, 0, 0 };
+	uint32 n = 0;
+	for(  int dy = -STLAB_LOCAL_KEY_RADIUS;  dy <= STLAB_LOCAL_KEY_RADIUS;  dy++  ) {
+		const int yy = y + dy;
+		if(  yy < 0  ||  yy >= lk_h  ) continue;
+		for(  int dx = -STLAB_LOCAL_KEY_RADIUS;  dx <= STLAB_LOCAL_KEY_RADIUS;  dx++  ) {
+			const int xx = x + dx;
+			if(  xx < 0  ||  xx >= lk_w  ||  !lk_full[id][(size_t)yy * lk_w + xx]  ) continue;
+			const uint8 *q = lk_night + ((size_t)yy * lk_w + xx) * 4;
+			for(  int ch = 0;  ch < 3;  ch++  ) s[ch] += stlab_lin16[q[ch]];
+			n++;
+		}
+	}
+	if(  n == 0  ) {                       // nothing near: the shade's mean over the sheet
+		for(  int ch = 0;  ch < 3;  ch++  ) s[ch] = lk_global_sum[id][ch];
+		n = lk_global_n[id];
+	}
+	for(  int ch = 0;  ch < 3;  ch++  ) out[ch] = (uint32)((s[ch] + n / 2) / n);
+	return true;
+}
+
+
+void stlab_night_under(const std::string &sheet_png, const uint8 *day_rgba, const uint8 *night_rgba, int w, int h,
+                       const std::vector<uint8> &day_under, const std::vector<stlab_sem_contrib_t> &contribs,
+                       std::vector<uint8> &night_under)
+{
+	night_under.assign(night_rgba, night_rgba + (size_t)w * h * 4);
+	std::vector<uint16> csum((size_t)w * h, 0);
+	// first contributor of every pixel (contribs are sorted by position then id)
+	std::vector<size_t> pix_first((size_t)w * h, contribs.size());
+	for(  size_t i = contribs.size();  i-- > 0;  ) pix_first[contribs[i].position] = i;
+	// where each player shade covers a pixel FULLY: the night colour the artist gave that shade
+	stlab_night_local_key_setup(night_rgba, w, h, contribs);
+	for(  size_t i = 0;  i < contribs.size();  i++  ) {
+		if(  contribs[i].id >= 16  ) {
+			const int x = (int)(contribs[i].position % (uint32)w), y = (int)(contribs[i].position / (uint32)w);
+			dbg->fatal("stlab_night", "'%s' (%d,%d): a light mask (%s) and a night image on the same sheet would "
+			           "light the pixel twice; paint the light into the night image instead",
+			           sheet_png.c_str(), x, y, stlab_sem_vocab[contribs[i].id].name);
+		}
+		csum[contribs[i].position] += contribs[i].coverage;
+	}
+	for(  size_t i = 0;  i < (size_t)w * h;  i++  ) {
+		const uint8 *dp = day_rgba + i * 4, *np = night_rgba + i * 4;
+		const bool day_hole = dp[3] <= 7  ||  (((uint32)dp[0] << 16 | (uint32)dp[1] << 8 | dp[2]) == SPECIAL_TRANSPARENT);
+		const bool night_hole = np[3] <= 7  ||  (((uint32)np[0] << 16 | (uint32)np[1] << 8 | np[2]) == SPECIAL_TRANSPARENT);
+		if(  day_hole  &&  !night_hole  ) stlab_night_counters.night_only_pixels++;
+		if(  !day_hole  &&  night_hole  ) {
+			// the object vanishes at night here: almost always a night image that does not line up with the day
+			if(  stlab_night_counters.day_only_pixels++ < 4  ) {
+				dbg->warning("stlab_night", "'%s' (%d,%d) is drawn by day but transparent in the night image: is the "
+				             "night image shifted or cropped?", sheet_png.c_str(), (int)(i % (size_t)w), (int)(i / (size_t)w));
+			}
+		}
+		if(  day_hole  ||  night_hole  ||  csum[i] == 0  ||  csum[i] >= 255  ) {
+			continue;                      // no player colour to take out, or nothing left under it
+		}
+		uint8 *o = &night_under[i * 4];
+		const uint8 *ud = &day_under[i * 4];
+		// LOCAL KEY (default): what the artist painted for this player shade AT NIGHT, read from the
+		// nearest pixels the shade covers fully, is taken out algebraically - exactly as the day solver
+		// takes out the day key. Falls back to the ratio method when the shade has no full pixel at all.
+		bool solved = false;
+		if(  !stlab_night_unmix_ratio()  ) {
+			uint32 kn[STLAB_SEM_MAX_CONTRIB][3];
+			uint8 cv[STLAB_SEM_MAX_CONTRIB];
+			int nk = 0;
+			bool ok = true;
+			for(  size_t c = pix_first[i];  c < contribs.size()  &&  contribs[c].position == i  &&  nk < STLAB_SEM_MAX_CONTRIB;  c++  ) {
+				ok = ok  &&  stlab_night_local_key(contribs[c].id, (int)(i % (size_t)w), (int)(i / (size_t)w), kn[nk]);
+				cv[nk++] = contribs[c].coverage;
+			}
+			if(  ok  &&  nk  ) {
+				const sint64 den = 255 - (sint64)csum[i];
+				for(  int ch = 0;  ch < 3;  ch++  ) {
+					sint64 num = 255 * (sint64)stlab_lin16[np[ch]];
+					for(  int j = 0;  j < nk;  j++  ) num -= (sint64)cv[j] * kn[j][ch];
+					sint64 acc = num <= 0 ? 0 : (num * 255 + den / 2) / den;
+					if(  acc > 65535 * 255  ) acc = 65535 * 255;
+					o[ch] = stlab_lin_encode((uint32)acc);
+				}
+				solved = true;
+				stlab_night_counters.local_key_pixels++;
+			}
+		}
+		for(  int ch = 0;  !solved  &&  ch < 3;  ch++  ) {
+			const uint32 ld = stlab_lin16[dp[ch]];
+			if(  ld == 0  ) continue;      // no day light to take a ratio from: keep the night pixel
+			uint64 acc = (uint64)stlab_lin16[np[ch]] * stlab_lin16[ud[ch]] * 255u / ld;
+			if(  acc > 65535u * 255u  ) acc = 65535u * 255u;
+			o[ch] = stlab_lin_encode((uint32)acc);
+		}
+		if(  !solved  ) stlab_night_counters.ratio_pixels++;
+		if(  o[0] == 0xE7  &&  o[1] == 0xFF  &&  o[2] == 0xFF  ) o[2] = 0xFE;
+	}
+}
+
+
+void stlab_semantic_masks_report()
+{
+	const stlab_sem_counters_t &c = stlab_sem_counters;
+	if(  c.sheets_opted_in == 0  &&  stlab_night_counters.sheets_with_night == 0  ) {
+		return;
+	}
+	printf("semantic masks: sheets opted-in %u, with masks %u, masks %u, contributors %u, multi %u, "
+	       "undeclared keys %u, dropped-on-holes %u, trimmed %u, mismatch %u (max %u), key-nudged %u, unknown names %u, v2 nodes %u\n",
+	       c.sheets_opted_in, c.sheets_with_masks, c.masks_loaded, c.contributors, c.multi_pixels,
+	       c.undeclared_key_pixels, c.dropped_on_holes, c.trimmed_pixels, c.mismatch_pixels, c.mismatch_max,
+	       c.key_nudged, c.unknown_mask_names, c.v2_nodes);
+	const stlab_night_counters_t &n = stlab_night_counters;
+	printf("night images: sheets %u, nodes %u, night-only px %u, day-only px %u, boxes grown %u, pc-image px %u, unmix local-key %u ratio %u\n",
+	       n.sheets_with_night, n.nodes, n.night_only_pixels, n.day_only_pixels, n.bbox_grown, n.pc_image_pixels, n.local_key_pixels, n.ratio_pixels);
+}
diff --git a/src/simutrans/descriptor/writer/stlab_semantic_masks.h b/src/simutrans/descriptor/writer/stlab_semantic_masks.h
new file mode 100644
index 0000000000000000000000000000000000000000..12b2c1ada0017f5b309eb7e20da8fad9a82b7451
--- /dev/null
+++ b/src/simutrans/descriptor/writer/stlab_semantic_masks.h
@@ -0,0 +1,127 @@
+/*
+ * XR32-SEMANTIC-MASK-PIPELINE-01 -- explicit semantic masks for makeobj.
+ *
+ * NOT FOR COMMIT. Laboratory only.
+ *
+ * makeobj does NOT guess semantics from the final RGB. The artist (or the exporter) supplies,
+ * beside an ordinary image sheet X.png, one 8-bit coverage mask per semantic id:
+ *
+ *     X.png                 the conventional base image, exactly as today
+ *     X.sem.<name>.png      coverage of semantic <name>, 0..255, same size as X.png
+ *
+ * and opts in per object with the dat key   semantic_masks=1
+ *
+ * makeobj only VALIDATES and PACKAGES: it solves the under-colour algebraically from the
+ * base pixel, the known coverages and the known authoring colours, checks that recomposing
+ * gives the base pixel back, and hands the per-pixel contributors to the XR32 v2 serializer.
+ * The legacy IMG is built from X.png exactly as before: masks never change it.
+ *
+ * Semantic meaning, once an object opts in, comes from the masks alone: an exact special
+ * colour in X.png that no mask declares is ordinary paint in the XR32 node (and warned
+ * about); only the legacy IMG, which cannot say otherwise, still treats it as special.
+ */
+#ifndef DESCRIPTOR_WRITER_STLAB_SEMANTIC_MASKS_H
+#define DESCRIPTOR_WRITER_STLAB_SEMANTIC_MASKS_H
+
+#include <string>
+#include <vector>
+#include "../../simtypes.h"
+
+/// the stable semantic vocabulary of XR32 v2 (class registry 2): id == makeobj special index
+#define STLAB_SEM_ID_COUNT (31)
+/// at most this many semantics may share one pixel (the parser enforces the same number)
+#define STLAB_SEM_MAX_CONTRIB (4)
+
+struct stlab_sem_vocab_t {
+	uint8 id;
+	const char *name;      ///< the file-name token, lower case, stable
+	                       ///< (the authoring colour is image_t::rgbtab[id], not repeated here)
+};
+extern const stlab_sem_vocab_t stlab_sem_vocab[STLAB_SEM_ID_COUNT];
+
+/// one contributor of one pixel: the format's own record (stlab_xr32_writer.h)
+#include "stlab_xr32_writer.h"
+
+struct stlab_sem_counters_t {
+	uint32 sheets_opted_in = 0;
+	uint32 sheets_with_masks = 0;
+	uint32 masks_loaded = 0;
+	uint32 contributors = 0;
+	uint32 multi_pixels = 0;          ///< pixels with two or more contributors
+	uint32 undeclared_key_pixels = 0; ///< exact key colour without a mask: ordinary in XR32 (warned)
+	uint32 dropped_on_holes = 0;      ///< mask coverage on a transparent pixel, ignored
+	uint32 trimmed_pixels = 0;        ///< independently rounded masks summing 256..258, trimmed
+	uint32 mismatch_pixels = 0;       ///< recomposition differs from the base by more than 2
+	uint32 mismatch_max = 0;
+	uint32 key_nudged = 0;            ///< an under-colour that came out as the transparency key
+	uint32 unknown_mask_names = 0;    ///< X.sem.<name>.png whose name is not in the vocabulary
+	uint32 v2_nodes = 0;
+};
+extern stlab_sem_counters_t stlab_sem_counters;
+
+/// per-object opt-in, set by obj_writer_t::write() from the dat key semantic_masks
+void stlab_semantic_masks_set_requested(bool on);
+bool stlab_semantic_masks_requested();
+
+/**
+ * Load, validate and solve the masks of one sheet.
+ *
+ * @param sheet_png  the base sheet's path, ending in ".png"
+ * @param rgba       the base sheet, w*h*4 straight RGBA (255 == opaque)
+ * @param under      receives the under plane (w*h*4) when masks were found
+ * @param contribs   receives every contributor, sorted by position then id
+ * @return true if at least one mask exists for this sheet (the caller then writes v2)
+ *
+ * Structural errors (wrong size, more than STLAB_SEM_MAX_CONTRIB semantics or a coverage sum
+ * above 255 on one pixel) are fatal: the object opted in, so producing a pak without the
+ * semantics it asked for would hide the error.
+ */
+bool stlab_semantic_masks_solve(const std::string &sheet_png, const uint8 *rgba, int w, int h,
+                                std::vector<uint8> &under, std::vector<stlab_sem_contrib_t> &contribs);
+
+/// print the counters (makeobj verbose / STLAB_SEM_REPORT)
+void stlab_semantic_masks_report();
+
+
+/* --- XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 (EXPERIMENT, NOT A FORMAT) -------------------------
+ *
+ *   X.night.png   the full-night appearance of the sheet X.png, same size and layout; used when
+ *                 the object opts in with   night_images=1   (no special night colours needed)
+ *   X.pc1.png     prissi's single player-colour image for channel 1 (X.pc2.png: channel 2):
+ *                 grey = WHICH shade (code_k = round(255 * (0.15 + k * 0.65 / 7)), k = 0..7,
+ *                 decoded to the nearest code, +-11 levels), alpha = HOW MUCH (coverage).
+ *                 Compiles to exactly the contributors the 8 masks X.sem.pcN-k.png would give.
+ */
+void stlab_night_images_set_requested(bool on);
+bool stlab_night_images_requested();
+
+/// the straight RGBA8888 night sheet of @p sheet_png, or NULL if X.night.png does not exist.
+/// Cached per sheet. A night sheet of another size is fatal.
+const uint8 *stlab_night_sheet(const std::string &sheet_png, int w, int h);
+
+/// warn (once per sheet) when X.night.png exists but the object did not opt in with night_images=1
+void stlab_night_unrequested_check(const std::string &sheet_png);
+
+/**
+ * The night UNDER plane of one sheet: where a pixel carries player-colour contributors the night
+ * image is unmixed with the day's own ratio, L(Un) = L(N) * L(Ud) / L(D) per channel (the night
+ * lighting is taken as uniform inside one pixel); elsewhere it is the night pixel itself.
+ * Light contributors together with a night image are fatal (the light would be applied twice).
+ */
+void stlab_night_under(const std::string &sheet_png, const uint8 *day_rgba, const uint8 *night_rgba, int w, int h,
+                       const std::vector<uint8> &day_under, const std::vector<stlab_sem_contrib_t> &contribs,
+                       std::vector<uint8> &night_under);
+
+struct stlab_night_counters_t {
+	uint32 sheets_with_night = 0;
+	uint32 nodes = 0;
+	uint32 night_only_pixels = 0;     ///< opaque at night, transparent by day (glow)
+	uint32 day_only_pixels = 0;       ///< opaque by day, transparent at night
+	uint32 bbox_grown = 0;            ///< tiles whose IMG box grew to hold night-only pixels
+	uint32 pc_image_pixels = 0;       ///< contributors that came from X.pc1/X.pc2.png
+	uint32 local_key_pixels = 0;      ///< night under-colours unmixed with the local night key
+	uint32 ratio_pixels = 0;          ///< ... with the day ratio (fallback, or STLAB_NIGHT_UNMIX=ratio)
+};
+extern stlab_night_counters_t stlab_night_counters;
+
+#endif
diff --git a/src/simutrans/descriptor/writer/stlab_xr32_writer.cc b/src/simutrans/descriptor/writer/stlab_xr32_writer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..5a2160906f456303702ca24a8d39dbd35d73652a
--- /dev/null
+++ b/src/simutrans/descriptor/writer/stlab_xr32_writer.cc
@@ -0,0 +1,341 @@
+/*
+ * STLAB-RGBA32-END-TO-END-MAKEOBJ-RUNTIME-01 -- FORMAT CANDIDATE v1 serializer.
+ * NOT FOR COMMIT. Laboratory only.
+ *
+ * Layout, from RGBA32-NODE-V1-CANDIDATE.md, little-endian throughout:
+ *
+ *   0..3   magic "XR32"
+ *   4      version                       = 1
+ *   5      flags                         bit0 = base plane deflated
+ *   6      class_registry                = 1
+ *   7      reserved                      = 0
+ *   8..9   width          uint16
+ *   10..11 height         uint16
+ *   12..13 x              sint16
+ *   14..15 y              sint16
+ *   16     zoomable       uint8
+ *   17     reserved                      = 0
+ *   18..19 img_index      uint16
+ *   20..23 base_bytes     uint32         the plane as stored, compressed or not
+ *   24..27 run_count      uint32
+ *   28..31 run_bytes      uint32
+ *
+ * then the base plane, then the run block. One run is
+ *
+ *   varint(start - previous_end), varint(length), class, parameter, coverage
+ *   [, under R, G, B  when coverage != 255 and the UNDER_IS_FRAMEBUFFER bit is clear]
+ */
+#include "stlab_xr32_writer.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <zlib.h>
+
+#include "obj_node.h"
+#include "../../simdebug.h"
+
+stlab_xr32_writer_t stlab_xr32_writer_t::the_instance;
+stlab_xnex_writer_t stlab_xnex_writer_t::the_instance;
+
+static const uint8 XR32_VERSION        = 1;
+static const uint8 XR32_CLASS_REGISTRY = 1;
+static const uint8 XR32_HEADER_LEN     = 32;
+static const uint8 XR32_FLAG_BASE_DEFLATED = 0x01;
+static const uint8 XR32_FLAG_CRC32 = 0x02;
+static const uint8 XR32_UNDER_IS_FRAMEBUFFER = 0x80;
+
+
+bool stlab_xr32_deflate_enabled()
+{
+	static int cached = -1;
+	if(  cached < 0  ) {
+		const char *e = getenv("STLAB_XR32_DEFLATE");
+		cached = (e != NULL  &&  e[0] == '0') ? 0 : 1;   // default: compress
+	}
+	return cached == 1;
+}
+
+
+std::vector<stlab_pending_node_t> &stlab_pending_nodes()
+{
+	static std::vector<stlab_pending_node_t> pending;
+	return pending;
+}
+
+
+static void put16(std::vector<uint8> &b, size_t at, uint16 v)
+{
+	b[at] = (uint8)(v & 0xFF);
+	b[at + 1] = (uint8)(v >> 8);
+}
+
+
+static void put32(std::vector<uint8> &b, size_t at, uint32 v)
+{
+	b[at] = (uint8)(v & 0xFF);
+	b[at + 1] = (uint8)((v >> 8) & 0xFF);
+	b[at + 2] = (uint8)((v >> 16) & 0xFF);
+	b[at + 3] = (uint8)((v >> 24) & 0xFF);
+}
+
+
+static void put_varint(std::vector<uint8> &b, uint32 v)
+{
+	for(  ;;  ) {
+		uint8 c = (uint8)(v & 0x7F);
+		v >>= 7;
+		b.push_back(v ? (uint8)(c | 0x80) : c);
+		if(  !v  ) return;
+	}
+}
+
+
+void stlab_xr32_build_body(const uint8 *rgba, int w, int h, sint16 x, sint16 y,
+                           uint8 zoomable, uint16 img_index,
+                           const std::vector<stlab_semantic_record_t> &records,
+                           std::vector<uint8> &body)
+{
+	const size_t plane_len = (size_t)w * h * 4;
+
+	std::vector<uint8> plane;
+	uint8 flags = 0;
+	if(  stlab_xr32_deflate_enabled()  ) {
+		uLongf cap = compressBound((uLong)plane_len);
+		plane.resize(cap);
+		if(  compress2(&plane[0], &cap, rgba, (uLong)plane_len, 9) != Z_OK  ) {
+			plane.assign(rgba, rgba + plane_len);        // fall back to the raw plane
+		}
+		else {
+			plane.resize(cap);
+			flags |= XR32_FLAG_BASE_DEFLATED;
+		}
+	}
+	else {
+		plane.assign(rgba, rgba + plane_len);
+	}
+
+	// run/delta encoding: fold neighbouring records that carry identical semantics
+	std::vector<uint8> runs;
+	uint32 run_count = 0, prev_end = 0;
+	size_t i = 0;
+	while(  i < records.size()  ) {
+		const stlab_semantic_record_t &r = records[i];
+		size_t j = i + 1;
+		while(  j < records.size()
+		        &&  records[j].position == records[j - 1].position + 1
+		        &&  records[j].semantic_class == r.semantic_class
+		        &&  records[j].semantic_parameter == r.semantic_parameter
+		        &&  records[j].coverage_alpha8 == r.coverage_alpha8
+		        &&  records[j].has_under == r.has_under
+		        &&  records[j].under_r == r.under_r
+		        &&  records[j].under_g == r.under_g
+		        &&  records[j].under_b == r.under_b  ) {
+			j++;
+		}
+		const uint32 length = (uint32)(j - i);
+		put_varint(runs, r.position - prev_end);
+		put_varint(runs, length);
+		runs.push_back(r.semantic_class);
+		runs.push_back(r.semantic_parameter);
+		runs.push_back(r.coverage_alpha8);
+		if(  r.coverage_alpha8 != 255
+		     &&  (r.semantic_class & XR32_UNDER_IS_FRAMEBUFFER) == 0  ) {
+			runs.push_back(r.under_r);
+			runs.push_back(r.under_g);
+			runs.push_back(r.under_b);
+		}
+		prev_end = r.position + length;
+		run_count++;
+		i = j;
+	}
+
+	body.assign(XR32_HEADER_LEN, 0);
+	body[0] = 'X'; body[1] = 'R'; body[2] = '3'; body[3] = '2';
+	body[4] = XR32_VERSION;
+	flags |= XR32_FLAG_CRC32;
+	body[5] = flags;
+	body[6] = XR32_CLASS_REGISTRY;
+	body[7] = 0;
+	put16(body, 8, (uint16)w);
+	put16(body, 10, (uint16)h);
+	put16(body, 12, (uint16)x);
+	put16(body, 14, (uint16)y);
+	body[16] = zoomable;
+	body[17] = 0;
+	put16(body, 18, img_index);
+	put32(body, 20, (uint32)plane.size());
+	put32(body, 24, run_count);
+	put32(body, 28, (uint32)runs.size());
+
+	body.insert(body.end(), plane.begin(), plane.end());
+	body.insert(body.end(), runs.begin(), runs.end());
+
+	// integrity trailer: CRC-32 of every byte above, so a reader can refuse a damaged
+	// plane or run block before it allocates or inflates anything
+	const uint32 crc = (uint32)crc32( crc32(0L, Z_NULL, 0), &body[0], (uInt)body.size() );
+	const size_t at = body.size();
+	body.resize(at + 4);
+	put32(body, at, crc);
+
+	stlab_semantic_counters.rgba_raw_bytes += plane_len;
+	stlab_semantic_counters.rgba_compressed_bytes += plane.size();
+	stlab_semantic_counters.semantic_bytes += runs.size();
+}
+
+
+void stlab_xr32_flush(FILE *fp, obj_node_t &parent)
+{
+	std::vector<stlab_pending_node_t> &pending = stlab_pending_nodes();
+	for(  size_t i = 0;  i < pending.size();  i++  ) {
+		// creating the node bumps parent->nchildren, which is the only bookkeeping needed;
+		// the parent's own body still reports the IMG count, so get_image() is untouched
+		obj_writer_t *w = pending[i].night ? (obj_writer_t *)stlab_xnex_writer_t::instance()
+		                                   : (obj_writer_t *)stlab_xr32_writer_t::instance();
+		obj_node_t node(w, (uint32)pending[i].body.size(), &parent);
+		node.write_bytes(fp, (uint32)pending[i].body.size(), &pending[i].body[0]);
+		node.check_and_write_header(fp);
+		stlab_semantic_counters.xr32_nodes_written++;
+	}
+	pending.clear();
+}
+
+
+/* ==========================================================================
+ * XR32-SEMANTIC-MASK-PIPELINE-01 -- FORMAT v2 (class registry 2). NOT FOR COMMIT.
+ *
+ * The header is the v1 header with version = 2 and class_registry = 2. The plane is the
+ * UNDER plane: the colour of the non-semantic surface of every pixel, alpha = the pixel's.
+ * The run block holds contributor runs:
+ *
+ *   varint(start - previous start), varint(length), id, coverage
+ *
+ * id is the semantic vocabulary of registry 2 (0..7 PC1 tones, 8..15 PC2 tones, 16..30
+ * lights, == the makeobj special index); coverage is 1..255. Starts never decrease and runs
+ * MAY overlap: a pixel inside k runs has k contributors (k <= 4, coverages summing to at most
+ * 255, no id twice). A v1 reader sees version 2 and falls back to the legacy IMG.
+ * ==========================================================================*/
+#include <algorithm>
+
+static const uint8 XR32_V2_VERSION = 2;
+static const uint8 XR32_V2_CLASS_REGISTRY = 2;
+
+namespace {
+struct v2_run_t {
+	uint32 start, length;
+	uint8 id, coverage;
+	bool operator<(const v2_run_t &o) const { return start != o.start ? start < o.start : id < o.id; }
+};
+}
+
+
+void stlab_xr32_build_body_v2(const uint8 *under, int w, int h, sint16 x, sint16 y,
+                              uint8 zoomable, uint16 img_index,
+                              const std::vector<stlab_sem_contrib_t> &contribs,
+                              std::vector<uint8> &body)
+{
+	const size_t plane_len = (size_t)w * h * 4;
+
+	std::vector<uint8> plane;
+	uint8 flags = 0;
+	{
+		uLongf cap = compressBound((uLong)plane_len);
+		plane.resize(cap);
+		if(  compress2(&plane[0], &cap, under, (uLong)plane_len, 9) != Z_OK  ) {
+			plane.assign(under, under + plane_len);
+		}
+		else {
+			plane.resize(cap);
+			flags |= XR32_FLAG_BASE_DEFLATED;
+		}
+	}
+
+	// fold each id's consecutive pixels with equal coverage into runs
+	std::vector<v2_run_t> runs_v;
+	for(  int id = 0;  id < 256;  id++  ) {
+		v2_run_t cur;
+		bool open = false;
+		for(  size_t i = 0;  i < contribs.size();  i++  ) {
+			const stlab_sem_contrib_t &c = contribs[i];
+			if(  c.id != id  ) continue;
+			if(  open  &&  c.position == cur.start + cur.length  &&  c.coverage == cur.coverage  ) {
+				cur.length++;
+				continue;
+			}
+			if(  open  ) runs_v.push_back(cur);
+			cur.start = c.position; cur.length = 1; cur.id = c.id; cur.coverage = c.coverage;
+			open = true;
+		}
+		if(  open  ) runs_v.push_back(cur);
+	}
+	std::sort(runs_v.begin(), runs_v.end());
+
+	std::vector<uint8> runs;
+	uint32 prev_start = 0;
+	for(  size_t i = 0;  i < runs_v.size();  i++  ) {
+		put_varint(runs, runs_v[i].start - prev_start);
+		put_varint(runs, runs_v[i].length);
+		runs.push_back(runs_v[i].id);
+		runs.push_back(runs_v[i].coverage);
+		prev_start = runs_v[i].start;
+	}
+
+	body.assign(XR32_HEADER_LEN, 0);
+	body[0] = 'X'; body[1] = 'R'; body[2] = '3'; body[3] = '2';
+	body[4] = XR32_V2_VERSION;
+	flags |= XR32_FLAG_CRC32;
+	body[5] = flags;
+	body[6] = XR32_V2_CLASS_REGISTRY;
+	put16(body, 8, (uint16)w);
+	put16(body, 10, (uint16)h);
+	put16(body, 12, (uint16)x);
+	put16(body, 14, (uint16)y);
+	body[16] = zoomable;
+	put16(body, 18, img_index);
+	put32(body, 20, (uint32)plane.size());
+	put32(body, 24, (uint32)runs_v.size());
+	put32(body, 28, (uint32)runs.size());
+	body.insert(body.end(), plane.begin(), plane.end());
+	body.insert(body.end(), runs.begin(), runs.end());
+
+	const uint32 crc = (uint32)crc32( crc32(0L, Z_NULL, 0), &body[0], (uInt)body.size() );
+	const size_t at = body.size();
+	body.resize(at + 4);
+	put32(body, at, crc);
+
+	stlab_semantic_counters.rgba_raw_bytes += plane_len;
+	stlab_semantic_counters.rgba_compressed_bytes += plane.size();
+	stlab_semantic_counters.semantic_bytes += runs.size();
+}
+
+
+/* ==========================================================================
+ * XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 -- EXPERIMENTAL night node XNEX (NOT A FORMAT).
+ * Layout in display/stlab_xr32.h; the reader is written from that comment, not from this code.
+ * ==========================================================================*/
+void stlab_xnex_build_body(const uint8 *night_under, int w, int h, sint16 x, sint16 y, uint16 img_index,
+                           std::vector<uint8> &body)
+{
+	const size_t plane_len = (size_t)w * h * 4;
+	uLongf cap = compressBound((uLong)plane_len);
+	std::vector<uint8> plane(cap);
+	if(  compress2(&plane[0], &cap, night_under, (uLong)plane_len, 9) != Z_OK  ) {
+		dbg->fatal("stlab_xnex", "cannot compress a night plane");
+	}
+	plane.resize(cap);
+	body.assign(24, 0);
+	body[0] = 'X'; body[1] = 'N'; body[2] = 'E'; body[3] = 'X';
+	body[4] = 1;          // version
+	body[5] = 0x03;       // deflated + CRC-32
+	body[6] = 0;          // transition model 'abc'
+	put16(body, 8, (uint16)w);
+	put16(body, 10, (uint16)h);
+	put16(body, 12, (uint16)x);
+	put16(body, 14, (uint16)y);
+	put16(body, 16, img_index);
+	put32(body, 20, (uint32)plane.size());
+	body.insert(body.end(), plane.begin(), plane.end());
+	const uint32 crc = (uint32)crc32( crc32(0L, Z_NULL, 0), &body[0], (uInt)body.size() );
+	const size_t at = body.size();
+	body.resize(at + 4);
+	put32(body, at, crc);
+}
diff --git a/src/simutrans/descriptor/writer/stlab_xr32_writer.h b/src/simutrans/descriptor/writer/stlab_xr32_writer.h
new file mode 100644
index 0000000000000000000000000000000000000000..eaa553f8fa4ee156363cd5b964c22edc5263b9ad
--- /dev/null
+++ b/src/simutrans/descriptor/writer/stlab_xr32_writer.h
@@ -0,0 +1,99 @@
+/*
+ * STLAB-RGBA32-END-TO-END-MAKEOBJ-RUNTIME-01 -- FORMAT CANDIDATE v1 serializer for makeobj.
+ *
+ * NOT FOR COMMIT. Laboratory only. `XR32` is an EXPERIMENTAL tag, not a final ABI.
+ *
+ * The byte layout is taken from RGBA32-NODE-V1-CANDIDATE.md and is not restated or
+ * "improved" here. This translation unit knows the layout; it knows nothing about how the
+ * semantic records were obtained. That separation is deliberate: the extractor is
+ * certified against the Python oracle on its own, and this file is certified against the
+ * independent parser on its own.
+ */
+#ifndef DESCRIPTOR_WRITER_STLAB_XR32_WRITER_H
+#define DESCRIPTOR_WRITER_STLAB_XR32_WRITER_H
+
+#include <vector>
+#include "obj_writer.h"
+#include "stlab_semantic.h"
+
+class obj_node_t;
+
+
+/// a node waiting to be emitted after all the IMG children of its parent
+struct stlab_pending_node_t {
+	uint16 img_index;
+	std::vector<uint8> body;
+	bool night = false;    ///< XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: an XNEX node, not an XR32 one
+};
+
+
+class stlab_xr32_writer_t : public obj_writer_t
+{
+private:
+	static stlab_xr32_writer_t the_instance;
+	stlab_xr32_writer_t() { register_writer(false); }
+
+public:
+	static stlab_xr32_writer_t *instance() { return &the_instance; }
+
+	obj_type get_type() const OVERRIDE { return (obj_type)C4ID('X', 'R', '3', '2'); }
+	const char *get_type_name() const OVERRIDE { return "xr32"; }
+};
+
+
+/// XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01 -- EXPERIMENT: the night node's writer (4CC XNEX, not a format)
+class stlab_xnex_writer_t : public obj_writer_t
+{
+private:
+	static stlab_xnex_writer_t the_instance;
+	stlab_xnex_writer_t() { register_writer(false); }
+
+public:
+	static stlab_xnex_writer_t *instance() { return &the_instance; }
+
+	obj_type get_type() const OVERRIDE { return (obj_type)C4ID('X', 'N', 'E', 'X'); }
+	const char *get_type_name() const OVERRIDE { return "xnex"; }
+};
+
+/// build one XNEX body: the night under plane of one image (layout in display/stlab_xr32.h)
+void stlab_xnex_build_body(const uint8 *night_under, int w, int h, sint16 x, sint16 y, uint16 img_index,
+                           std::vector<uint8> &body);
+
+/// should the base plane be deflated? (env STLAB_XR32_DEFLATE, default yes)
+bool stlab_xr32_deflate_enabled();
+
+/**
+ * Build one candidate node body.
+ *
+ * @param rgba     the region, w*h*4 straight RGBA8888
+ * @param records  the region's semantic records, positions local to the region and sorted
+ */
+void stlab_xr32_build_body(const uint8 *rgba, int w, int h, sint16 x, sint16 y,
+                           uint8 zoomable, uint16 img_index,
+                           const std::vector<stlab_semantic_record_t> &records,
+                           std::vector<uint8> &body);
+
+/**
+ * XR32-SEMANTIC-MASK-PIPELINE-01: build one v2 node body (class registry 2).
+ *
+ * @param under     the region's UNDER plane, w*h*4 straight RGBA8888 (alpha = the pixel's)
+ * @param contribs  the region's contributors, positions local to the region, sorted by
+ *                  position then id; several may share a pixel
+ */
+struct stlab_sem_contrib_t {
+	uint32 position;       ///< linear index into the view it belongs to
+	uint8 id;              ///< semantic id, class registry 2 (0..30 == makeobj special index)
+	uint8 coverage;        ///< 1..255
+};
+void stlab_xr32_build_body_v2(const uint8 *under, int w, int h, sint16 x, sint16 y,
+                              uint8 zoomable, uint16 img_index,
+                              const std::vector<stlab_sem_contrib_t> &contribs,
+                              std::vector<uint8> &body);
+
+/// the nodes accumulated while the current parent's images were written
+std::vector<stlab_pending_node_t> &stlab_pending_nodes();
+
+/// emit every pending node as a child of @p parent, then clear the list
+void stlab_xr32_flush(FILE *fp, obj_node_t &parent);
+
+#endif
diff --git a/src/simutrans/display/blit_clip_core.h b/src/simutrans/display/blit_clip_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..f49488aa8e5466d85fbf38efb8725e0fd2e6e76d
--- /dev/null
+++ b/src/simutrans/display/blit_clip_core.h
@@ -0,0 +1,216 @@
+/*
+ * This file is part of the Simutrans project under the Artistic License.
+ * (see LICENSE.txt)
+ */
+
+#ifndef DISPLAY_BLIT_CLIP_CORE_H
+#define DISPLAY_BLIT_CLIP_CORE_H
+
+
+/*
+ * Renderer-independent clipping geometry.
+ *
+ * Working out which horizontal span of a row survives a set of clipping lines
+ * is integer geometry: it does not know what a screen pixel is, how wide one
+ * is, or what is drawn into it. So it lives here once, and both renderers use
+ * it.
+ *
+ * What this header deliberately does NOT do:
+ *
+ *   - own any clipping state. simgraph16 keeps a clipping_info_t per thread
+ *     and selects it with CLIP_NUM; simgraph32 keeps a single context. Both
+ *     keep theirs. The helpers below take the state they need as arguments,
+ *     so neither renderer's arrangement constrains the other, and per-thread
+ *     clipping stays a question each renderer answers for itself.
+ *   - know about PIXVAL, STORED_PIXVAL, palettes, alpha or framebuffers. It
+ *     includes simtypes.h for the integer types and nothing else.
+ */
+
+#include <cstdlib>   // abs
+
+#include "../simtypes.h"
+#include "scr_coord.h"  // scr_coord_val
+
+
+/**
+ * Interval of the current row associated to some clipline.
+ */
+struct xrange {
+	sint64 sx, sy;
+	scr_coord_val y;
+	bool non_convex_active;
+};
+
+
+class clip_line_t {
+private:
+	// line from (x0,y0) to (x1 y1)
+	// clip (do not draw) everything right from the ray (x0,y0)->(x1,y1)
+	// pixels on the ray are not drawn
+	// (not_convex) if y0>=y1 then clip along the path (x0,-inf)->(x0,y0)->(x1,y1)
+	// (not_convex) if y0<y1  then clip along the path (x0,y0)->(x1,y1)->(x1,+inf)
+	int x0, y0;
+	int dx, dy;
+	sint64 sdy, sdx;
+	sint64 inc;
+	bool non_convex;
+
+public:
+	void clip_from_to(int x0_, int y0_, int x1, int y1, bool non_convex_) {
+		x0 = x0_;
+		dx = x1 - x0;
+		y0 = y0_;
+		dy = y1 - y0;
+		non_convex = non_convex_;
+		int steps = (abs(dx) > abs(dy) ? abs(dx) : abs(dy));
+		if(  steps == 0  ) {
+			return;
+		}
+		sdx = ((sint64)dx << 16) / steps;
+		sdy = ((sint64)dy << 16) / steps;
+		// to stay right from the line
+		// left border: xmin <= x
+		// right border: x < xmax
+		if(  dy > 0  ) {
+			if(  dy > dx  ) {
+				inc = 1 << 16;
+			}
+			else {
+				inc = ((sint64)dx << 16) / dy -  (1 << 16);
+			}
+		}
+		else if(  dy < 0  ) {
+			if(  dy < dx  ) {
+				inc = 0; // (+1)-1 << 16;
+			}
+			else {
+				inc = 0;
+			}
+		}
+	}
+
+	// clip if
+	// ( x-x0) . (  y1-y0 )
+	// ( y-y0) . (-(x1-x0)) < 0
+	// -- initialize the clipping
+	//    has to be called before image will be drawn
+	//    return interval for x coordinate
+	inline void get_x_range(scr_coord_val y, xrange &r, bool use_non_convex) const {
+		// do everything for the previous row
+		y--;
+		r.y = y;
+		r.non_convex_active = false;
+		if(  non_convex  &&  use_non_convex  &&  y < y0  &&  y < (y0 + dy)  ) {
+			r.non_convex_active = true;
+			y = min(y0, y0+dy) - 1;
+		}
+		if(  dy != 0  ) {
+			// init Bresenham algorithm
+			const sint64 t = (((sint64)y - y0) << 16) / sdy;
+			// sx >> 16 = x
+			// sy >> 16 = y
+			r.sx = t * sdx + inc + ((sint64)x0 << 16);
+			r.sy = t * sdy + ((sint64)y0 << 16);
+		}
+	}
+
+	// -- step one line down, return interval for x coordinate
+	inline void inc_y(xrange &r, int &xmin, int &xmax) const {
+		r.y++;
+		// switch between clip vertical and along ray
+		if(  r.non_convex_active  ) {
+			if(  r.y == min( y0, y0 + dy )  ) {
+				r.non_convex_active = false;
+			}
+			else {
+				if(  dy < 0  ) {
+					const int r_xmax = x0 + dx;
+					if(  xmax > r_xmax  ) {
+						xmax = r_xmax;
+					}
+				}
+				else {
+					const int r_xmin = x0 + 1;
+					if(  xmin < r_xmin  ) {
+						xmin = r_xmin;
+					}
+				}
+				return;
+			}
+		}
+		// go along the ray, Bresenham
+		if(  dy != 0  ) {
+			if(  dy > 0  ) {
+				do {
+					r.sx += sdx;
+					r.sy += sdy;
+				} while(  (r.sy >> 16) < r.y  );
+				const int r_xmin = r.sx >> 16;
+				if(  xmin < r_xmin  ) {
+					xmin = r_xmin;
+				}
+			}
+			else {
+				do {
+					r.sx -= sdx;
+					r.sy -= sdy;
+				} while(  (r.sy >> 16) < r.y  );
+				const int r_xmax = r.sx >> 16;
+				if(  xmax > r_xmax  ) {
+					xmax = r_xmax;
+				}
+			}
+		}
+		// horizontal clip
+		else {
+			const bool clip = dx * (r.y - y0) > 0;
+			if(  clip  ) {
+				// invisible row
+				xmin = +1;
+				xmax = -1;
+			}
+		}
+	}
+};
+
+
+/*
+ * The two span helpers. The caller passes its own clip lines, ribi flags and
+ * xranges; this code reads and steps them but owns none of them.
+ */
+
+/**
+ * Initialize the clipping region for an image starting at screen line @p y.
+ */
+static inline void clip_core_init_ranges(int y, int number_of_clips, uint8 active_ribi,
+                                         const uint8 *clip_ribi,
+                                         const clip_line_t *poly_clips,
+                                         xrange *xranges)
+{
+	for(  int i = 0;  i < number_of_clips;  i++  ) {
+		if(  (clip_ribi[i] & active_ribi)  ) {
+			poly_clips[i].get_x_range( y, xranges[i], active_ribi & 16 );
+		}
+	}
+}
+
+
+/**
+ * Narrow [@p xmin, @p xmax) by every active clipping line and step them one
+ * row down. The caller has already seeded the interval from its clip
+ * rectangle.
+ */
+static inline void clip_core_step_y(int &xmin, int &xmax, int number_of_clips, uint8 active_ribi,
+                                    const uint8 *clip_ribi,
+                                    const clip_line_t *poly_clips,
+                                    xrange *xranges)
+{
+	for(  int i = 0;  i < number_of_clips;  i++  ) {
+		if(  (clip_ribi[i] & active_ribi)  ) {
+			poly_clips[i].inc_y( xranges[i], xmin, xmax );
+		}
+	}
+}
+
+
+#endif
diff --git a/src/simutrans/display/blit_core.h b/src/simutrans/display/blit_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..aee8bf03c88bf8c64eeaf4823eb4be221f251541
--- /dev/null
+++ b/src/simutrans/display/blit_core.h
@@ -0,0 +1,171 @@
+/*
+ * This file is part of the Simutrans project under the Artistic License.
+ * (see LICENSE.txt)
+ */
+
+#ifndef DISPLAY_BLIT_CORE_H
+#define DISPLAY_BLIT_CORE_H
+
+
+/*
+ * Renderer-independent image traversal.
+ *
+ * An image row is the historical run stream
+ *
+ *      [clear][count][pixels...][clear]...[0]
+ *
+ * with TRANSPARENT_RUN marking a semi-transparent colour run. Decoding that
+ * stream, stepping over clear runs and walking rows is the same work whatever
+ * a screen pixel is, so it lives here once.
+ *
+ * Everything that knows what a screen pixel IS stays with the renderer, in a
+ * pixel policy:
+ *
+ *      Ops::screen_t                     the destination pixel type
+ *      Ops::copy (dest, src, end)        opaque run
+ *      Ops::alpha(dest, src, end)        semi-transparent run
+ *
+ * The policy is defined inside the renderer's own translation unit, so it can
+ * reach that renderer's palette and blend functions without any of them being
+ * exported, and so the compiler can inline straight through it.
+ *
+ * This header owns no colour arithmetic, no palette, no alpha formula and no
+ * clipping state.
+ */
+
+#include "../simtypes.h"
+#include "scr_coord.h"
+
+#ifndef TRANSPARENT_RUN
+#	define TRANSPARENT_RUN (0x8000u)
+#endif
+
+
+/**
+ * Draw one image without clipping.
+ *
+ * @param h          rows to draw
+ * @param tp         first destination pixel of the first row
+ * @param sp         run stream, already in the policy's screen space
+ * @param disp_width destination pitch, in pixels
+ */
+template<class Ops>
+static inline void blit_core_nc(scr_coord_val h,
+                                typename Ops::screen_t *tp,
+                                const typename Ops::screen_t *sp,
+                                const int disp_width)
+{
+	typedef typename Ops::screen_t screen_t;
+
+	if(  h > 0  ) {
+		do { // line decoder
+			uint16 runlen = (uint16)*sp++;
+			screen_t *p = tp;
+
+			do {
+				// we start with a clear run
+				p += (runlen & ~TRANSPARENT_RUN);
+
+				// now get colored pixels
+				runlen = (uint16)*sp++;
+				if(  runlen & TRANSPARENT_RUN  ) {
+					runlen &= ~TRANSPARENT_RUN;
+					Ops::alpha( p, sp, sp + runlen );
+				}
+				else {
+					Ops::copy( p, sp, sp + runlen );
+				}
+				p  += runlen;
+				sp += runlen;
+			} while(  (runlen = (uint16)*sp++)  );
+
+			tp += disp_width;
+		} while(  --h  );
+	}
+}
+
+
+/**
+ * Interval of a row when the same interval applies to every row.
+ *
+ * This is the horizontally clipped case: the caller has already worked out
+ * the clip rectangle, and it does not change while the image is drawn.
+ */
+struct span_fixed_t {
+	int xmin, xmax;
+
+	inline void next(int &lo, int &hi) const { lo = xmin; hi = xmax; }
+};
+
+
+/**
+ * Draw one image against a clipping interval that may change per row.
+ *
+ * The interval comes from @p span, an object the RENDERER supplies:
+ * span_fixed_t for the clip rectangle, or a renderer-local object that reads
+ * that renderer's own clipping state for the polygon case. This header
+ * therefore never sees a clipping_info_t, a CLIP_NUM or a clip rectangle, and
+ * per-thread clipping stays a question each renderer answers for itself.
+ *
+ * @param h          rows to draw
+ * @param tp         first pixel of the first row of the destination
+ * @param sp         run stream, in the policy's source space
+ * @param xp         x of the image, in destination pixels
+ * @param disp_width destination pitch, in pixels
+ * @param span       supplies [xmin, xmax) for each row, in order
+ * @param ops        the pixel policy. Passed as an OBJECT, not used
+ *                   purely statically, so that a policy may carry the
+ *                   little state some of them need - a blend colour, an
+ *                   alpha map. Stateless policies are empty classes and
+ *                   the default argument costs nothing.
+ */
+template<class Ops, class Span>
+static inline void blit_core_clipped(scr_coord_val h,
+                                     typename Ops::screen_t *tp,
+                                     const typename Ops::source_t *sp,
+                                     const int xp,
+                                     const int disp_width,
+                                     Span span,
+                                     const Ops &ops = Ops())
+{
+	if(  h > 0  ) {
+		do { // line decoder
+			int xpos = xp;
+
+			int runlen = (int)(uint16)*sp++;
+
+			// get left/right boundary, step
+			int xmin, xmax;
+			span.next( xmin, xmax );
+			do {
+				// we start with a clear run (which may be 0 pixels)
+				xpos += (runlen & ~TRANSPARENT_RUN);
+
+				// now get colored pixels
+				runlen = (int)(uint16)*sp++;
+				const int has_alpha = runlen & TRANSPARENT_RUN;
+				runlen &= ~TRANSPARENT_RUN;
+
+				// something to display?
+				if(  xmin < xmax  &&  xpos + runlen > xmin  &&  xpos < xmax  ) {
+					const int left = (xpos >= xmin ? 0 : xmin - xpos);
+					const int len  = (xmax - xpos >= runlen ? runlen : xmax - xpos);
+					if(  !has_alpha  ) {
+						ops.copy( tp + xpos + left, sp + left, sp + len );
+					}
+					else {
+						ops.alpha( tp + xpos + left, sp + left, sp + len );
+					}
+				}
+
+				sp   += runlen;
+				xpos += runlen;
+			} while(  (runlen = (int)(uint16)*sp++)  );
+
