+
+/* --- the replacement producer of data[player] -------------------------------- */
+
+/* CANDIDATE C1 -- scratch buffers reused across images.
+ *
+ * The producer used to malloc and free two buffers per image: a dense w*h*4
+ * RGBA raster, and a run-stream buffer sized for the worst case. Both are
+ * strictly internal to one call, so neither has to be a fresh allocation, and
+ * the worst-case one must not become the screen cache: at pakset scale that
+ * kept 53.2 MB where the exact length needs 15.7 MB.
+ *
+ * recode_img() holds recode_img_mutex32 across this call under MULTI_THREAD.
+ */
+static uint32 *stlab_scratch_raster = NULL;
+static size_t  stlab_scratch_raster_px = 0;
+static PIXVAL *stlab_scratch_out = NULL;
+static size_t  stlab_scratch_out_len = 0;
+
+
+static bool stlab_scratch_reserve(size_t want_px, size_t want_out)
+{
+	if(  want_px > stlab_scratch_raster_px  ) {
+		free( stlab_scratch_raster );
+		stlab_scratch_raster = MALLOCN( uint32, want_px );
+		if(  stlab_scratch_raster == NULL  ) {
+			stlab_scratch_raster_px = 0;
+			return false;
+		}
+		stlab_scratch_raster_px = want_px;
+	}
+	if(  want_out > stlab_scratch_out_len  ) {
+		free( stlab_scratch_out );
+		stlab_scratch_out = MALLOCN( PIXVAL, want_out );
+		if(  stlab_scratch_out == NULL  ) {
+			stlab_scratch_out_len = 0;
+			return false;
+		}
+		stlab_scratch_out_len = want_out;
+	}
+	return true;
+}
+
+
+void stlab_xr32_scratch_release()
+{
+	free( stlab_scratch_raster );  stlab_scratch_raster = NULL;  stlab_scratch_raster_px = 0;
+	free( stlab_scratch_out );     stlab_scratch_out = NULL;     stlab_scratch_out_len = 0;
+}
+
+
+/// worst case of stlab_xr32_encode_rows(): per row a leading clear, then per pixel a
+/// separator + count + the pixel (alternating opaque and translucent), and the terminator
+static inline size_t stlab_xr32_encode_cap(uint32 w, uint32 h)
+{
+	return (size_t)h * (3 + 3 * (size_t)w) + 8;
+}
+
+
+/**
+ * Encode a resolved raster as the screen run stream: [clear][count][pixels...]...[0] per
+ * row. A raster pixel is 0 (hole), 0xFFrrggbb (opaque) or 0xAArrggbb with 8 <= AA <= 254
+ * (straight alpha). Opaque and translucent pixels go into separate runs; a translucent run
+ * carries TRANSPARENT_RUN and keeps the full ARGB word, which the screen-space blitters
+ * tell apart from the legacy class+alpha codes (all below 0x10000) by the top byte. Two
+ * adjacent runs are separated by TRANSPARENT_RUN as a zero-length clear run, the separator
+ * the legacy encoder uses, because a clear run of 0 ends the row.
+ */
+static PIXVAL *stlab_xr32_encode_rows(const uint32 *raster, uint32 w, uint32 h, PIXVAL *d)
+{
+	for(  uint32 y = 0;  y < h;  y++  ) {
+		const uint32 *row = raster + (size_t)y * w;
+		uint32 x = 0;
+		bool first = true;
+		while(  x < w  ) {
+			uint32 clear = 0;
+			while(  x < w  &&  row[x] == 0  ) { clear++; x++; }
+			if(  x >= w  ) {
+				if(  first  ) { *d++ = 0; *d++ = 0; }   // an entirely empty row
+				break;
+			}
+			*d++ = first  ||  clear  ?  (PIXVAL)clear  :  (PIXVAL)TRANSPARENT_RUN;
+			const bool opaque = (row[x] >> 24) == 0xFFu;
+			const uint32 start = x;
+			while(  x < w  &&  row[x] != 0  &&  ((row[x] >> 24) == 0xFFu) == opaque  ) { x++; }
+			const uint32 count = x - start;
+			*d++ = opaque  ?  (PIXVAL)count  :  (PIXVAL)(count | TRANSPARENT_RUN);
+			for(  uint32 k = 0;  k < count;  k++  ) {
+				*d++ = (PIXVAL)row[start + k];
+			}
+			first = false;
+		}
+		if(  first  &&  w == 0  ) { *d++ = 0; *d++ = 0; }
+		*d++ = 0;                                        // end of row
+	}
+	return d;
+}
+
+
+/**
+ * Resolve the candidate node for one player and encode the result as the screen run
+ * stream the blitters already consume: [clear][count][pixels...]...[0] per row.
+ *
+ * No STORED_PIXVAL is read or written anywhere in here.
+ */
+#include "stlab_xr32_zoom.cci"       // native zoom, section 39 of the design report
+
+
+/**
+ * MRES (MRES-V2-SPEC.md, section 5). At exactly 2/1, a candidate-backed image whose
+ * authored 2x counterpart ALSO carries a candidate shows that counterpart, resolved
+ * at 1:1, instead of its own native enlargement. Returns false - and clears any
+ * previous choice - whenever that does not apply, so the native zoom takes over.
+ * A fitted image (fit_num != 0) is at its fit step, not at the map's zoom, exactly
+ * as stlab_xr32_zoom_prepare() sizes it: otherwise a map zoom change dropped a
+ * toolbar icon's 2x art for its 1x art at 2/1 until the next refit.
+ * Called under rezoom_img_mutex32, like stlab_xr32_zoom_prepare().
+ */
+static bool stlab_xr32_hires_prepare(image_id n)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	s->hires_active = IMG_EMPTY;
+	const sint32 num = s->fit_num ? s->fit_num : g_simgraph32.zoom_num[zoom_factor32];
+	const sint32 den = s->fit_num ? s->fit_den : g_simgraph32.zoom_den[zoom_factor32];
+	if(  (images[n].recode_flags & FLAG_ZOOMABLE) == 0  ||  num != 2  ||  den != 1  ) {
+		return false;
+	}
+	const image_id hi = simgraph_get_hires( n );
+	if(  hi == IMG_EMPTY  ||  hi >= anz_images  ) {
+		return false;
+	}
+	const stlab_xr32_slot_t *hs = stlab_slot( hi, false );
+	if(  hs == NULL  ||  hs->img == NULL  ) {
+		return false;             // a legacy-only counterpart: the 1x candidate is zoomed natively
+	}
+	const stlab_xr32_image_t *hi_img = hs->img;
+	if(  (hi_img->night != NULL) != (s->img->night != NULL)  ) {
+		return false;             // XR32-PRISSI-NIGHT-IMAGE-PROTOTYPE-01: never swap the night away when zooming
+	}
+	if(  (sint32)hi_img->height < images[n].base_h * 2 - 2
+	     ||  (sint32)hi_img->height > images[n].base_h * 2 + 2
+	     ||  (sint32)hi_img->width < images[n].base_w * 2 - 2
+	     ||  (sint32)hi_img->width > images[n].base_w * 2 + 2  ) {
+		return false;
+	}
+	stlab_xr32_zoom_release( s );
+	images[n].player_flags = 0xFFFF;
+	for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+		if(  images[n].data[i] != NULL  ) {
+			free( images[n].data[i] );
+			images[n].data[i] = NULL;
+		}
+	}
+	images[n].x = hi_img->x;
+	images[n].y = hi_img->y;
+	images[n].w = (sint16)hi_img->width;
+	images[n].h = (sint16)hi_img->height;
+	s->hires_active = hi;
+	images[n].recode_flags &= ~FLAG_REZOOM;
+	return true;
+}
+
+
+/// resolved_night of a screen cache that holds the DAY resolution (XR32-UI-DAYTIME-01)
+static const int STLAB_RESOLVED_DAYTIME = -1000;
+
+bool stlab_xr32_recode(image_id n, sint8 player_nr);
+
+
+/**
+ * XR32-UI-DAYTIME-01: the screen cache of image @p n for @p player_nr, resolved for the day - what a draw with
+ * daynight=false needs at night. The cache is the one the world draws from, so it is marked stale for the world
+ * afterwards (player_flags); the world never asks for daynight=false (the interface does), and the interface is
+ * drawn after the world's display lanes, so the two never use it at the same time. Call under recode_img_mutex32.
+ */
+bool stlab_xr32_recode_daytime(image_id n, sint8 player_nr)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	if(  images[n].data[player_nr] != NULL  &&  s->resolved_player == (uint8)player_nr  &&  s->resolved_night == STLAB_RESOLVED_DAYTIME  ) {
+		return true;
+	}
+	stlab_daytime = true;
+	const bool ok = stlab_xr32_recode( n, player_nr );
+	stlab_daytime = false;
+	if(  ok  ) {
+		s->resolved_night = STLAB_RESOLVED_DAYTIME;
+		images[n].player_flags |= (uint16)(1 << player_nr);
+	}
+	return ok;
+}
+
+
+/// XR32-UI-DAYTIME-01: the palette changed (recode32): a day resolution may no longer describe it either
+void stlab_xr32_forget_daytime()
+{
+	stlab_xr32_base_release();
+	for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) {
+		if(  stlab_slots[i].resolved_night == STLAB_RESOLVED_DAYTIME  ) {
+			stlab_slots[i].resolved_night = -999;
+		}
+	}
+}
+
+
+bool stlab_xr32_recode(image_id n, sint8 player_nr)
+{
+	stlab_xr32_slot_t *s = stlab_slot(n, false);
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	// away from neutral the screen cache comes from the derived scaled cache. Never
+	// the STORED16 path.
+	// XR32-FIT-IMG-TO-WIDTH-01: an image fitted by fit_img_to_width() keeps the step chosen there, whatever the
+	// world zoom, exactly as a legacy image keeps the zoom_data that fit built
+	const bool fitted = s->fit_num != 0;
+	const bool scaled = s->hires_active == IMG_EMPTY
+	                    &&  (fitted  ||  (zoom_factor32 != ZOOM_NEUTRAL  &&  (images[n].recode_flags & FLAG_ZOOMABLE) != 0));
+	if(  scaled  &&  stlab_xr32_zoom_recode( n, player_nr )  ) {
+		return true;
+	}
+	if(  scaled  &&  s->zoom == NULL  ) {
+		// the image degenerates at this scale: stlab_xr32_zoom_prepare() left h = 0, as
+		// the legacy resampler does, and there is nothing to draw. The unscaled
+		// candidate below would draw it at its 1:1 size and offsets.
+		imd32 &im = images[n];
+		if(  im.data[player_nr] == NULL  ) {
+			im.data[player_nr] = MALLOCN( PIXVAL, 1 );
+			im.data[player_nr][0] = 0;
+		}
+		im.h = 0;
+		s->resolved_player = (uint8)player_nr;
+		s->resolved_night = night_shift;
+		return true;
+	}
+	// back at neutral the scaled cache is dead weight
+	if(  zoom_factor32 == ZOOM_NEUTRAL  &&  s->zoom != NULL  &&  !fitted  ) {
+		stlab_xr32_zoom_release( s );
+	}
+	const stlab_xr32_image_t *img = s->img;
+	if(  s->hires_active != IMG_EMPTY  &&  (zoom_factor32 != ZOOM_NEUTRAL  ||  fitted)  ) {
+		// MRES: the authored 2x candidate, resolved at 1:1 (stlab_xr32_hires_prepare); fit_img_to_width() at
+		// exactly 2/1 chooses it too, as the legacy rezoom does
+		const stlab_xr32_slot_t *hs = stlab_slot( s->hires_active, false );
+		if(  hs != NULL  &&  hs->img != NULL  ) {
+			img = hs->img;
+		}
+	}
+	const uint32 w = img->width, h = img->height;
+	const uint32 npx = w * h;
+
+	if(  !stlab_scratch_reserve( npx, stlab_xr32_encode_cap( w, h ) )  ) {
+		return false;
+	}
+	uint32 *raster = stlab_scratch_raster;
+	stlab_xr32_resolve( img, player_nr, raster );
+
+	PIXVAL *out = stlab_scratch_out;
+	PIXVAL *d = stlab_xr32_encode_rows( raster, w, h, out );
+	imd32 &im = images[n];
+	const size_t used = (size_t)(d - out);
+	if(  im.data[player_nr] != NULL  ) {
+		free( im.data[player_nr] );
+	}
+	PIXVAL *cache = MALLOCN( PIXVAL, used );
+	memcpy( cache, out, used * sizeof(PIXVAL) );
+	im.data[player_nr] = cache;
+	im.len = (uint32)used;
+	im.w = (sint16)w;
+	im.h = (sint16)h;
+	s->resolved_player = (uint8)player_nr;
+	s->resolved_night = night_shift;
+	return true;
+}
+
+
+/* --- XR32-UI-BASE-01: an image at its BASE size, for the interface ------------------------------------
+ *
+ * simgraph32_draw_base_img() and its blend form draw an image at its unzoomed base size while the world is
+ * zoomed (the interface's images: gui_image, gui_image_list, the convoy and vehicle lists ...). For a legacy
+ * image they read base_data, which for a candidate-backed image is its 16-bit picture. These are the 1:1 XR32
+ * runs instead, kept apart from the world's screen cache (which holds the zoomed image), per image for one
+ * player and one context at a time (the night level, or STLAB_RESOLVED_DAYTIME for daynight=false).
+ */
+struct stlab_xr32_base_t {
+	PIXVAL *runs = NULL;
+	uint8 player = 0xFF;
+	int night = -999;
+};
+static std::map<image_id, stlab_xr32_base_t> stlab_base_runs;
+
+
+/// the 1:1 runs of image @p n for @p player_nr, and their geometry; NULL if it has no XR32 data. Call under
+/// recode_img_mutex32 (it uses the shared scratch buffers). The pointer stays valid until the next palette
+/// change (stlab_xr32_forget_daytime) or release.
+const PIXVAL *stlab_xr32_base_runs(image_id n, sint8 player_nr, bool daynight, scr_coord_val *x, scr_coord_val *y,
+                                   scr_coord_val *w, scr_coord_val *h)
+{
+	const stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return NULL;
+	}
+	const stlab_xr32_image_t *img = s->img;
+	*x = img->x;
+	*y = img->y;
+	*w = img->width;
+	*h = img->height;
+	// daynight=true is the night level's resolution (the day_night tables, also at level 0), daynight=false the
+	// day context of XR32-UI-DAYTIME-01 (the all_day tables) - the two tables the 16-bit families read
+	const int key = daynight ? night_shift : STLAB_RESOLVED_DAYTIME;
+	stlab_xr32_base_t &b = stlab_base_runs[n];
+	if(  b.runs != NULL  &&  b.player == (uint8)player_nr  &&  b.night == key  ) {
+		return b.runs;
+	}
+	const uint32 npx = (uint32)img->width * img->height;
+	if(  npx == 0  ||  !stlab_scratch_reserve( npx, stlab_xr32_encode_cap( img->width, img->height ) )  ) {
+		return NULL;
+	}
+	stlab_daytime = key == STLAB_RESOLVED_DAYTIME;
+	stlab_xr32_resolve( img, player_nr, stlab_scratch_raster );
+	stlab_daytime = false;
+	PIXVAL *d = stlab_xr32_encode_rows( stlab_scratch_raster, img->width, img->height, stlab_scratch_out );
+	const size_t used = (size_t)(d - stlab_scratch_out);
+	free( b.runs );
+	b.runs = MALLOCN( PIXVAL, used );
+	memcpy( b.runs, stlab_scratch_out, used * sizeof(PIXVAL) );
+	b.player = (uint8)player_nr;
+	b.night = key;
+	return b.runs;
+}
+
+
+/// XR32-UI-BASE-01: drop every base-size run set (the palette changed, or the images go)
+static void stlab_xr32_base_release()
+{
+	for(  auto &b : stlab_base_runs  ) {
+		free( b.second.runs );
+	}
+	stlab_base_runs.clear();
+}
