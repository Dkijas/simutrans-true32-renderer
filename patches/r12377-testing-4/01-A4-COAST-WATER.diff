+/// the node a cache is built from: the slot's own, or for a derived tile a raster composed into @p tmp (owned by tmp)
+static const stlab_xr32_image_t *stlab_xr32_source(image_id n, const stlab_xr32_slot_t *s, stlab_xr32_image_t &tmp)
+{
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return NULL;
+	}
+	std::map<image_id, stlab_xr32_derive_t>::const_iterator it = stlab_derived.find( n );
+	if(  it == stlab_derived.end()  ) {
+		return s->img;
+	}
+	return stlab_derive_compose( n, it->second, tmp ) ? &tmp : NULL;
+}
