+/* --- XR32-COAST-RENDERING-01 (A4): coast water tiles derived from the sea's XR32 data ----------------------
+ *
+ * The water of a sloped coast is not a pak image: ground_desc_t::init_ground_textures() generates one tile per
+ * slope and water animation stage from the 16-bit words of the sea image (five pasted copies on the water climate
+ * texture, then cut to the slope's light map; create_texture_from_tile + create_textured_tile(binary)). Such a tile
+ * gets a node shell here and a RECIPE (sea, light map, texture); its raster is composed exactly the way the 16-bit
+ * tile was - same order, same bounds, the same pixel set - from the sea's XR32 planes, whenever a cache is built from
+ * it (screen cache, base-size runs, zoom cache), into memory owned by that one call. Nothing else is stored: the
+ * 2,144 tiles of a 32-stage water pak would otherwise keep 80 MB of rasters (four times their 16-bit words).
+ */
+struct stlab_xr32_derive_t {
+	image_id light = IMG_EMPTY, sea = IMG_EMPTY, ref = IMG_EMPTY;
+};
+static std::map<image_id, stlab_xr32_derive_t> stlab_derived;
+static std::atomic<uint32> stlab_derive_tiles( 0 );        ///< measurement only: tiles that got a recipe
+static std::atomic<uint64> stlab_derive_compose_n( 0 );    ///< measurement only: rasters composed
+static std::atomic<uint64> stlab_derive_compose_us( 0 );   ///< measurement only: wall time composing, microseconds
+static std::atomic<uint64> stlab_derive_ref_px( 0 );       ///< measurement only: tile pixels from the texture, not the sea
+static std::atomic<uint64> stlab_derive_legacy_px( 0 );    ///< measurement only: sea pixels without XR32 colour (legacy colour used)
+
+
+/// one legacy pixel as the palette shows it by day (the NIGHTGEN expansion), and its legacy level-4 night colour
+static void stlab_derive_legacy_rgba(STORED_PIXVAL v, uint8 *dp, uint8 *np)
+{
+	dp[0] = (uint8)((v & 0x7C00) >> 7);  dp[1] = (uint8)((v & 0x03E0) >> 2);  dp[2] = (uint8)((v & 0x001F) << 3);
+	dp[3] = 255;
+	if(  np  ) {
+		const double m4[2] = { pow(0.75, 4) * ((light_level + 8.0) / 8.0), pow(0.83, 4) * ((light_level + 8.0) / 8.0) };
+		np[0] = (uint8)(int)(dp[0] * m4[0]);  np[1] = (uint8)(int)(dp[1] * m4[0]);  np[2] = (uint8)(int)(dp[2] * m4[1]);
+		np[3] = 255;
+	}
+}
+
+
+/// does this legacy stream carry semi-transparent runs or special colours (player, lights)?
+static bool stlab_derive_plain(image_id n)
+{
+	const imd32 &d = images[n];
+	if(  d.base_data == NULL  ||  (d.recode_flags & (FLAG_HAS_PLAYER_COLOR | FLAG_HAS_TRANSPARENT_COLOR))  ) {
+		return false;
+	}
+	const STORED_PIXVAL *sp = d.base_data;
+	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
+		uint16 runlen = *sp++;
+		do {
+			runlen = *sp++;
+			for(  uint16 k = 0;  k < runlen;  k++  ) {
+				if(  sp[k] >= 0x8000  ) {
+					return false;
+				}
+			}
+			sp += runlen;
+		} while(  (runlen = *sp++)  );
+	}
+	return true;
+}
+
+
+bool stlab_xr32_derive_water_tile(image_id tile, image_id light, image_id sea, image_id ref)
+{
+	if(  !stlab_xr32_enabled()  ||  tile >= anz_images  ||  light >= anz_images  ||  sea >= anz_images  ||  ref >= anz_images  ) {
+		return false;
+	}
+	const stlab_xr32_slot_t *ss = stlab_slot( sea, false );
+	if(  ss == NULL  ||  ss->img == NULL  ||  ss->img->rgba == NULL  ||  ss->img->run_count != 0  ||  stlab_derived.count( sea )  ) {
+		return false;   // the sea has no XR32 colour of its own: the tile stays the 16-bit one
+	}
+	const imd32 &t = images[tile], &l = images[light], &r = images[ref];
+	// the tile is a copy of the light map (copy_rotate(0)), and the texture a rectangle at x 0 (create_texture_from_tile)
+	if(  t.base_w <= 0  ||  t.base_h <= 0  ||  t.base_w != l.base_w  ||  t.base_h != l.base_h  ||  t.base_x != l.base_x  ||  t.base_y != l.base_y
+	     ||  r.base_x != 0  ||  r.base_w <= 1  ||  !stlab_derive_plain( tile )  ||  !stlab_derive_plain( light )  ||  !stlab_derive_plain( sea )  ) {
+		return false;
+	}
+	stlab_xr32_image_t *shell = new stlab_xr32_image_t();
+	shell->width = (uint16)t.base_w;  shell->height = (uint16)t.base_h;
+	shell->x = t.base_x;  shell->y = t.base_y;
+	shell->zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
+	shell->version = ss->img->version;
+	if(  !stlab_xr32_attach( tile, shell, t.base_x, t.base_y, t.base_w, t.base_h, shell->zoomable )  ) {
+		delete shell;
+		return false;
+	}
+	stlab_xr32_derive_t &rc = stlab_derived[tile];
+	rc.light = light;  rc.sea = sea;  rc.ref = ref;
+	stlab_derive_tiles++;
+	return true;
+}
+
+
+/// compose the raster (and the night plane if the sea has one) of a derived tile; false if it cannot be done
+static bool stlab_derive_compose(image_id tile, const stlab_xr32_derive_t &rc, stlab_xr32_image_t &out)
+{
+	const std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+	const stlab_xr32_slot_t *ss = stlab_slot( rc.sea, false );
+	if(  ss == NULL  ||  ss->img == NULL  ||  ss->img->rgba == NULL  ) {
+		return false;
+	}
+	const stlab_xr32_image_t *sn = ss->img;
+	const stlab_xr32_slot_t *rs = stlab_slot( rc.ref, false );
+	const stlab_xr32_image_t *rn = (rs != NULL  &&  rs->img != NULL  &&  rs->img->rgba != NULL  &&  !stlab_derived.count( rc.ref )) ? rs->img : NULL;
+	const bool night = sn->night != NULL;
+	const imd32 &t = images[tile], &l = images[rc.light], &sea = images[rc.sea], &r = images[rc.ref];
+
+	// 1. the texture, as create_texture_from_tile() builds it: the water climate texture (rows r.y .. r.h - 1 in
+	//    its own convention, columns 0 .. w - 1), then every sea pixel pasted at its place and four neighbours
+	const sint32 rw = r.base_w, ry = r.base_y, rh = r.base_h;
+	const size_t tex_px = (size_t)rw * (size_t)(rh > 0 ? rh : 0);
+	std::vector<uint8> tex( tex_px * 4, 0 ), texn( night ? tex_px * 4 : 0, 0 );
+	{
+		const STORED_PIXVAL *sp = r.base_data;
+		for(  sint32 y = 0;  y < rh;  y++  ) {
+			sint32 x = 0;
+			uint16 runlen = *sp++;
+			do {
+				x += runlen;
+				runlen = *sp++;
+				for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
+					if(  x < 0  ||  x >= rw  ) continue;
+					const size_t i = (size_t)y * rw + x;
+					// by day the texture's XR32 colour if it has one, otherwise its legacy colour; at night its XR32
+					// night plane if it has one, otherwise the legacy level-4 colour (what NIGHTGEN gives a legacy pixel)
+					uint8 ld[4], ln[4];
+					stlab_derive_legacy_rgba( sp[k], ld, ln );
+					const bool xr = rn  &&  (uint32)y < rn->height  &&  (uint32)x < rn->width  &&  rn->x == 0  &&  rn->y == ry
+					                &&  rn->rgba[((size_t)y * rn->width + x) * 4 + 3];
+					memcpy( &tex[i * 4], xr ? rn->rgba + ((size_t)y * rn->width + x) * 4 : ld, 4 );
+					if(  night  ) {
+						memcpy( &texn[i * 4], (xr  &&  rn->night) ? rn->night + ((size_t)y * rn->width + x) * 4 : ln, 4 );
+					}
+				}
+				sp += runlen;
+			} while(  (runlen = *sp++)  );
+		}
+	}
+	std::vector<uint8> from_sea( tex_px, 0 );
+	{
+		const STORED_PIXVAL *sp = sea.base_data;
+		for(  sint32 y = 0;  y < sea.base_h;  y++  ) {
+			sint32 x = sea.base_x;
+			uint16 runlen = *sp++;
+			do {
+				x += runlen;
+				runlen = *sp++;
+				for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
+					// the colour of this sea pixel: its XR32 day / night value, the legacy one if the node has none there
+					uint8 dc[4], nc[4];
+					const sint32 sx = x - sn->x, sy = y + sea.base_y - sn->y;
+					const bool has = sx >= 0  &&  sy >= 0  &&  sx < sn->width  &&  sy < sn->height  &&  sn->rgba[((size_t)sy * sn->width + sx) * 4 + 3];
+					if(  has  ) {
+						memcpy( dc, sn->rgba + ((size_t)sy * sn->width + sx) * 4, 4 );
+						if(  night  ) memcpy( nc, sn->night + ((size_t)sy * sn->width + sx) * 4, 4 );
+					}
+					else {
+						stlab_derive_legacy_rgba( sp[k], dc, night ? nc : NULL );
+						stlab_derive_legacy_px++;
+					}
+					// copypixel() of create_texture_from_tile(), the same five places in the same order and bounds
+					const sint32 yy0 = y + sea.base_y;
+					const sint32 px[5] = { x, x + rw / 2, x - rw / 2, x + rw / 2, x - rw / 2 };
+					const sint32 py[5] = { yy0, yy0 + rw / 4, yy0 + rw / 4, yy0 - rw / 4, yy0 - rw / 4 };
+					for(  int c = 0;  c < 5;  c++  ) {
+						if(  ry <= py[c]  &&  py[c] < rh  &&  0 <= px[c]  &&  px[c] < rw  ) {
+							const size_t i = (size_t)(py[c] - ry) * rw + px[c];
+							memcpy( &tex[i * 4], dc, 4 );
+							if(  night  ) memcpy( &texn[i * 4], nc, 4 );
+							from_sea[i] = 1;
+						}
+					}
+				}
+				sp += runlen;
+			} while(  (runlen = *sp++)  );
+		}
+	}
+
+	// 2. the tile, as create_textured_tile(binary) cuts it: where the light map is not black, the texture pixel at the
+	//    same column and row; where it is black, the tile keeps that black
+	const uint32 w = (uint32)t.base_w, h = (uint32)t.base_h;
+	uint8 *day = (uint8 *)calloc( (size_t)w * h, 4 );
+	uint8 *nig = night ? (uint8 *)calloc( (size_t)w * h, 4 ) : NULL;
+	if(  day == NULL  ||  (night  &&  nig == NULL)  ) {
+		free( day );  free( nig );
+		return false;
+	}
+	const STORED_PIXVAL *tp = t.base_data, *lp = l.base_data;
+	for(  uint32 j = 0;  j < h;  j++  ) {
+		sint32 x = *tp++;  lp++;
+		uint16 runlen;
+		do {
+			runlen = *tp++;  lp++;
+			for(  uint16 k = 0;  k < runlen;  k++, x++  ) {
+				const STORED_PIXVAL lv = lp[k];
+				if(  x < 0  ||  (uint32)x >= w  ) continue;
+				uint8 *dp = day + ((size_t)j * w + x) * 4;
+				uint8 *np = night ? nig + ((size_t)j * w + x) * 4 : NULL;
+				const sint32 row = t.base_y + (sint32)j - ry;
+				if(  lv != 0  &&  row >= 0  &&  row < rh  &&  x < rw  ) {
+					const size_t i = (size_t)row * rw + x;
+					memcpy( dp, &tex[i * 4], 4 );
+					if(  night  ) memcpy( np, &texn[i * 4], 4 );
+					if(  !from_sea[i]  ) stlab_derive_ref_px++;
+				}
+				else {
+					stlab_derive_legacy_rgba( tp[k], dp, np );   // black where the light map is black (binary mode)
+				}
+			}
+			tp += runlen;  lp += runlen;
+			x += *tp;
+		} while(  (lp++, *tp++) != 0  );
+	}
+	out.width = (uint16)w;  out.height = (uint16)h;
+	out.x = t.base_x;  out.y = t.base_y;
+	out.zoomable = (t.recode_flags & FLAG_ZOOMABLE) ? 1 : 0;
+	out.version = sn->version;
+	out.rgba = day;
+	out.night = nig;
+	stlab_derive_compose_n++;
+	stlab_derive_compose_us += (uint64)std::chrono::duration_cast<std::chrono::microseconds>( std::chrono::steady_clock::now() - t0 ).count();
+	return true;
+}
+
