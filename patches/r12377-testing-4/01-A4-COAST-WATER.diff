+/// the images from @p above on are being freed: drop their XR32 data with them (their ids are reused next)
+static void stlab_xr32_release_above(image_id above)
+{
+	stlab_xr32_base_release();
+	for(  image_id i = above;  i < stlab_slots_alloc;  i++  ) {
+		stlab_xr32_zoom_release( &stlab_slots[i] );
+		delete stlab_slots[i].img;
+		stlab_slots[i] = stlab_xr32_slot_t();
+	}
+	for(  std::map<image_id, stlab_xr32_derive_t>::iterator it = stlab_derived.lower_bound( above );  it != stlab_derived.end();  ) {
+		it = stlab_derived.erase( it );
+	}
+}
