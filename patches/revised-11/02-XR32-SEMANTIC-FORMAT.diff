+/// linear accumulator (1.0 == 65535*255) -> sRGB 0..255, round half up, saturating
+static inline uint8 stlab_lin_encode(uint32 acc)
+{
+	uint32 lo = 0, hi = 255;
+	while(  lo < hi  ) {
+		const uint32 mid = (lo + hi) >> 1;
+		if(  acc >= stlab_lin_thr[mid]  ) lo = mid + 1;
+		else hi = mid;
+	}
