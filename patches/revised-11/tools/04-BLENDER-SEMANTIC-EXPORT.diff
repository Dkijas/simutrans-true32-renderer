diff --git a/addon/rig.py b/addon/rig.py
index 9fe23e0..8a2229f 100644
--- a/addon/rig.py
+++ b/addon/rig.py
@@ -573,6 +573,94 @@ def make_livery_material(bpy, image, mask, name=None, roughness=0.62):
     return mat
 
 
+# --- the semantic pass -------------------------------------------------------
+#
+# Which pixels are player colour or lights is known HERE, at the material, long
+# before any pixel exists. The semantic pass renders that knowledge: every lit
+# shader is replaced by black emission, every emission is left alone. A declared
+# player-colour patch or a livery's lit window then arrives with its exact
+# authoring colour, and nothing that a sun shone on can come out as a reserved
+# colour by accident. core.semantic turns this pass into the X.sem.<name>.png masks.
+
+def _is_lit_shader(node):
+    return node.type.startswith("BSDF_") or node.type in ("SUBSURFACE_SCATTERING", "PRINCIPLED_VOLUME",
+                                                           "EEVEE_SPECULAR")
+
+
+def _semantic_variant(bpy, mat, black):
+    if not mat.use_nodes or mat.node_tree is None:
+        return black
+    var = mat.copy()
+    var.name = "SEMANTIC_" + mat.name
+    nt = var.node_tree
+    for node in [n for n in nt.nodes if _is_lit_shader(n)]:
+        emit = nt.nodes.new("ShaderNodeEmission")
+        emit.inputs["Color"].default_value = (0.0, 0.0, 0.0, 1.0)
+        emit.inputs["Strength"].default_value = 1.0
+        # Principled carries its own emission: a lamp painted that way is a declared
+        # light, so keep that term (colour and strength, linked or not) and drop the rest
+        for src, dst in (("Emission Color", "Color"), ("Emission Strength", "Strength")):
+            if node.type == "BSDF_PRINCIPLED" and src in node.inputs:
+                sock = node.inputs[src]
+                if sock.is_linked:
+                    nt.links.new(sock.links[0].from_socket, emit.inputs[dst])
+                else:
+                    emit.inputs[dst].default_value = sock.default_value
+        for out in node.outputs:
+            for link in list(out.links):
+                nt.links.new(emit.outputs["Emission"], link.to_socket)
+        nt.nodes.remove(node)
+    return var
+
+
+class semantic_pass:
+    """Context manager: while active, renders show the semantic pass.
+
+        with rig.semantic_pass(bpy):
+            bpy.ops.render.render(write_still=True)
+
+    Nothing is changed for good: material slots get copies and get their own
+    materials back on exit, and the copies are deleted.
+    """
+
+    def __init__(self, bpy):
+        self.bpy = bpy
+
+    def __enter__(self):
+        bpy = self.bpy
+        self.black = bpy.data.materials.new("SEMANTIC_BLACK")
+        self.black.use_nodes = True
+        nt = self.black.node_tree
+        nt.nodes.clear()
+        emit = nt.nodes.new("ShaderNodeEmission")
+        emit.inputs["Color"].default_value = (0.0, 0.0, 0.0, 1.0)
+        out = nt.nodes.new("ShaderNodeOutputMaterial")
+        nt.links.new(emit.outputs["Emission"], out.inputs["Surface"])
+        self.variants = {}
+        self.swapped = []
+        for ob in bpy.data.objects:
+            for slot in getattr(ob, "material_slots", ()):
+                mat = slot.material
+                if mat is None:
+                    continue
+                var = self.variants.get(mat.name)
+                if var is None:
+                    var = self.variants[mat.name] = _semantic_variant(bpy, mat, self.black)
+                self.swapped.append((slot, mat))
+                slot.material = var
+        return self
+
+    def __exit__(self, *exc):
+        bpy = self.bpy
+        for slot, mat in reversed(self.swapped):
+            slot.material = mat
+        for var in self.variants.values():
+            if var is not self.black:
+                bpy.data.materials.remove(var)
+        bpy.data.materials.remove(self.black)
+        return False
+
+
 def _set_if_present(node, socket, value):
     if socket in node.inputs:
         node.inputs[socket].default_value = value
