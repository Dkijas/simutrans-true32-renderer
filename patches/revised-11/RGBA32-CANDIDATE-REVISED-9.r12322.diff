+static bool simgraph32_init(scr_size window_size, sint16 full_screen)
+{
+	disp_actual_width = window_size.w;
+	disp_height       = window_size.h;
+
+	// let the backend open the window and tell us the real pitch
+	disp_width = dr_os_open(window_size, full_screen);
+	if(  disp_width <= 0  ) {
+		dr_fatal_notify( "Cannot open window!" );
+		return false;
+	}
+
+	textur = dr_textur_init();
+	if(  textur == NULL  ) {
+		dr_fatal_notify( "Cannot allocate 32 bit framebuffer!" );
+		return false;
+	}
+
+	// init, load, and check fonts. simgraph16_init() has always done this here,
+	// and doing it here is what matters: later on the working directory is the
+	// user directory, where the relative fallback below cannot resolve. Without
+	// it a 32 bit build can end up with no font at all - panels and buttons draw,
+	// because they are boxes, and no text does.
+	if (!gfx->load_font(env_t::fontname.c_str(), false)) {
+		env_t::fontname = dr_get_system_font();
+		if (!gfx->load_font(env_t::fontname.c_str(), false)) {
+			env_t::fontname = FONT_PATH_X "cyr.bdf";
+			if (!gfx->load_font(env_t::fontname.c_str(), false)) {
+				dr_fatal_notify("No fonts found!");
+				return false;
+			}
+		}
+	}
+
+	init_colour_tables();
+	dirty_state_alloc();
+
+	// The clipping state is a zeroed static, so without this every drawing
+	// operation is clipped against an empty rectangle and nothing reaches the
+	// framebuffer. simgraph16_init() has always ended with this line; leaving
+	// it out here made the first window black until something else set a clip.
+	simgraph32_set_clip_rect( 0, 0, disp_width, disp_height  CLIP_NUM_DEFAULT, false );
+
+	return true;
+}
