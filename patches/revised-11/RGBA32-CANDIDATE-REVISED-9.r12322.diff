+					}
+					has_alpha = TRANSPARENT_RUN;
+				}
+				else if(  pixval < 0x8020  &&  has_alpha  ) {
+					if(  count  ) {
+						*enc++ = count+TRANSPARENT_RUN;
+						enc += count;
+						count = 0;
+						*enc++ = TRANSPARENT_RUN;
+					}
+					has_alpha = 0;
+				}
+				count++;
+				enc[count] = pixval;
+			}
