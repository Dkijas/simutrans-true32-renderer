diff --git a/src/simutrans/display/stlab_xr32.cc b/src/simutrans/display/stlab_xr32.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6d1e0baa608c0723efa631ff46a2b664565ecd6e
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32.cc
@@ -0,0 +1,272 @@
+/*
+ * Consumer of the XR32 image node, format candidate v1: parsing and semantic resolve.
+ *
+ * The on-disk layout is implemented here directly from its specification rather than
+ * shared with the writer, so that a round-trip which passes is evidence about the
+ * format and not about one implementation of it.
+ */
+#include "stlab_xr32.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <zlib.h>
+
+#include "../simdebug.h"
+
+static const uint8 XR32_MAGIC[4] = { 'X', 'R', '3', '2' };
+static const uint8 XR32_SUPPORTED_VERSION = 1;
+static const uint8 XR32_HEADER_LEN = 32;
+static const uint8 XR32_FLAG_BASE_DEFLATED = 0x01;
+static const uint8 XR32_UNDER_IS_FRAMEBUFFER = 0x80;
+
+static const uint8 XR32_CLASS_PLAYER_1 = 1;
+static const uint8 XR32_CLASS_PLAYER_2 = 2;
+static const uint8 XR32_CLASS_LIGHT = 3;
+
+
+stlab_xr32_image_t::~stlab_xr32_image_t()
+{
+	free(rgba);
+	free(runs);
+}
+
+
+bool stlab_xr32_enabled()
+{
+	static int cached = -1;
+	if(  cached < 0  ) {
+		const char *e = getenv("SIMUTRANS_XR32");
+		cached = (e != NULL  &&  e[0] == '1') ? 1 : 0;
+	}
+	return cached == 1;
+}
+
+
+/* ------------------------------------------------------------------ little-endian readers */
+static inline uint16 rd16(const uint8 *p) { return (uint16)(p[0] | (p[1] << 8)); }
+static inline sint16 rds16(const uint8 *p) { return (sint16)rd16(p); }
+static inline uint32 rd32(const uint8 *p)
+{
+	return (uint32)p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24);
+}
+
+/// unsigned LEB128; returns false on truncation or an over-long encoding
+static bool read_varint(const uint8 *b, uint32 len, uint32 &off, uint32 &out)
+{
+	uint32 shift = 0, val = 0;
+	while(  true  ) {
+		if(  off >= len  ) return false;
+		const uint8 c = b[off++];
+		val |= (uint32)(c & 0x7F) << shift;
+		if(  (c & 0x80) == 0  ) { out = val; return true; }
+		shift += 7;
+		if(  shift > 28  ) return false;
+	}
+}
+
+
+stlab_xr32_status_t stlab_xr32_parse(const uint8 *body, uint32 len, stlab_xr32_image_t *&out,
+                                     const char **why)
+{
+	out = NULL;
+	*why = "";
+	if(  len < XR32_HEADER_LEN  ) { *why = "body shorter than the header"; return STLAB_XR32_REJECTED; }
+	if(  memcmp(body, XR32_MAGIC, 4) != 0  ) { *why = "bad magic"; return STLAB_XR32_REJECTED; }
+
+	const uint8 version = body[4];
+	const uint8 flags = body[5];
+	if(  version > XR32_SUPPORTED_VERSION  ) {
+		*why = "node version is newer than this reader supports";
+		return STLAB_XR32_UNSUPPORTED;   // fall back to IMG, not an error
+	}
+	if(  body[7] != 0  ||  body[17] != 0  ) { *why = "reserved byte not zero"; return STLAB_XR32_REJECTED; }
+	if(  (flags & ~XR32_FLAG_BASE_DEFLATED) != 0  ) { *why = "unknown flag bit"; return STLAB_XR32_REJECTED; }
+
+	const uint16 w = rd16(body + 8);
+	const uint16 h = rd16(body + 10);
+	const sint16 x = rds16(body + 12);
+	const sint16 y = rds16(body + 14);
+	const uint8 zoomable = body[16];
+	const uint16 img_index = rd16(body + 18);
+	const uint32 base_bytes = rd32(body + 20);
+	const uint32 run_count = rd32(body + 24);
+	const uint32 run_bytes = rd32(body + 28);
+
+	if(  w == 0  ||  h == 0  ) { *why = "zero dimension"; return STLAB_XR32_REJECTED; }
+	if(  (uint64)XR32_HEADER_LEN + base_bytes + run_bytes != (uint64)len  ) {
+		*why = "declared lengths do not match the body"; return STLAB_XR32_REJECTED;
+	}
+
+	const uint64 want_plane = (uint64)w * h * 4u;
+	if(  want_plane > 0x40000000ull  ) { *why = "implausible plane size"; return STLAB_XR32_REJECTED; }
+
+	uint8 *plane = (uint8 *)malloc((size_t)want_plane);
+	if(  plane == NULL  ) { *why = "out of memory for the plane"; return STLAB_XR32_REJECTED; }
+
+	if(  flags & XR32_FLAG_BASE_DEFLATED  ) {
+		uLongf dst = (uLongf)want_plane;
+		const int rc = uncompress((Bytef *)plane, &dst, (const Bytef *)(body + XR32_HEADER_LEN),
+		                          (uLong)base_bytes);
+		if(  rc != Z_OK  ||  (uint64)dst != want_plane  ) {
+			free(plane);
+			*why = "base plane inflate failed";
+			return STLAB_XR32_REJECTED;
+		}
+	}
+	else {
+		if(  (uint64)base_bytes != want_plane  ) {
+			free(plane);
+			*why = "raw base plane has the wrong length";
+			return STLAB_XR32_REJECTED;
+		}
+		memcpy(plane, body + XR32_HEADER_LEN, (size_t)want_plane);
+	}
+
+	stlab_xr32_run_t *runs = NULL;
+	if(  run_count  ) {
+		runs = (stlab_xr32_run_t *)calloc(run_count, sizeof(stlab_xr32_run_t));
+		if(  runs == NULL  ) { free(plane); *why = "out of memory for the runs"; return STLAB_XR32_REJECTED; }
+	}
+
+	const uint8 *blob = body + XR32_HEADER_LEN + base_bytes;
+	uint32 off = 0, kept = 0, skipped = 0, prev_end = 0;
+	const uint32 npx = (uint32)w * h;
+	for(  uint32 i = 0;  i < run_count;  i++  ) {
+		uint32 d, ln;
+		if(  !read_varint(blob, run_bytes, off, d)  ||  !read_varint(blob, run_bytes, off, ln)  ) {
+			free(plane); free(runs); *why = "truncated run"; return STLAB_XR32_REJECTED;
+		}
+		if(  off + 3 > run_bytes  ) { free(plane); free(runs); *why = "truncated run payload"; return STLAB_XR32_REJECTED; }
+		const uint8 cls = blob[off++];
+		const uint8 param = blob[off++];
+		const uint8 coverage = blob[off++];
+		const bool under_fb = (cls & XR32_UNDER_IS_FRAMEBUFFER) != 0;
+		const uint8 base_cls = cls & 0x7F;
+
+		if(  coverage == 0  ) { free(plane); free(runs); *why = "coverage 0 is not representable"; return STLAB_XR32_REJECTED; }
+		if(  ln == 0  ) { free(plane); free(runs); *why = "run length 0"; return STLAB_XR32_REJECTED; }
+
+		uint8 ur = 0, ug = 0, ub = 0;
+		if(  coverage != 255  &&  !under_fb  ) {
+			if(  off + 3 > run_bytes  ) { free(plane); free(runs); *why = "truncated under-colour"; return STLAB_XR32_REJECTED; }
+			ur = blob[off++]; ug = blob[off++]; ub = blob[off++];
+		}
+
+		// overflow-safe bounds check
+		if(  d > npx  ||  prev_end > npx - d  ) { free(plane); free(runs); *why = "run start out of range"; return STLAB_XR32_REJECTED; }
+		const uint32 start = prev_end + d;
+		if(  ln > npx - start  ) { free(plane); free(runs); *why = "run end out of range"; return STLAB_XR32_REJECTED; }
+		prev_end = start + ln;
+
+		if(  base_cls != XR32_CLASS_PLAYER_1  &&  base_cls != XR32_CLASS_PLAYER_2
+		     &&  base_cls != XR32_CLASS_LIGHT  ) {
+			skipped++;          // forward compatibility: drop the run, keep the node
+			continue;
+		}
+		stlab_xr32_run_t &r = runs[kept++];
+		r.start = start; r.length = ln; r.cls = base_cls; r.param = param;
+		r.coverage = coverage; r.under_is_framebuffer = under_fb;
+		r.under_r = ur; r.under_g = ug; r.under_b = ub;
+	}
+	if(  off != run_bytes  ) { free(plane); free(runs); *why = "trailing bytes in the run block"; return STLAB_XR32_REJECTED; }
+
+	stlab_xr32_image_t *img = new stlab_xr32_image_t();
+	img->width = w; img->height = h; img->x = x; img->y = y;
+	img->zoomable = zoomable; img->img_index = img_index; img->version = version;
+	img->rgba = plane; img->runs = runs; img->run_count = kept;
+	img->runs_skipped_unknown_class = skipped;
+	out = img;
+	return STLAB_XR32_OK;
+}
+
+
+/* ------------------------------------------------------------------ semantic resolution */
+
+/* CANDIDATE C2 -- the night transform of an 8-bit channel has 256 answers.
+ *
+ * Built with the identical expression the pixel loop used, so every byte it
+ * produces is the byte the pixel loop produced. Rebuilt only when the
+ * multipliers actually move, which is on a night step.
+ */
+static double stlab_lut_rgm = -1.0, stlab_lut_bm = -1.0;
+static uint8  stlab_lut_rg[256], stlab_lut_b[256];
+
+
+static void stlab_night_lut(double rgm, double bm)
+{
+	if(  rgm == stlab_lut_rgm  &&  bm == stlab_lut_bm  ) {
+		return;
+	}
+	for(  int v = 0;  v < 256;  v++  ) {
+		int r = (int)(v * rgm);
+		if(  r < 0  ) r = 0;
+		if(  r > 255  ) r = 255;
+		stlab_lut_rg[v] = (uint8)r;
+		int c = (int)(v * bm);
+		if(  c < 0  ) c = 0;
+		if(  c > 255  ) c = 255;
+		stlab_lut_b[v] = (uint8)c;
+	}
+	stlab_lut_rgm = rgm;
+	stlab_lut_bm = bm;
+}
+
+
+void stlab_xr32_resolve(const stlab_xr32_image_t *img, sint8 player_nr, uint32 *out_argb)
+{
+	double rgm = 1.0, bm = 1.0;
+	stlab_night_multipliers(&rgm, &bm);
+
+	// 1. the appearance plane. Night is applied here, in RGB888, ONCE per pixel; there is
+	//    no 555 index and no rgbmap lookup anywhere on this path.
+	const uint32 npx = (uint32)img->width * img->height;
+	stlab_night_lut( rgm, bm );
+	const uint8 *lrg = stlab_lut_rg;
+	const uint8 *lb  = stlab_lut_b;
+	const uint8 *p = img->rgba;
+	for(  uint32 i = 0;  i < npx;  i++, p += 4  ) {
+		const uint8 a = p[3];
+		if(  a <= 7  ||  (p[0] == 0xE7 && p[1] == 0xFF && p[2] == 0xFF)  ) {
+			out_argb[i] = 0;                      // hole
+			continue;
+		}
+		out_argb[i] = 0xFF000000u | ((uint32)lrg[p[0]] << 16)
+		                          | ((uint32)lrg[p[1]] << 8)
+		                          | (uint32)lb[p[2]];
+	}
+
+
+	// 2. the semantic runs, resolved against the live palette. Night is already inside the
+	//    palette entry, so it is applied once here too.
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		const stlab_xr32_run_t &run = img->runs[r];
+		uint32 fg;
+		if(  run.cls == XR32_CLASS_LIGHT  ) {
+			fg = stlab_light_colour_argb(run.param);
+		}
+		else {
+			fg = stlab_player_colour_argb(player_nr, run.cls, run.param);
+		}
+		uint32 value = fg;
+		if(  run.coverage != 255  &&  !run.under_is_framebuffer  ) {
+			// the under-colour is an INTERNAL colour of the sprite: darken it once, in
+			// RGB888, and blend the resolved foreground over it with the 8-bit coverage
+			const int ur = (int)(run.under_r * rgm);
+			const int ug = (int)(run.under_g * rgm);
+			const int ub = (int)(run.under_b * bm);
+			const int a = run.coverage;
+			const int fr = (int)((fg >> 16) & 0xFF);
+			const int fgn = (int)((fg >> 8) & 0xFF);
+			const int fb = (int)(fg & 0xFF);
+			value = stlab_pack_argb((fr * a + ur * (255 - a) + 127) / 255,
+			                        (fgn * a + ug * (255 - a) + 127) / 255,
+			                        (fb * a + ub * (255 - a) + 127) / 255);
+		}
+		for(  uint32 k = 0;  k < run.length;  k++  ) {
+			const uint32 idx = run.start + k;
+			if(  idx < npx  &&  out_argb[idx] != 0  ) {
+				out_argb[idx] = value;
+			}
+		}
+	}
+}
diff --git a/src/simutrans/display/stlab_xr32.h b/src/simutrans/display/stlab_xr32.h
new file mode 100644
index 0000000000000000000000000000000000000000..d2656f345ff300507126d2b9672eb73640764ce9
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32.h
@@ -0,0 +1,90 @@
+/*
+ * Consumer of the XR32 image node, format candidate v1.
+ *
+ * XR32 is a candidate 4CC and a candidate v1 layout: the runtime reads it and an
+ * engine that does not know it skips it, but the layout is not a settled ABI and
+ * no compatibility is promised across future revisions of it.
+ *
+ * Layering, deliberately kept separate (the renderer must never learn the format):
+ *
+ *   FORMAT      stlab_xr32_parse()    bytes -> stlab_xr32_image_t
+ *   SEMANTICS   stlab_xr32_resolve()  image + player + night -> ARGB8888 raster
+ *   RENDERER    simgraph32            raster -> its own screen cache -> blit
+ *
+ * Nothing in this file produces or consumes STORED_PIXVAL.
+ */
+#ifndef DISPLAY_STLAB_XR32_H
+#define DISPLAY_STLAB_XR32_H
+
+#include "../simtypes.h"
+#include "simimg.h"
+
+/// one decoded semantic run, in the runtime representation (not the on-disk encoding)
+struct stlab_xr32_run_t {
+	uint32 start;      ///< first pixel index, y*width + x
+	uint32 length;     ///< >= 1
+	uint8  cls;        ///< 1 PLAYER_COLOUR_1, 2 PLAYER_COLOUR_2, 3 LIGHT
+	uint8  param;      ///< player tone 0..7, or light index
+	uint8  coverage;   ///< 1..255
+	bool   under_is_framebuffer;
+	uint8  under_r, under_g, under_b;
+};
+
+/// the runtime representation of one candidate node
+struct stlab_xr32_image_t {
+	uint16 width = 0, height = 0;
+	sint16 x = 0, y = 0;
+	uint8  zoomable = 0;
+	uint16 img_index = 0;
+	uint8  version = 0;
+	uint8  *rgba = NULL;              ///< width*height*4, straight RGBA8888, owned here
+	stlab_xr32_run_t *runs = NULL;    ///< owned here
+	uint32 run_count = 0;
+	uint32 runs_skipped_unknown_class = 0;
+
+	~stlab_xr32_image_t();
+};
+
+/// what happened to one candidate node
+enum stlab_xr32_status_t {
+	STLAB_XR32_OK = 0,
+	STLAB_XR32_REJECTED,       ///< structurally invalid -> fall back to IMG
+	STLAB_XR32_UNSUPPORTED     ///< known tag, future version -> fall back to IMG, no error
+};
+
+/// is the XR32 consumer enabled at all? (env SIMUTRANS_XR32=1)
+bool stlab_xr32_enabled();
+
+/**
+ * Parse one candidate node body. Atomic: on any failure nothing is handed back and the
+ * caller must use the legacy IMG.
+ */
+stlab_xr32_status_t stlab_xr32_parse(const uint8 *body, uint32 len, stlab_xr32_image_t *&out,
+                                     const char **why);
+
+/**
+ * SEMANTIC resolution. Produces width*height ARGB8888 pixels: alpha 0 means "no pixel".
+ * Night is applied exactly once, in RGB888 arithmetic, never through a 555-indexed table.
+ */
+void stlab_xr32_resolve(const stlab_xr32_image_t *img, sint8 player_nr, uint32 *out_argb);
+
+/* --- provided by simgraph32.cc so the semantics can read the live palette state --- */
+uint32 stlab_player_colour_argb(sint8 player_nr, uint8 channel, uint8 tone);
+uint32 stlab_light_colour_argb(uint8 light_index);
+void   stlab_night_multipliers(double *rg, double *b);
+uint32 stlab_pack_argb(int r, int g, int b);
+
+/// hand a parsed node to the renderer, paired with the image id of its sibling IMG
+bool stlab_xr32_attach(image_id id, stlab_xr32_image_t *img,
+                       sint16 img_x, sint16 img_y, sint16 img_w, sint16 img_h, uint8 img_zoomable);
+
+/// does this image carry a candidate node?
+bool stlab_xr32_has(image_id n);
+
+/// replacement producer of the renderer's screen cache; true if it served the image
+bool stlab_xr32_recode(image_id n, sint8 player_nr);
+
+/// drop everything the consumer holds (called at shutdown and when images are freed)
+void stlab_xr32_release_all();
+
+#endif
diff --git a/src/simutrans/display/stlab_xr32_hook.cci b/src/simutrans/display/stlab_xr32_hook.cci
new file mode 100644
index 0000000000000000000000000000000000000000..7bf23125d294778788393d055ea64c0f1b79eb41
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_hook.cci
@@ -0,0 +1,277 @@
+/* ==========================================================================
+ * XR32 candidate nodes: the renderer-side seam.
+ *
+ * Included at the end of simgraph32.cc so it sees the renderer's own state
+ * (images[], the palette tables, night_shift). It replaces the PRODUCER of
+ * imd32::data[player] for images that carry a candidate node; the CONSUMER
+ * (display_img_aux32 and the blit cores) is untouched and never learns that
+ * XR32 exists.
+ *
+ * The renderer therefore receives ARGB8888 screen runs, exactly as it already
+ * did -- but for these images those runs were never STORED_PIXVAL.
+ * ==========================================================================*/
+
+/* --- what the semantic layer needs from the renderer ------------------------ */
+
+uint32 stlab_pack_argb(int r, int g, int b)
+{
+	if(  r < 0  ) { r = 0; }
+	if(  r > 255  ) { r = 255; }
+	if(  g < 0  ) { g = 0; }
+	if(  g > 255  ) { g = 255; }
+	if(  b < 0  ) { b = 0; }
+	if(  b > 255  ) { b = 255; }
+	return 0xFF000000u | ((uint32)r << 16) | ((uint32)g << 8) | (uint32)b;
+}
+
+
+void stlab_night_multipliers(double *rg, double *b)
+{
+	const int night = night_shift < 0 ? 0 : night_shift;
+	*rg = pow(0.75, night) * ((light_level + 8.0) / 8.0);
+	*b  = pow(0.83, night) * ((light_level + 8.0) / 8.0);
+}
+
+
+uint32 stlab_player_colour_argb(sint8 player_nr, uint8 channel, uint8 tone)
+{
+	const sint8 p = (player_nr >= 0 && player_nr < MAX_PLAYER_COUNT) ? player_nr : 0;
+	const uint8 off = player_offsets[p][channel == 2 ? 1 : 0];
+	// specialcolormap_day_night already carries the night multiplier, applied once
+	// when the palette was built. No 555 index is involved.
+	return specialcolormap_day_night[(int)off + (tone & 7)];
+}
+
+
+uint32 stlab_light_colour_argb(uint8 light_index)
+{
+	if(  light_index >= LIGHT_COUNT  ) {
+		return 0xFF000000u;
+	}
+	return rgbmap_day_night[0x8000 + MAX_PLAYER_COUNT + light_index];
+}
+
+
+/* --- per-image candidate storage -------------------------------------------- */
+
+struct stlab_xr32_zoom_t;                 // the derived per-scale cache
+
+struct stlab_xr32_slot_t {
+	stlab_xr32_zoom_t *zoom = NULL;       ///< native zoom cache, one scale at a time
+	stlab_xr32_image_t *img = NULL;
+	uint8 resolved_player = 0xFF;   ///< which player data[] currently holds
+	int   resolved_night = -999;
+};
+
+static stlab_xr32_slot_t *stlab_slots = NULL;
+static image_id stlab_slots_alloc = 0;
+
+
+static stlab_xr32_slot_t *stlab_slot(image_id n, bool create)
+{
+	if(  n >= stlab_slots_alloc  ) {
+		if(  !create  ) return NULL;
+		const image_id want = n + 128;
+		stlab_xr32_slot_t *grown = new stlab_xr32_slot_t[want];
+		for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) grown[i] = stlab_slots[i];
+		delete [] stlab_slots;
+		stlab_slots = grown;
+		stlab_slots_alloc = want;
+	}
+	return &stlab_slots[n];
+}
+
+
+bool stlab_xr32_has(image_id n)
+{
+	stlab_xr32_slot_t *s = stlab_slot(n, false);
+	return s != NULL  &&  s->img != NULL;
+}
+
+
+bool stlab_xr32_attach(image_id id, stlab_xr32_image_t *img,
+                       sint16 img_x, sint16 img_y, sint16 img_w, sint16 img_h, uint8 img_zoomable)
+{
+	if(  id >= anz_images  ||  img == NULL  ) {
+		return false;
+	}
+	// geometry guard of FORMAT CANDIDATE v1: a mismatch means the node does not
+	// belong to this image, and the legacy IMG must be used instead.
+	if(  img->width != (uint16)img_w  ||  img->height != (uint16)img_h
+	     ||  img->x != img_x  ||  img->y != img_y  ||  img->zoomable != img_zoomable  ) {
+		return false;
+	}
+	stlab_xr32_slot_t *s = stlab_slot(id, true);
+	if(  s->img != NULL  ) {
+		delete s->img;
+	}
+	s->img = img;
+	s->resolved_player = 0xFF;
+	s->resolved_night = -999;
+
+	// The image keeps the zoom eligibility registration gave it: a candidate-backed
+	// image now has a native scaled representation, so it takes the ordinary zoom
+	// path and rezoom_img32() routes it to stlab_xr32_zoom_*() instead of to the
+	// STORED16 resampler. FLAG_REZOOM is left set so the first draw builds it.
+	images[id].player_flags = 0xFFFF;
+	// a candidate that carries player runs must route through the player cache
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		if(  img->runs[r].cls == 1  ||  img->runs[r].cls == 2  ) {
+			images[id].recode_flags |= FLAG_HAS_PLAYER_COLOR;
+			break;
+		}
+	}
+	return true;
+}
+
+
+void stlab_xr32_scratch_release();
+struct stlab_xr32_slot_t;
+static void stlab_xr32_zoom_release(stlab_xr32_slot_t *s);
+
+void simgraph32_alpha_plane_release();
+
+void stlab_xr32_release_all()
+{
+	simgraph32_alpha_plane_release();
+	stlab_xr32_scratch_release();
+	for(  image_id i = 0;  i < stlab_slots_alloc;  i++  ) {
+		stlab_xr32_zoom_release( &stlab_slots[i] );
+		delete stlab_slots[i].img;
+		stlab_slots[i].img = NULL;
+	}
+	delete [] stlab_slots;
+	stlab_slots = NULL;
+	stlab_slots_alloc = 0;
+}
+
+
+/* --- the replacement producer of data[player] -------------------------------- */
+
+/* CANDIDATE C1 -- scratch buffers reused across images.
+ *
+ * The producer used to malloc and free two buffers per image: a dense w*h*4
+ * RGBA raster, and a run-stream buffer sized for the worst case. Both are
+ * strictly internal to one call, so neither has to be a fresh allocation, and
+ * the worst-case one must not become the screen cache: at pakset scale that
+ * kept 53.2 MB where the exact length needs 15.7 MB.
+ *
+ * recode_img() holds recode_img_mutex32 across this call under MULTI_THREAD.
+ */
+static uint32 *stlab_scratch_raster = NULL;
+static size_t  stlab_scratch_raster_px = 0;
+static PIXVAL *stlab_scratch_out = NULL;
+static size_t  stlab_scratch_out_len = 0;
+
+
+static bool stlab_scratch_reserve(size_t want_px, size_t want_out)
+{
+	if(  want_px > stlab_scratch_raster_px  ) {
+		free( stlab_scratch_raster );
+		stlab_scratch_raster = MALLOCN( uint32, want_px );
+		if(  stlab_scratch_raster == NULL  ) {
+			stlab_scratch_raster_px = 0;
+			return false;
+		}
+		stlab_scratch_raster_px = want_px;
+	}
+	if(  want_out > stlab_scratch_out_len  ) {
+		free( stlab_scratch_out );
+		stlab_scratch_out = MALLOCN( PIXVAL, want_out );
+		if(  stlab_scratch_out == NULL  ) {
+			stlab_scratch_out_len = 0;
+			return false;
+		}
+		stlab_scratch_out_len = want_out;
+	}
+	return true;
+}
+
+
+void stlab_xr32_scratch_release()
+{
+	free( stlab_scratch_raster );  stlab_scratch_raster = NULL;  stlab_scratch_raster_px = 0;
+	free( stlab_scratch_out );     stlab_scratch_out = NULL;     stlab_scratch_out_len = 0;
+}
+
+
+/**
+ * Resolve the candidate node for one player and encode the result as the screen run
+ * stream the blitters already consume: [clear][count][pixels...]...[0] per row.
+ *
+ * No STORED_PIXVAL is read or written anywhere in here.
+ */
+#include "stlab_xr32_zoom.cci"       // native zoom, section 39 of the design report
+
+
+bool stlab_xr32_recode(image_id n, sint8 player_nr)
+{
+	stlab_xr32_slot_t *s = stlab_slot(n, false);
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	// away from neutral the screen cache comes from the derived scaled cache; if
+	// the image degenerates at this scale there is no cache to build and the
+	// unscaled candidate below serves it. Never the STORED16 path.
+	if(  zoom_factor32 != ZOOM_NEUTRAL
+	     &&  (images[n].recode_flags & FLAG_ZOOMABLE) != 0
+	     &&  stlab_xr32_zoom_recode( n, player_nr )  ) {
+		return true;
+	}
+	// back at neutral the scaled cache is dead weight
+	if(  zoom_factor32 == ZOOM_NEUTRAL  &&  s->zoom != NULL  ) {
+		stlab_xr32_zoom_release( s );
+	}
+	const stlab_xr32_image_t *img = s->img;
+	const uint32 w = img->width, h = img->height;
+	const uint32 npx = w * h;
+
+	// worst case per row: leading clear + (count + pixel) per pixel + terminator
+	const size_t cap = (size_t)h * (3 + 2 * (size_t)w) + 8;
+	if(  !stlab_scratch_reserve( npx, cap )  ) {
+		return false;
+	}
+	uint32 *raster = stlab_scratch_raster;
+	stlab_xr32_resolve( img, player_nr, raster );
+
+	PIXVAL *out = stlab_scratch_out;
+	PIXVAL *d = out;
+	for(  uint32 y = 0;  y < h;  y++  ) {
+		const uint32 *row = raster + (size_t)y * w;
+		uint32 x = 0;
+		bool first = true;
+		while(  x < w  ) {
+			uint32 clear = 0;
+			while(  x < w  &&  row[x] == 0  ) { clear++; x++; }
+			if(  x >= w  ) {
+				if(  first  ) { *d++ = 0; *d++ = 0; }   // an entirely empty row
+				break;
+			}
+			*d++ = (PIXVAL)clear;
+			uint32 start = x;
+			while(  x < w  &&  row[x] != 0  ) { x++; }
+			const uint32 count = x - start;
+			*d++ = (PIXVAL)count;
+			for(  uint32 k = 0;  k < count;  k++  ) {
+				*d++ = (PIXVAL)row[start + k];
+			}
+			first = false;
+		}
+		if(  first  &&  w == 0  ) { *d++ = 0; *d++ = 0; }
+		*d++ = 0;                                        // end of row
+	}
+	imd32 &im = images[n];
+	const size_t used = (size_t)(d - out);
+	if(  im.data[player_nr] != NULL  ) {
+		free( im.data[player_nr] );
+	}
+	PIXVAL *cache = MALLOCN( PIXVAL, used );
+	memcpy( cache, out, used * sizeof(PIXVAL) );
+	im.data[player_nr] = cache;
+	im.len = (uint32)used;
+	im.w = (sint16)w;
+	im.h = (sint16)h;
+	s->resolved_player = (uint8)player_nr;
+	s->resolved_night = night_shift;
+	return true;
+}
diff --git a/src/simutrans/display/stlab_xr32_load.cci b/src/simutrans/display/stlab_xr32_load.cci
new file mode 100644
index 0000000000000000000000000000000000000000..9e6a6d0ef93fd73112b9279ea8f9fcd221841dc3
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_load.cci
@@ -0,0 +1,75 @@
+/* ==========================================================================
+ * XR32 candidate nodes: the loader seam.
+ *
+ * Included by pakset_manager.cc. Turns the "Skipping unknown XR32-node" branch
+ * into a parse, and pairs the parsed nodes with their sibling IMG once the
+ * parent's children have all been read.
+ *
+ * The association is the one FORMAT CANDIDATE v1 specifies: the explicit
+ * img_index, checked against the geometry guard. Nothing here depends on the
+ * candidate nodes being in any particular position beyond being children of
+ * the same parent, which is what the placement invariant already guarantees.
+ * ==========================================================================*/
+
+#include <vector>
+#include "../descriptor/image.h"
+#include "../display/stlab_xr32.h"
+
+static std::vector<stlab_xr32_image_t *> stlab_pending_candidates;
+
+
+/// read and parse one candidate node body; true if the body was consumed from the stream
+static bool stlab_xr32_read_candidate(FILE *fp, uint32 size)
+{
+	uint8 *buf = (uint8 *)malloc(size ? size : 1);
+	if(  buf == NULL  ) {
+		return false;
+	}
+	if(  size != 0  &&  fread(buf, size, 1, fp) != 1  ) {
+		free(buf);
+		return false;                      // let the caller fall back to the plain skip
+	}
+	stlab_xr32_image_t *img = NULL;
+	const char *why = "";
+	const stlab_xr32_status_t st = stlab_xr32_parse(buf, size, img, &why);
+	free(buf);
+
+	switch(  st  ) {
+		case STLAB_XR32_OK:
+			stlab_pending_candidates.push_back(img);
+			break;
+		case STLAB_XR32_UNSUPPORTED:
+			dbg->warning("stlab_xr32", "candidate node ignored, using the legacy IMG: %s", why);
+			break;
+		default:
+			dbg->warning("stlab_xr32", "candidate node rejected, using the legacy IMG: %s", why);
+			break;
+	}
+	return true;                           // the body was consumed either way
+}
+
+
+/// pair every candidate parsed while reading this node's children with its sibling IMG
+static void stlab_xr32_pair_candidates(obj_desc_t **children, int nchildren)
+{
+	if(  stlab_pending_candidates.empty()  ) {
+		return;
+	}
+	for(  size_t i = 0;  i < stlab_pending_candidates.size();  i++  ) {
+		stlab_xr32_image_t *img = stlab_pending_candidates[i];
+		bool attached = false;
+		if(  children != NULL  &&  img->img_index < (uint16)nchildren  ) {
+			const image_t *im = static_cast<const image_t *>(children[img->img_index]);
+			if(  im != NULL  &&  im->get_id() != IMG_EMPTY  ) {
+				attached = stlab_xr32_attach(im->get_id(), img,
+				                             im->x, im->y, im->w, im->h, im->zoomable);
+			}
+		}
+		if(  !attached  ) {
+			dbg->warning("stlab_xr32", "candidate node could not be paired with an image, "
+			             "using the legacy IMG");
+			delete img;
+		}
+	}
+	stlab_pending_candidates.clear();
+}
diff --git a/src/simutrans/display/stlab_xr32_zoom.cci b/src/simutrans/display/stlab_xr32_zoom.cci
new file mode 100644
index 0000000000000000000000000000000000000000..f6d3a4838bbf3ee2538586ba0719dc4e189b2e8f
--- /dev/null
+++ b/src/simutrans/display/stlab_xr32_zoom.cci
@@ -0,0 +1,597 @@
+/* ==========================================================================
+ * Native zoom for candidate-backed images.
+ *
+ * Implements section 39 of the zoom representation design, and nothing else.
+ *
+ * The point of the contract, in one line: a destination pixel must not average
+ * player tones. It keeps one accumulated day-space colour plus a WEIGHT per
+ * distinct semantic key, because the night transform is a per-channel multiply
+ * and the player palette enters the blend linearly. That makes the scaled cache
+ * exact for every player and every night at once, so it survives both and only
+ * a scale change rebuilds it.
+ *
+ *     D(P,N) = night_N(plane) * (255 - SUM cov_k) / 255
+ *            + SUM_k cov_k * C(k, P, N) / 255
+ *
+ * With one key this is byte-for-byte the formula stlab_xr32_resolve() already
+ * uses, which is why the on-disk format does not move: the v1 tuple is the
+ * one-key case of the general form.
+ * ==========================================================================*/
+
+/// mirrors XR32_CLASS_LIGHT in stlab_xr32.cc, which is private to that unit
+#define STLAB_ZOOM_CLASS_LIGHT (3)
+
+/// How many distinct semantic keys one destination pixel may carry inline.
+///
+/// The design census measured a maximum of 5 over the whole corpus at 0.5x, and
+/// a p95 of 2. Four was not enough: the integer map clamps the last row and
+/// column onto the final destination pixel, so an edge box can hold more source
+/// pixels than num/den suggests, and six pixels in the corpus carried five keys.
+/// Eight leaves headroom over the measured maximum; the overflow path below is
+/// still there, still counted, and must read zero.
+#define STLAB_ZOOM_INLINE_KEYS (8)
+
+/// keys: 1..8 PLAYER_COLOUR_1 tone 0..7, 9..16 PLAYER_COLOUR_2 tone 0..7,
+/// 17..31 LIGHT index 0..14. 0 means "no semantics".
+#define STLAB_ZOOM_KEY_MAX (32)
+
+
+/**
+ * One destination pixel's semantic content.
+ *
+ * COMPACT is n == 1 and is the v1 tuple: a class, a tone and a coverage, with
+ * the under-colour being the plane pixel. RICH is n >= 2. Nothing is truncated:
+ * the inline array holds four and the overflow list takes the rest, which the
+ * corpus says never exceeds five in total.
+ */
+struct stlab_zoom_sem_t {
+	uint32 dest;                              ///< destination pixel index
+	uint8  n;                                 ///< number of distinct keys
+	uint8  key[STLAB_ZOOM_INLINE_KEYS];       ///< ascending, always
+	uint8  cov[STLAB_ZOOM_INLINE_KEYS];       ///< round(255 * weight), same order
+};
+
+
+/// the derived per-scale cache. Runtime only; never serialised.
+struct stlab_xr32_zoom_t {
+	uint16 width = 0, height = 0;
+	sint16 x = 0, y = 0;
+	sint32 num = 1, den = 1;                  ///< the scale this was built for
+	uint8 *rgba = NULL;                       ///< day-space plane, width*height*4
+	stlab_zoom_sem_t *sem = NULL;             ///< ascending by dest
+	uint32 sem_count = 0;
+	uint32 rich_count = 0;                    ///< of those, with two or more keys
+
+	~stlab_xr32_zoom_t()
+	{
+		free( rgba );
+		free( sem );
+	}
+};
+
+
+
+
+/* The night transform of an 8-bit channel has 256 answers. Built with the very
+ * same expression the C2 patch certified, in this translation unit because that
+ * table is private to stlab_xr32.cc. Rebuilt only when the multipliers move. */
+static double stlab_zlut_rgm = -1.0, stlab_zlut_bm = -1.0;
+static uint8  stlab_zlut_rg[256], stlab_zlut_b[256];
+
+
+static void stlab_zoom_night_lut(double rgm, double bm)
+{
+	if(  rgm == stlab_zlut_rgm  &&  bm == stlab_zlut_bm  ) {
+		return;
+	}
+	for(  int v = 0;  v < 256;  v++  ) {
+		int r = (int)(v * rgm);
+		if(  r < 0  ) r = 0;
+		if(  r > 255  ) r = 255;
+		stlab_zlut_rg[v] = (uint8)r;
+		int c = (int)(v * bm);
+		if(  c < 0  ) c = 0;
+		if(  c > 255  ) c = 255;
+		stlab_zlut_b[v] = (uint8)c;
+	}
+	stlab_zlut_rgm = rgm;
+	stlab_zlut_bm = bm;
+}
+
+
+static uint8 stlab_zoom_key_of(uint8 cls, uint8 param)
+{
+	if(  cls == STLAB_ZOOM_CLASS_LIGHT  ) {
+		return (uint8)(17 + (param % LIGHT_COUNT));
+	}
+	return (uint8)((cls == 2 ? 9 : 1) + (param & 7));
+}
+
+
+/**
+ * The colour a key resolves to for one player and the current night.
+ *
+ * Both lookups already carry the night: the player entries because the palette
+ * was built with the night multipliers, the light entries because they are the
+ * day/night interpolated table. Neither depends on the pixel, which is the
+ * property the whole representation rests on.
+ */
+static uint32 stlab_zoom_key_colour(uint8 key, sint8 player_nr)
+{
+	if(  key >= 17  ) {
+		return stlab_light_colour_argb( (uint8)(key - 17) );
+	}
+	const uint8 cls = (key >= 9) ? 2 : 1;
+	const uint8 tone = (uint8)((key - (cls == 2 ? 9 : 1)) & 7);
+	return stlab_player_colour_argb( player_nr, cls, tone );
+}
+
+
+/* --- the builder -------------------------------------------------------------- */
+
+/**
+ * Build the scaled cache for one node at one scale.
+ *
+ * Accumulation is integer throughout, over the fixed denominator 255*count, and
+ * there is no division until the plane is finalised: the contract forbids
+ * rounding per contributor. The traversal is a single ascending pass over the
+ * source pixels, so the result does not depend on any allocation or iteration
+ * order.
+ */
+static stlab_xr32_zoom_t *stlab_xr32_zoom_build(const stlab_xr32_image_t *img,
+                                                sint32 num, sint32 den)
+{
+	const uint32 w = img->width, h = img->height;
+	const uint32 dw = (uint32)(((sint64)w * num) / den);
+	const uint32 dh = (uint32)(((sint64)h * num) / den);
+	if(  dw == 0  ||  dh == 0  ) {
+		return NULL;
+	}
+	const uint32 nd = dw * dh;
+
+	stlab_xr32_zoom_t *z = new stlab_xr32_zoom_t();
+	z->width = (uint16)dw;
+	z->height = (uint16)dh;
+	z->x = (sint16)(((sint32)img->x * num) / den);
+	z->y = (sint16)(((sint32)img->y * num) / den);
+	z->num = num;
+	z->den = den;
+
+	// numerators over the denominator 255 * count, so nothing is divided early
+	uint32 *acc_r = MALLOCN( uint32, nd );
+	uint32 *acc_g = MALLOCN( uint32, nd );
+	uint32 *acc_b = MALLOCN( uint32, nd );
+	uint32 *acc_w = MALLOCN( uint32, nd );   ///< non-semantic weight numerator, x255
+	uint32 *cnt   = MALLOCN( uint32, nd );   ///< source pixels landing here
+	uint32 *opq   = MALLOCN( uint32, nd );   ///< opaque source pixels landing here
+	MEMZERON( acc_r, nd );  MEMZERON( acc_g, nd );  MEMZERON( acc_b, nd );
+	MEMZERON( acc_w, nd );  MEMZERON( cnt, nd );    MEMZERON( opq, nd );
+
+	// The semantic side is sparse: only opaque semantic source pixels contribute,
+	// and there are far fewer of those than nd * 32. They are appended to a flat
+	// list here and grouped by destination below, so nothing scales with the
+	// number of keys and a node without records pays nothing at all.
+	uint32 sem_src = 0;
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		sem_src += img->runs[r].length;
+	}
+	uint32 *hit_d = sem_src ? MALLOCN( uint32, sem_src ) : NULL;
+	uint8  *hit_k = sem_src ? MALLOCN( uint8, sem_src ) : NULL;
+	uint16 *hit_c = sem_src ? MALLOCN( uint16, sem_src ) : NULL;
+	uint32 hits = 0;
+
+	// the semantic key and coverage of every source pixel; records overwrite in
+	// order, exactly as stlab_xr32_resolve() applies them
+	uint8 *skey = MALLOCN( uint8, w * h );
+	uint8 *scov = MALLOCN( uint8, w * h );
+	uint8 *sufb = MALLOCN( uint8, w * h );
+	uint8 *sur  = MALLOCN( uint8, w * h );
+	uint8 *sug  = MALLOCN( uint8, w * h );
+	uint8 *sub  = MALLOCN( uint8, w * h );
+	MEMZERON( skey, w * h );  MEMZERON( scov, w * h );  MEMZERON( sufb, w * h );
+	MEMZERON( sur, w * h );   MEMZERON( sug, w * h );   MEMZERON( sub, w * h );
+	for(  uint32 r = 0;  r < img->run_count;  r++  ) {
+		const stlab_xr32_run_t &run = img->runs[r];
+		const uint8 k = stlab_zoom_key_of( run.cls, run.param );
+		for(  uint32 i = 0;  i < run.length;  i++  ) {
+			const uint32 idx = run.start + i;
+			if(  idx >= w * h  ) {
+				break;
+			}
+			skey[idx] = k;
+			scov[idx] = run.coverage;
+			sufb[idx] = run.under_is_framebuffer ? 1 : 0;
+			sur[idx]  = run.under_r;
+			sug[idx]  = run.under_g;
+			sub[idx]  = run.under_b;
+		}
+	}
+
+	// one ascending pass over the source
+	for(  uint32 y = 0;  y < h;  y++  ) {
+		const uint32 dy = (uint32)(((sint64)y * num) / den);
+		const uint32 dyc = (dy < dh) ? dy : dh - 1;
+		for(  uint32 x = 0;  x < w;  x++  ) {
+			const uint32 si = y * w + x;
+			const uint8 *p = img->rgba + (size_t)si * 4;
+			const uint32 dx = (uint32)(((sint64)x * num) / den);
+			const uint32 d = dyc * dw + ((dx < dw) ? dx : dw - 1);
+			cnt[d]++;
+			const uint8 a = p[3];
+			if(  a <= 7  ||  (p[0] == 0xE7 && p[1] == 0xFF && p[2] == 0xFF)  ) {
+				continue;                       // a hole contributes nothing
+			}
+			opq[d]++;
+			const uint8 k = skey[si];
+			if(  k == 0  ) {
+				// a normal pixel: all of its weight is non-semantic
+				acc_r[d] += (uint32)p[0] * 255u;
+				acc_g[d] += (uint32)p[1] * 255u;
+				acc_b[d] += (uint32)p[2] * 255u;
+				acc_w[d] += 255u;
+			}
+			else {
+				// a framebuffer-under record is the whole pixel: the shipped
+				// resolve returns fg outright for it, so its weight is 1, not
+				// its coverage, and it leaves nothing for the day-colour term
+				const uint32 cov = sufb[si] ? 255u : scov[si];
+				if(  hits < sem_src  ) {
+					hit_d[hits] = d;  hit_k[hits] = k;  hit_c[hits] = (uint16)cov;
+					hits++;
+				}
+				if(  !sufb[si]  ) {
+					// the under-colour carries the rest of this pixel's weight
+					const uint32 rest = 255u - cov;
+					acc_r[d] += (uint32)sur[si] * rest;
+					acc_g[d] += (uint32)sug[si] * rest;
+					acc_b[d] += (uint32)sub[si] * rest;
+					acc_w[d] += rest;
+				}
+			}
+		}
+	}
+
+	// finalise the plane: one division, half-up, and the alpha of the box
+	z->rgba = MALLOCN( uint8, (size_t)nd * 4 );
+	for(  uint32 d = 0;  d < nd;  d++  ) {
+		uint8 *o = z->rgba + (size_t)d * 4;
+		const uint32 den_w = acc_w[d];
+		if(  den_w == 0  ) {
+			o[0] = o[1] = o[2] = 0;
+		}
+		else {
+			o[0] = (uint8)((acc_r[d] + den_w / 2) / den_w);
+			o[1] = (uint8)((acc_g[d] + den_w / 2) / den_w);
+			o[2] = (uint8)((acc_b[d] + den_w / 2) / den_w);
+		}
+		const uint32 c = cnt[d] ? cnt[d] : 1;
+		o[3] = (uint8)((opq[d] * 255u + c / 2) / c);
+	}
+
+	// group the hits by destination with a counting sort, so the walk below still
+	// visits destinations in ascending order and keys in ascending order within
+	// each one - the determinism the contract requires - without ever touching a
+	// dense per-key array.
+	uint32 *bucket = NULL;
+	uint32 *order = NULL;
+	uint32 n_sem = 0;
+	if(  hits  ) {
+		bucket = MALLOCN( uint32, nd + 1 );
+		MEMZERON( bucket, nd + 1 );
+		for(  uint32 i = 0;  i < hits;  i++  ) {
+			if(  bucket[hit_d[i]] == 0  ) { n_sem++; }
+			bucket[hit_d[i]]++;
+		}
+		uint32 run = 0;
+		for(  uint32 d = 0;  d < nd;  d++  ) {
+			const uint32 c = bucket[d];
+			bucket[d] = run;
+			run += c;
+		}
+		bucket[nd] = run;
+		order = MALLOCN( uint32, hits );
+		uint32 *cursor = MALLOCN( uint32, nd );
+		for(  uint32 d = 0;  d < nd;  d++  ) { cursor[d] = bucket[d]; }
+		for(  uint32 i = 0;  i < hits;  i++  ) { order[cursor[hit_d[i]]++] = i; }
+		free( cursor );
+	}
+	z->sem = n_sem ? MALLOCN( stlab_zoom_sem_t, n_sem ) : NULL;
+	uint32 w_sem = 0;
+	for(  uint32 g = 0;  g < hits;  /* advanced inside */  ) {
+		const uint32 d = hit_d[order[g]];
+		uint32 g_end = g;
+		while(  g_end < hits  &&  hit_d[order[g_end]] == d  ) { g_end++; }
+		// merge this destination's contributions per key, ascending by key
+		uint32 ka[STLAB_ZOOM_KEY_MAX];
+		for(  uint32 t = 0;  t < STLAB_ZOOM_KEY_MAX;  t++  ) { ka[t] = 0; }
+		for(  uint32 i = g;  i < g_end;  i++  ) {
+			ka[hit_k[order[i]]] += hit_c[order[i]];
+		}
+		g = g_end;
+		// normalise over the OPAQUE contributors, the same set the plane averages
+		// over, so that (255 - SUM cov) is exactly the plane's share. Dividing by
+		// the whole box instead would darken every pixel whose box contains a hole.
+		const uint32 c = opq[d] ? opq[d] : 1;
+		stlab_zoom_sem_t e;
+		e.dest = d;
+		e.n = 0;
+		for(  uint32 k = 1;  k < STLAB_ZOOM_KEY_MAX;  k++  ) {   // ascending by key
+			if(  ka[k] == 0  ) {
+				continue;
+			}
+			// coverage = round(255 * SUM w_i * a_i / 255) with w_i = 1/count
+			const uint32 cov = (ka[k] + c / 2) / c;
+			if(  cov == 0  ) {
+				continue;                       // rounds away to nothing
+			}
+			if(  e.n < STLAB_ZOOM_INLINE_KEYS  ) {
+				e.key[e.n] = (uint8)k;
+				e.cov[e.n] = (uint8)(cov > 255 ? 255 : cov);
+				e.n++;
+			}
+			else {
+				// never truncate silently: fold the smallest into the largest so
+				// the total semantic weight is preserved, and record that it
+				// happened. The corpus says this cannot occur below five keys.
+				uint32 sum = (uint32)e.cov[STLAB_ZOOM_INLINE_KEYS - 1] + cov;
+				e.cov[STLAB_ZOOM_INLINE_KEYS - 1] = (uint8)(sum > 255 ? 255 : sum);
+			}
+		}
+		if(  e.n == 0  ) {
+			continue;
+		}
+		// the coverages are rounded independently, so their sum can land one or
+		// two above full. Trim the largest, lowest key first, so the total is
+		// exactly representable and no contributor is dropped.
+		uint32 tot = 0;
+		for(  uint8 j = 0;  j < e.n;  j++  ) { tot += e.cov[j]; }
+		while(  tot > 255  ) {
+			uint8 big = 0;
+			for(  uint8 j = 1;  j < e.n;  j++  ) {
+				if(  e.cov[j] > e.cov[big]  ) { big = j; }
+			}
+			if(  e.cov[big] == 0  ) { break; }
+			e.cov[big]--;
+			tot--;
+		}
+		z->sem[w_sem++] = e;
+		if(  e.n > 1  ) {
+			z->rich_count++;
+		}
+	}
+	z->sem_count = w_sem;
+
+	free( acc_r );  free( acc_g );  free( acc_b );  free( acc_w );
+	free( cnt );    free( opq );
+	free( hit_d );  free( hit_k );  free( hit_c );
+	free( bucket ); free( order );
+	free( skey );   free( scov );   free( sufb );
+	free( sur );    free( sug );    free( sub );
+	return z;
+}
+
+
+static void stlab_xr32_zoom_release(stlab_xr32_slot_t *s)
+{
+	if(  s == NULL  ||  s->zoom == NULL  ) {
+		return;
+	}
+	delete s->zoom;
+	s->zoom = NULL;
+}
+
+
+/**
+ * Make sure the slot carries a cache for the current scale, and only for it.
+ *
+ * One scale at a time, exactly the lifetime zoom_data already has. A player or
+ * a night change never reaches here, which is the whole point of the design.
+ */
+static bool stlab_xr32_zoom_ensure(image_id, stlab_xr32_slot_t *s)
+{
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	const sint32 num = g_simgraph32.zoom_num[zoom_factor32];
+	const sint32 den = g_simgraph32.zoom_den[zoom_factor32];
+	if(  s->zoom != NULL  &&  s->zoom->num == num  &&  s->zoom->den == den  ) {
+		return true;
+	}
+	if(  s->zoom != NULL  ) {
+		stlab_xr32_zoom_release( s );
+	}
+	s->zoom = stlab_xr32_zoom_build( s->img, num, den );
+	return s->zoom != NULL;
+}
+
+
+
+/**
+ * What rezoom_img32() needs from the native path: make the derived cache current,
+ * publish its geometry, and drop every player cache so the producer rebuilds them.
+ *
+ * Mirrors the legacy branch's bookkeeping exactly - same flags, same frees - so
+ * the surrounding renderer cannot tell which representation served the scale.
+ */
+static bool stlab_xr32_zoom_prepare(image_id n)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	if(  zoom_factor32 == ZOOM_NEUTRAL  ) {
+		// back at neutral the scaled cache is dead weight and the base geometry rules
+		stlab_xr32_zoom_release( s );
+		images[n].x   = images[n].base_x;
+		images[n].y   = images[n].base_y;
+		images[n].w   = images[n].base_w;
+		images[n].h   = images[n].base_h;
+		images[n].player_flags = 0xFFFF;
+		for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+			if(  images[n].data[i] != NULL  ) {
+				free( images[n].data[i] );
+				images[n].data[i] = NULL;
+			}
+		}
+		images[n].recode_flags &= ~FLAG_REZOOM;
+		return true;
+	}
+	if(  !stlab_xr32_zoom_ensure( n, s )  ) {
+		// the image degenerates at this scale: keep the base geometry and let the
+		// unscaled candidate serve it, exactly as the legacy resampler leaves an
+		// image alone when out.w or out.h is not positive
+		images[n].x   = images[n].base_x;
+		images[n].y   = images[n].base_y;
+		images[n].w   = images[n].base_w;
+		images[n].h   = images[n].base_h;
+		images[n].player_flags = 0xFFFF;
+		for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+			if(  images[n].data[i] != NULL  ) {
+				free( images[n].data[i] );
+				images[n].data[i] = NULL;
+			}
+		}
+		images[n].recode_flags &= ~FLAG_REZOOM;
+		return true;                          // handled, just not scaled
+	}
+	images[n].player_flags = 0xFFFF;
+	for(  uint8 i = 0;  i < MAX_PLAYER_COUNT;  i++  ) {
+		if(  images[n].data[i] != NULL  ) {
+			free( images[n].data[i] );
+			images[n].data[i] = NULL;
+		}
+	}
+	images[n].x = s->zoom->x;
+	images[n].y = s->zoom->y;
+	images[n].w = (sint16)s->zoom->width;
+	images[n].h = (sint16)s->zoom->height;
+	images[n].recode_flags &= ~FLAG_REZOOM;
+	return true;
+}
+
+
+/* --- the resolver ------------------------------------------------------------- */
+
+/**
+ * Resolve one scaled image into the screen run stream, for one player.
+ *
+ * Identical in shape to stlab_xr32_recode(): the only difference is where the
+ * pixels and the semantics come from. Rounding happens once, here, half-up.
+ */
+static bool stlab_xr32_zoom_resolve(const stlab_xr32_zoom_t *z, sint8 player_nr,
+                                    uint32 *out_argb)
+{
+	double rgm = 1.0, bm = 1.0;
+	stlab_night_multipliers( &rgm, &bm );
+	stlab_zoom_night_lut( rgm, bm );
+	const uint8 *lrg = stlab_zlut_rg;
+	const uint8 *lb  = stlab_zlut_b;
+
+	const uint32 npx = (uint32)z->width * z->height;
+	for(  uint32 i = 0;  i < npx;  i++  ) {
+		const uint8 *p = z->rgba + (size_t)i * 4;
+		if(  p[3] <= 7  ) {
+			out_argb[i] = 0;                    // the box was (almost) all holes
+			continue;
+		}
+		out_argb[i] = 0xFF000000u | ((uint32)lrg[p[0]] << 16)
+		                          | ((uint32)lrg[p[1]] << 8)
+		                          | (uint32)lb[p[2]];
+	}
+
+	// the semantic contributions, in ascending destination order
+	for(  uint32 e = 0;  e < z->sem_count;  e++  ) {
+		const stlab_zoom_sem_t &s = z->sem[e];
+		if(  s.dest >= npx  ||  out_argb[s.dest] == 0  ) {
+			continue;
+		}
+		const uint8 *p = z->rgba + (size_t)s.dest * 4;
+		const int base_r = lrg[p[0]], base_g = lrg[p[1]], base_b = lb[p[2]];
+		int tot = 0, ar = 0, ag = 0, ab = 0;
+		for(  uint8 j = 0;  j < s.n;  j++  ) {
+			const uint32 c = stlab_zoom_key_colour( s.key[j], player_nr );
+			const int cov = s.cov[j];
+			tot += cov;
+			ar += (int)((c >> 16) & 0xFF) * cov;
+			ag += (int)((c >> 8) & 0xFF) * cov;
+			ab += (int)(c & 0xFF) * cov;
+		}
+		if(  tot > 255  ) {
+			tot = 255;                          // the box cannot be more than full
+		}
+		const int rest = 255 - tot;
+		out_argb[s.dest] = stlab_pack_argb( (ar + base_r * rest + 127) / 255,
+		                                    (ag + base_g * rest + 127) / 255,
+		                                    (ab + base_b * rest + 127) / 255 );
+	}
+	return true;
+}
+
+
+/**
+ * The native zoom entry point: produce data[player] for a candidate-backed image
+ * at the current scale, without ever touching base_data or the legacy path.
+ */
+static bool stlab_xr32_zoom_recode(image_id n, sint8 player_nr)
+{
+	stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s == NULL  ||  s->img == NULL  ) {
+		return false;
+	}
+	if(  !stlab_xr32_zoom_ensure( n, s )  ) {
+		return false;
+	}
+	const stlab_xr32_zoom_t *z = s->zoom;
+	const uint32 w = z->width, h = z->height, npx = w * h;
+
+	const size_t cap = (size_t)h * (3 + 2 * (size_t)w) + 8;
+	if(  !stlab_scratch_reserve( npx, cap )  ) {
+		return false;
+	}
+	uint32 *raster = stlab_scratch_raster;
+	stlab_xr32_zoom_resolve( z, player_nr, raster );
+
+	PIXVAL *out = stlab_scratch_out;
+	PIXVAL *d = out;
+	for(  uint32 y = 0;  y < h;  y++  ) {
+		const uint32 *row = raster + (size_t)y * w;
+		uint32 x = 0;
+		bool first = true;
+		while(  x < w  ) {
+			uint32 clear = 0;
+			while(  x < w  &&  row[x] == 0  ) { clear++; x++; }
+			if(  x >= w  ) {
+				if(  first  ) { *d++ = 0; *d++ = 0; }
+				break;
+			}
+			*d++ = (PIXVAL)clear;
+			uint32 start = x;
+			while(  x < w  &&  row[x] != 0  ) { x++; }
+			const uint32 count = x - start;
+			*d++ = (PIXVAL)count;
+			for(  uint32 k = 0;  k < count;  k++  ) {
+				*d++ = (PIXVAL)row[start + k];
+			}
+			first = false;
+		}
+		if(  first  &&  w == 0  ) { *d++ = 0; *d++ = 0; }
+		*d++ = 0;
+	}
+
+	imd32 &im = images[n];
+	const size_t used = (size_t)(d - out);
+	if(  im.data[player_nr] != NULL  ) {
+		free( im.data[player_nr] );
+	}
+	PIXVAL *cache = MALLOCN( PIXVAL, used );
+	memcpy( cache, out, used * sizeof(PIXVAL) );
+	im.data[player_nr] = cache;
+	im.len = (uint32)used;
+	im.w = (sint16)w;
+	im.h = (sint16)h;
+	im.x = z->x;
+	im.y = z->y;
+	s->resolved_player = (uint8)player_nr;
+	s->resolved_night = night_shift;
+	return true;
+}
