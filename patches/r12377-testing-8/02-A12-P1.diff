+/* XR32-A12-P1: the composed rasters of derived tiles, kept for reuse.
+ *
+ * A derived tile's raster - an A12 climate or snow tile, an A4 coast water tile - is a function of its recipe and of the data of
+ * its sources only. The zoom, the player and the night level are applied after it (resolve, zoom build), so one raster serves the
+ * screen cache at 1/1, every zoom cache and the base-size runs. A coast tile whose sea has a night plane also reads light_level
+ * (stlab_derive_legacy_rgba; a constant 0 in simgraph32.cc today), kept in the key so that it stays right. Without this,
+ * every light change and every zoom step composed every derived tile in view again.
+ *
+ * The last rasters composed are kept, least recently used first out, within STLAB_DERIVE_CACHE_BYTES. An entry is valid only for
+ * the registration it was composed for (rc.gen: an image id freed by init_ground_textures() and registered again gets a new one,
+ * so it never meets an old raster) and for the source data it read (the pointers the phase cache checks as well). A raster is
+ * read-only once made and shared by pointer: the screen cache and the zoom cache are built under different locks, so two lanes may
+ * look up, compose or evict at the same time, and an evicted raster lives until its last user lets it go.
+ */
+struct stlab_derive_cached_t {
+	// the key: the tile, its registration, and everything the composition reads
+	image_id tile = IMG_EMPTY;
+	uint32 gen = 0;
+	int light = 0;
+	const STORED_PIXVAL *tile_data = NULL, *light_data = NULL, *ref_data = NULL, *sea_data = NULL;
+	const uint8 *light_rgba = NULL, *ref_rgba = NULL, *ref_night = NULL, *sea_rgba = NULL, *sea_night = NULL;
+	// the raster (day plane and, if the source has one, night plane)
+	std::shared_ptr<const stlab_xr32_image_t> img;
+	size_t bytes = 0;
+};
+static const size_t STLAB_DERIVE_CACHE_BYTES = 16u << 20;
+static std::list<stlab_derive_cached_t> stlab_derive_cache;   // most recently used first
+static std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator> stlab_derive_cache_index;
+static size_t stlab_derive_cache_held = 0;
+#ifdef MULTI_THREAD
+static pthread_mutex_t stlab_derive_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+#endif
+
+
+static void stlab_derive_cache_drop(std::list<stlab_derive_cached_t>::iterator e)
+{
+	stlab_derive_cache_held -= e->bytes;
+	stlab_derive_cache_index.erase( e->tile );
+	stlab_derive_cache.erase( e );
+}
+
+
+/// a derived tile was registered (again): its old raster, if any, describes another recipe
+static void stlab_derive_cache_forget(image_id tile)
+{
+#ifdef MULTI_THREAD
+	pthread_mutex_lock( &stlab_derive_cache_mutex );
+#endif
+	std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator>::iterator it = stlab_derive_cache_index.find( tile );
+	if(  it != stlab_derive_cache_index.end()  ) {
+		stlab_derive_cache_drop( it->second );
+	}
+#ifdef MULTI_THREAD
+	pthread_mutex_unlock( &stlab_derive_cache_mutex );
+#endif
+}
+
+
+static void stlab_derive_cache_clear()
+{
+#ifdef MULTI_THREAD
+	pthread_mutex_lock( &stlab_derive_cache_mutex );
+#endif
+	stlab_derive_cache.clear();
+	stlab_derive_cache_index.clear();
+	stlab_derive_cache_held = 0;
+#ifdef MULTI_THREAD
+	pthread_mutex_unlock( &stlab_derive_cache_mutex );
+#endif
+}
+
+
+static bool stlab_derive_cached_is(const stlab_derive_cached_t &a, const stlab_derive_cached_t &b)
+{
+	return a.tile == b.tile  &&  a.gen == b.gen  &&  a.light == b.light  &&  a.tile_data == b.tile_data  &&  a.light_data == b.light_data
+	    &&  a.ref_data == b.ref_data  &&  a.sea_data == b.sea_data  &&  a.light_rgba == b.light_rgba  &&  a.ref_rgba == b.ref_rgba
+	    &&  a.ref_night == b.ref_night  &&  a.sea_rgba == b.sea_rgba  &&  a.sea_night == b.sea_night;
+}
+
+
+/// the raster of derived tile @p tile, from the cache or composed (and kept); NULL if it cannot be composed
+static std::shared_ptr<const stlab_xr32_image_t> stlab_derive_cached(image_id tile, const stlab_xr32_derive_t &rc)
+{
+	const stlab_xr32_slot_t *ls = stlab_slot( rc.light, false ), *rs = stlab_slot( rc.ref, false );
+	const stlab_xr32_slot_t *ss = rc.climate ? NULL : stlab_slot( rc.sea, false );
+	stlab_derive_cached_t key;
+	key.tile = tile;  key.gen = rc.gen;
+	key.tile_data = images[tile].base_data;  key.light_data = images[rc.light].base_data;  key.ref_data = images[rc.ref].base_data;
+	key.sea_data = rc.climate ? NULL : images[rc.sea].base_data;
+	key.light_rgba = (ls  &&  ls->img) ? ls->img->rgba : NULL;
+	key.ref_rgba = (rs  &&  rs->img) ? rs->img->rgba : NULL;
+	key.ref_night = (rs  &&  rs->img) ? rs->img->night : NULL;
+	key.sea_rgba = (ss  &&  ss->img) ? ss->img->rgba : NULL;
+	key.sea_night = (ss  &&  ss->img) ? ss->img->night : NULL;
+	key.light = key.sea_night ? light_level : 0;   // only a sea night plane makes a coast tile depend on the light level
+#ifdef MULTI_THREAD
+	pthread_mutex_lock( &stlab_derive_cache_mutex );
+#endif
+	std::unordered_map<image_id, std::list<stlab_derive_cached_t>::iterator>::iterator it = stlab_derive_cache_index.find( tile );
+	if(  it != stlab_derive_cache_index.end()  &&  stlab_derive_cached_is( *it->second, key )  ) {
+		stlab_derive_cache.splice( stlab_derive_cache.begin(), stlab_derive_cache, it->second );
+		std::shared_ptr<const stlab_xr32_image_t> hit = it->second->img;
+#ifdef MULTI_THREAD
+		pthread_mutex_unlock( &stlab_derive_cache_mutex );
+#endif
+		return hit;
+	}
+#ifdef MULTI_THREAD
+	pthread_mutex_unlock( &stlab_derive_cache_mutex );
+#endif
+
+	std::shared_ptr<stlab_xr32_image_t> made = std::make_shared<stlab_xr32_image_t>();
+	if(  !stlab_derive_compose( tile, rc, *made )  ) {
+		return NULL;
+	}
+	key.img = made;
+	key.bytes = (size_t)made->width * made->height * 4 * ((made->rgba ? 1 : 0) + (made->night ? 1 : 0)) + sizeof(stlab_derive_cached_t);
+
+#ifdef MULTI_THREAD
+	pthread_mutex_lock( &stlab_derive_cache_mutex );
+#endif
+	it = stlab_derive_cache_index.find( tile );
+	if(  it != stlab_derive_cache_index.end()  ) {
+		stlab_derive_cache_drop( it->second );   // an older raster of this tile, or the one another lane composed meanwhile
+	}
+	stlab_derive_cache.push_front( key );
+	stlab_derive_cache_index[tile] = stlab_derive_cache.begin();
+	stlab_derive_cache_held += key.bytes;
+	while(  stlab_derive_cache_held > STLAB_DERIVE_CACHE_BYTES  &&  stlab_derive_cache.size() > 1  ) {
+		stlab_derive_cache_drop( std::prev( stlab_derive_cache.end() ) );
+	}
+#ifdef MULTI_THREAD
+	pthread_mutex_unlock( &stlab_derive_cache_mutex );
+#endif
+	return made;
+}
