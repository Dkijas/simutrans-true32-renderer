+/// may image @p n be the light map of a derived climate tile? A light map is only ever read as a colour, and a grey that
+/// happens to be exactly a key of image_t::rgbtab makes an opaque special colour of its 16-bit word (0x8000 + key), while
+/// its XR32 plane keeps the grey. That must not cost the tile its 32-bit picture. Semi-transparent pixels still do: their
+/// runs have another layout and their meaning as a light is undefined.
+static bool stlab_derive_light_usable(image_id n)
+{
+	const imd32 &d = images[n];
+	if(  d.base_data == NULL  ||  (d.recode_flags & FLAG_HAS_TRANSPARENT_COLOR)  ) {
+		return false;
+	}
+	const STORED_PIXVAL *sp = d.base_data;
+	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
+		uint16 runlen = *sp++;
+		do {
+			runlen = *sp++;
+			if(  runlen & TRANSPARENT_RUN  ) {
+				return false;
+			}
+			for(  uint16 k = 0;  k < runlen;  k++  ) {
+				if(  sp[k] >= 0x8000 + SPECIAL  ) {
+					return false;
+				}
+			}
+			sp += runlen;
+		} while(  (runlen = *sp++)  );
+	}
+	return true;
+}
+
+
+/// one word of a light map without XR32 colour: an opaque special colour is the key's own RGB, what the sheet painted
+static inline void stlab_derive_light_rgb(STORED_PIXVAL v, int *c)
+{
+	if(  v >= 0x8000  ) {
+		const uint32 rgb = image_t::rgbtab[v - 0x8000];
+		c[0] = (rgb >> 16) & 0xFF;  c[1] = (rgb >> 8) & 0xFF;  c[2] = rgb & 0xFF;
+	}
+	else {
+		stlab_derive_rgb555( v, c );
+	}
+}
+
