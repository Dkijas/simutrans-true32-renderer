+/// the XR32 node of source image @p n for a climate composition, or NULL (its 16-bit words are used then). A v1 node's runs
+/// only say that a pixel equals a key of image_t::rgbtab (makeobj infers them from the RGB); a v2 node's are declared.
+static const stlab_xr32_image_t *stlab_derive_source_node(image_id n)
+{
+	const stlab_xr32_slot_t *s = stlab_slot( n, false );
+	return (s != NULL  &&  s->img != NULL  &&  s->img->rgba != NULL  &&  (s->img->run_count == 0  ||  s->img->version < 2)  &&  !stlab_derived.count( n )) ? s->img : NULL;
+}
+
+
+/// may image @p n be a colour source (light map or climate texture) of a derived climate tile? A source is only ever read
+/// as a colour: create_textured_tile() writes plain RGB555, so a tile has no special colours whatever its sources hold. A
+/// colour that happens to be exactly a key of image_t::rgbtab makes an opaque special colour of its 16-bit word
+/// (0x8000 + key), while its XR32 plane keeps the colour. That must not cost the tile its 32-bit picture. What still does:
+/// semi-transparent pixels (their runs have another layout and their meaning as a source is undefined), semantics declared
+/// in a v2 node, and the words of a generated node (SIMUTRANS_XR32_NIGHTGEN), which are all that node is made of.
+static bool stlab_derive_source_usable(image_id n)
+{
+	const imd32 &d = images[n];
+	if(  d.base_data == NULL  ||  (d.recode_flags & FLAG_HAS_TRANSPARENT_COLOR)  ) {
+		return false;
+	}
+	const stlab_xr32_slot_t *s = stlab_slot( n, false );
+	if(  s != NULL  &&  s->img != NULL  &&  s->img->version >= 2  &&  s->img->run_count != 0  ) {
+		return false;
+	}
+	const STORED_PIXVAL first_refused = (s != NULL  &&  s->generated) ? 0x8000 : 0x8000 + SPECIAL;
+	const STORED_PIXVAL *sp = d.base_data;
+	for(  sint16 y = 0;  y < d.base_h;  y++  ) {
+		uint16 runlen = *sp++;
+		do {
+			runlen = *sp++;
+			if(  runlen & TRANSPARENT_RUN  ) {
+				return false;
+			}
+			for(  uint16 k = 0;  k < runlen;  k++  ) {
+				if(  sp[k] >= first_refused  ) {
+					return false;
+				}
+			}
+			sp += runlen;
+		} while(  (runlen = *sp++)  );
+	}
+	return true;
+}
+
+
+/// one word of a source without XR32 colour: an opaque special colour is the key's own RGB, what the sheet painted
+static inline void stlab_derive_source_rgb(STORED_PIXVAL v, int *c)
+{
+	if(  v >= 0x8000  ) {
+		const uint32 rgb = image_t::rgbtab[v - 0x8000];
+		c[0] = (rgb >> 16) & 0xFF;  c[1] = (rgb >> 8) & 0xFF;  c[2] = rgb & 0xFF;
+	}
+	else {
+		stlab_derive_rgb555( v, c );
+	}
+}
+
