--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -210,8 +210,28 @@
 	target_link_libraries(simutrans PRIVATE Threads::Threads)
 endif (SIMUTRANS_MULTI_THREAD)
 
+# Renderer colour depth of the graphical backends, the same rule as the
+# Makefile (SOURCES += src/simutrans/display/simgraph$(COLOUR_DEPTH).cc):
+#   16 - the RGB565 renderer, simgraph16.cc (default)
+#   32 - the ARGB8888 renderer, simgraph32.cc
+# Exactly one renderer is compiled into the executable. Anything else stops
+# here rather than silently building the 16 bit renderer. The headless
+# backend "none" has no renderer and keeps COLOUR_DEPTH 0 below.
+set(COLOUR_DEPTH "16" CACHE STRING "Renderer colour depth for the graphical backends: 16 (RGB565) or 32 (ARGB8888)")
+set_property(CACHE COLOUR_DEPTH PROPERTY STRINGS 16 32)
+if (NOT SIMUTRANS_BACKEND STREQUAL "none")
+	if (NOT COLOUR_DEPTH MATCHES "^(16|32)$")
+		message(FATAL_ERROR "COLOUR_DEPTH='${COLOUR_DEPTH}' is not supported: "
+			"use -DCOLOUR_DEPTH=16 (RGB565) or -DCOLOUR_DEPTH=32 (ARGB8888).")
+	endif ()
+	set(SIMUTRANS_RENDERER_SOURCE src/simutrans/display/simgraph${COLOUR_DEPTH}.cc)
+	if (NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${SIMUTRANS_RENDERER_SOURCE}")
+		message(FATAL_ERROR "The renderer source ${SIMUTRANS_RENDERER_SOURCE} for COLOUR_DEPTH=${COLOUR_DEPTH} does not exist in this tree.")
+	endif ()
+endif ()
+
 if (SIMUTRANS_BACKEND STREQUAL "sdl2")
-	target_sources(simutrans PRIVATE src/simutrans/display/simgraph16.cc src/simutrans/sys/simsys_s2.cc src/simutrans/sound/sdl2_sound.cc)
+	target_sources(simutrans PRIVATE ${SIMUTRANS_RENDERER_SOURCE} src/simutrans/sys/simsys_s2.cc src/simutrans/sound/sdl2_sound.cc)
 	target_include_directories(simutrans PRIVATE ${SDL2_INCLUDE_DIRS})
 	if (MINGW)
 		target_link_libraries(simutrans PRIVATE ${SDL2_STATIC_LIBRARIES})
@@ -224,7 +244,7 @@
 	else ()
 		target_link_libraries(simutrans PRIVATE PkgConfig::SDL2)
 	endif ()
-	target_compile_definitions(simutrans PRIVATE COLOUR_DEPTH=16)
+	target_compile_definitions(simutrans PRIVATE COLOUR_DEPTH=${COLOUR_DEPTH})
 
 elseif (SIMUTRANS_BACKEND STREQUAL "sdl3")
 	# Asking for a backend whose library is missing has to say so. Without this
@@ -241,11 +261,11 @@
